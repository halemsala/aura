{
  "schema": "aura-inplace-allowlist-v1",
  "version": 1,
  "maxPatchBytes": 52428800,
  "exact": [
    "AURA_REPARAR_SISTEMA.bat",
    "AURA_LIMPEZA_INSTALA_VERIFICA_TUDO.bat",
    "AURA_REBUILD_HERMES.bat",
    "AURA_START_ALL.bat",
    "AURA_TUDO_EM_UM.bat",
    "AURA_MOTOR_AUTONOMO.ps1",
    "AURA_InPlace.ps1",
    "allowlist.json",
    "README.md",
    "MANUAL_SISTEMA_AURA.txt",
    "PACKAGE_RELEASE.txt",
    "desktop/MainForm.cs",
    "desktop/Models.cs",
    "desktop/BrowserHost.cs",
    "desktop/ServiceSupervisor.cs",
    "desktop/ui/matriz/aura-quantx-adapter.js",
    "desktop/ui/matriz/aura-quantx-central.html",
    "desktop/ui/matriz/aura-quantx-central.css",
    "desktop/ui/matriz/aura-quantx-central.js",
    "desktop/ui/matriz_v22/index.html",
    "desktop/ui/matriz_v22/BUILD_INFO.json",
    "desktop/ui/matriz_v22/manifest.webmanifest",
    "desktop/ui/matriz_v22/sw.js",
    "desktop/ui/matriz_v22/assets/index-*.js",
    "desktop/ui/matriz_v22/assets/index-*.css",
    "desktop/ui/matriz_v22/assets/*.js",
    "desktop/ui/matriz_v22/assets/*.css",
    "agents/activation_manifest.json",
    "agents/corner_window_specialist_v7/corner_window_specialist.py",
    "agents/corner_window_specialist_v7/corner_pattern_memory.json",
    "agents/corner_window_specialist_v7/validate_agent.py",
    "agents/corner_window_specialist_v7/README_AGENTE_ESCANTEIOS_INDEPENDENTE.md",
    "agents/corner_window_specialist_v7/CURATION_MANIFEST.md",
    "agents/corner_window_specialist_v7/__init__.py",
    "agents/ENABLED/engine_corner_window_specialist_v7.py.enabled"
  ],
  "patterns": [
    "engine/*.py",
    "engine/**/*.py",
    "bridge/*.py",
    "bridge/**/*.py",
    "desktop/ui/*.html",
    "desktop/ui/*.js",
    "desktop/ui/*.css",
    "desktop/ui/matriz/*",
    "knowledge/inbox/*.jsonl",
    "knowledge/review/*.json",
    "knowledge/review/*.md",
    "scripts/*.py",
    "templates/*.md",
    "agents/**/*.py",
    "agents/**/*.json",
    "hermes_v10/**/*.py",
    "core/*.py",
    "desktop/*.cs"
  ],
  "protected": [
    "engine/venv/**",
    "engine/aura_quant_x.db",
    "**/*.db",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/.env",
    "config.json",
    "config/**",
    "desktop/config/**",
    "voice_profiles/**",
    "voice_assets/**",
    "models/**",
    "ollama/**",
    "logs_instalacao/**",
    "backups/**",
    "runtime/**",
    "knowledge/approved/**",
    "knowledge/review_decisions.jsonl",
    "**/*.gguf",
    "**/*.pt",
    "**/*.pth",
    "**/*.wav",
    "**/*.mp3"
  ],
  "policy": {
    "newTargets": true,
    "allowDelete": false,
    "allowRename": false,
    "allowDependencyInstall": false,
    "allowProcessStop": false,
    "allowOllamaPull": false,
    "requireSha256": true,
    "requireOperatorManifest": true
  }
}
