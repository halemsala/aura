_prev_handle = handle_operator_intent



def _engine_json(method: str, path: str, payload=None, timeout: float = 12.0):
    url = "http://127.0.0.1:8765" + path
    data = None
    headers = {"Accept": "application/json", "X-AURA-UI": "hermes-operator"}
    if payload is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(payload).encode("utf-8")
    try:
        req = Request(url, data=data, headers=headers, method=method)
        with urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8", "replace")
            return resp.status, json.loads(body) if body else {}
    except Exception as exc:
        return 0, {"ok": False, "error": str(exc)[:240]}


def activate_analysis_agents() -> str:
    """Activa agentes de analise paper-only (manifest + specialized + API se existir)."""
    parts = [activate_agents()]
    # specialized script
    spec = ROOT / "scripts" / "aura_activate_specialized_agents.py"
    if spec.exists():
        out = _run([str(VENV_PY), str(spec), str(ROOT)], timeout=40)
        parts.append("specialized: " + (out[:200] if out else "ok"))
    safe = ROOT / "scripts" / "aura_activate_safe.py"
    if safe.exists():
        out = _run([str(VENV_PY), str(safe)], timeout=30)
        parts.append("safe: " + (out[:160] if out else "ok"))
    # engine tools activate-all
    code, data = _engine_json("POST", "/api/tools/activate-all", {})
    parts.append(f"engine activate-all HTTP {code}")
    code2, agents = _engine_json("GET", "/api/agents")
    n = 0
    if isinstance(agents, dict):
        n = len(agents.get("agents") or agents.get("items") or [])
        if not n and agents:
            n = len(agents)
    code3, act = _engine_json("GET", "/api/activation")
    return (
        "Agentes de analise paper-only activados. "
        + " | ".join(parts)
        + f" | /api/agents~{n} | activation HTTP {code3}. "
        "Sem ordem real. Pedido seguinte: analisa a partida."
    )


def analyze_match(message: str = "") -> str:
    """Analise da partida activa via ui/state + trader/chat + analysis se houver fixture_id."""
    code, state = _engine_json("GET", "/api/ui/state", timeout=5.0)
    if not code:
        return (
            "Engine :8765 inacessivel — nao consigo analisar. "
            "Sobe o engine e abre SokkerPRO no Desktop F2. "
            f"Erro: {state.get('error')}"
        )
    view = {}
    if isinstance(state, dict):
        snap = state.get("snapshot") if isinstance(state.get("snapshot"), dict) else {}
        view = snap.get("view") if isinstance(snap.get("view"), dict) else state.get("view") or {}
        if not isinstance(view, dict):
            view = {}
    home = str(view.get("home") or view.get("home_team") or "")
    away = str(view.get("away") or view.get("away_team") or "")
    minute = str(view.get("minute") or "")
    fixture_id = (
        str(state.get("fixtureId") or state.get("fixture_id") or view.get("fixtureId") or view.get("fixture_id") or "")
        if isinstance(state, dict) else ""
    )
    if not home or not away:
        return (
            "Sem fixture activa em ui/state. Abre o jogo no Desktop F2 (SokkerPRO) e repete: analisa a partida."
        )
    # pede analise ao trader_chat (mesmo control plane)
    prompt = (
        message.strip()
        if message and len(message.strip()) > 20
        else f"Analisa a partida {home} x {away} minuto {minute}. Resumo paper-only: pressao, escanteios, risco, decisao NO_BET se incerto."
    )
    c2, chat = _engine_json(
        "POST",
        "/api/trader/chat",
        {"message": prompt, "fixtureId": fixture_id or None, "context": state if isinstance(state, dict) else {}},
        timeout=25.0,
    )
    reply = ""
    if isinstance(chat, dict):
        reply = str(chat.get("reply") or chat.get("message") or chat.get("text") or "").strip()
    # analysis endpoint se fixture_id
    analysis_bit = ""
    if fixture_id:
        c3, an = _engine_json("GET", f"/api/analysis/{fixture_id}", timeout=10.0)
        if isinstance(an, dict) and an:
            dec = an.get("decision") or (an.get("analysis") or {}).get("decision")
            if dec:
                analysis_bit = f" Decision={dec}."
    # agents snapshot
    c4, ag = _engine_json("GET", "/api/agents/glm/status", timeout=5.0)
    glm = ""
    if isinstance(ag, dict):
        glm = f" GLM={ag.get('status') or ag.get('ok') or 'n/a'}."
    header = f"Partida (ui/state): {home} x {away}" + (f" {minute}'" if minute else "") + f" fixture={fixture_id or 'n/a'}."
    if not reply:
        reply = (
            "Engine nao devolveu texto de analise. "
            "Agentes paper-only — tenta: ativa agentes de analise | diagnostico."
        )
    return f"{header}{analysis_bit}{glm}\n{reply[:1200]}\n(paper_trade=true · fonte=ui/state · nao inventado)"


def headless_public_page(url: str) -> str:
    try:
        import sys
        scripts = str(ROOT / "scripts")
        if scripts not in sys.path:
            sys.path.insert(0, scripts)
        import aura_headless_public as hp
        return hp.summarize_fetch(hp.fetch_public(url))
    except Exception as exc:
        return f"Headless indisponivel: {exc}"


def handle_operator_intent(message: str):
    msg = (message or "").strip()
    low = msg.lower()
    if not msg:
        return None

    try:
        import aura_programmer_agent as _prog
        kind = _prog.classify(msg)
        if kind:
            return _prog.run_operator(msg)
    except Exception:
        pass

    # reinicia sozinho / reinicia tudo -> core seguro em background via queue
    if low.strip() in ("reinicia", "reiniciar", "restart", "reinicia tudo", "reiniciar tudo", "reinicia o sistema"):
        if not _has_auth(msg):
            return require_auth(msg, "reinicia")
        return (
            "Reinicio core em segundo plano (bridge/engine/matriz/voice). Hermes fica de pe.\n"
            + queue_repair()
        )


    if any(k in low for k in (
        "monitora sistema", "monitorar sistema", "monitor automatico", "monitor automático",
        "ativa monitor", "ativar monitor", "auto reparo", "deixe os agentes", "deixa os agentes",
        "ativa todas", "ativar todas", "trabalhando no sistema",
    )):
        return start_system_monitor() + chr(10) + activate_analysis_agents()
    if any(k in low for k in ("para monitor", "parar monitor", "stop monitor")):
        return stop_system_monitor()
    if any(k in low for k in ("iniciar repar", "inicia repar", "iniciar correc", "faz o reparo", "executa reparo")):
        if not _has_auth(msg):
            return require_auth(msg, "corrige")
        return fix_common()


    # --- desktop / ecran verde ---
    if any(k in low for k in ("tela verde", "ecrã verde", "ecra verde", "nao carrega", "não carrega",
                               "nao esta carregando", "não está carregando", "so fica", "só fica")):
        parts = ["Detectei sintoma Desktop/UI sem dados."]
        parts.append(restart_service("engine"))
        st = full_status()
        if st.get("ports", {}).get("bridge") == "OFF":
            parts.append(restart_service("bridge"))
        parts.append(open_desktop())
        parts.append(status_text())
        return (
            "Acao: reiniciar engine (+bridge se OFF) e abrir Desktop. "
            "Ecran verde = Engine OFF ou sem fixture F2. "
            + " | ".join(parts)
        )
    if any(k in low for k in ("fecha e abre", "fechar e abrir", "reabre tudo", "reinicia o aura")):
        if not _has_auth(msg):
            return require_auth(msg, "fecha e abre")
        parts = [
            "A reabrir core (bridge+engine+matriz) sem matar Hermes/Ollama...",
            restart_service("bridge"),
            restart_service("engine"),
            restart_service("matriz"),
            open_desktop(),
            status_text(),
        ]
        return chr(10).join(parts)

    # --- analise + agentes de jogo ---

    if any(k in low for k in ("engine reinic", "reinicia o engine", "reinicie o engine", "engine offline")):
        return "A reiniciar o Engine (posso demorar ~15s)..." + chr(10) + restart_service("engine")

    if any(k in low for k in ("quantos sao", "quantos são", "quantos agentes", "qts agentes")):
        return count_agents()
    if any(k in low for k in ("ative todos", "ativar todos", "activa todos", "ativa todos os agentes",
                               "ative todos agentes", "ativar todos os agentes")):
        return activate_analysis_agents() if "activate_analysis_agents" in dir() else activate_agents()
    if any(k in low for k in ("404", "failed to fetch", "erro de conex", "pagina nao", "page not found",
                               "corrija esse erro", "corrige esse erro", "resolve esse erro")):
        return fix_common()

    if any(k in low for k in (
        "ativa agentes de analise", "ativar agentes de analise", "active analysis agents",
        "ativa analise", "ativar análise", "ativa os agentes de analise", "agentes de analise",
        "agentes de análise",
    )):
        return activate_analysis_agents()
    if any(k in low for k in (
        "analisa a partida", "analisar a partida", "analise a partida", "análise da partida",
        "analise da partida", "analisa o jogo", "analisar o jogo", "analise o jogo",
        "faz analise", "faça análise", "faca analise",
    )):
        return analyze_match(msg)
    if low.strip() in ("analisa", "analise", "análise", "analyze"):
        return analyze_match(msg)

    # --- headless publico ---
    if any(k in low for k in ("headless", "le a pagina", "lê a pagina", "fetch url", "abre pagina publica")):
        m = re.search(r"(https?://\S+)", msg)
        if m:
            return headless_public_page(m.group(1))
        m2 = re.search(r"(?:pagina|página|url|site)\s+(\S+)", low)
        if m2:
            return headless_public_page(m2.group(1))
        return "Indica URL publica. Ex: headless https://www.flashscore.com — feed do jogo continua F2/ui/state."


    # --- jogo em segundo plano (ui/state) ---
    if any(k in low for k in ("acompanha o jogo", "acompanhar o jogo", "segue o jogo", "seguir o jogo", "monitora o jogo", "watch game")):
        with_voice = any(k in low for k in ("voz", "voice", "fala", "avisa"))
        return start_game_watch(with_voice=with_voice)
    if any(k in low for k in ("para de acompanhar", "parar acompanhamento", "stop watch", "para o watcher")):
        return stop_game_watch()
    if any(k in low for k in ("status do jogo", "eventos do jogo", "o que aconteceu", "ultimo evento", "últimos eventos")):
        return game_watch_status()

    # --- voz ---
    if any(k in low for k in ("instala voz", "instalar voz", "instala a voz", "setup voice", "instala tts")):
        return install_voice(msg)
    if low.startswith("voz ") or low.startswith("muda voz") or low.startswith("mudar voz") or "muda a voz" in low:
        m = re.search(r"voz\s+(antonio|francisca|masculina|feminina|pt-\S+)", low)
        if m:
            return set_voice_profile(m.group(1))
        return set_voice_profile(low.replace("muda a voz", "").replace("mudar voz", "").replace("muda voz", "").replace("voz", "").strip())
    if "status voz" in low or "voz status" in low:
        return voice_status()

    # parar servicos
    m = re.search(r"(?:para|parar|stop|fecha|fechar)\s+(bridge|engine|matriz|hermes|voice|voz|all|tudo|core|sistema)", low)
    if m:
        return stop_service(m.group(1), msg)

    # abrir url / sokker
    if "sokker" in low and any(k in low for k in ("abre", "abrir", "naveg", "site", "f2")):
        # Desktop F2 e o caminho oficial; tambem abre browser
        open_desktop()
        return (
            open_url("https://www.sokkerpro.com")
            + " Desktop F2 (SokkerPRO BrowserHost) e o caminho oficial do AURA. "
            "Nao invento fixtures — a verdade continua em GET :8765/api/ui/state."
        )
    m = re.search(r"(?:abre|abrir|open)\s+(https?://\S+)", low)
    if m:
        return open_url(m.group(1))

    # ler ficheiro
    m = re.search(r"(?:le|l[eê]|mostra|cat)\s+(?:o\s+)?(?:ficheiro|arquivo|file)\s+(\S+)", low)
    if m:
        return read_project_file(m.group(1).strip("\"'"))

    # escrever / patch so com AUTORIZO (pedido estruturado fica para a API JSON)
    if "pip install" in low or "instala " in low or "instalar " in low:
        m = re.search(r"(?:pip install|instala(?:r)?)\s+([a-zA-Z0-9_.\-\[\]=<>!,]+)", low)
        if m:
            return install_python_package(m.group(1), msg)

    if "extrai" in low and "zip" in low:
        m = re.search(r"([^\s]+\\.zip)", low)
        if m:
            return extract_uploaded_zip(m.group(1), msg)

    # delega ao handler anterior
    return _prev_handle(message)
