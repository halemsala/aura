<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Aura.QuantX.Desktop</AssemblyName>
    <RootNamespace>Aura.QuantX.Desktop</RootNamespace>
    <Version>12.7.62</Version>
    <AssemblyVersion>12.7.0.6</AssemblyVersion>
    <FileVersion>12.7.0.6</FileVersion>
    <InformationalVersion>12.7.62-V27-UI-FIX</InformationalVersion>
    <Product>AURA QUANT-X Operator OS</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="config\desktop.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="capture\aura-capture.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WebView2 package adds WPF and WinForms references for compatible TFMs.
       This project is WinForms-only; remove the unused WPF assembly to avoid
       the WindowsBase 4.0/5.0 conflict (MSB3277). -->
  <Target Name="RemoveUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference->WithMetadataValue('FileName', 'Microsoft.Web.WebView2.Wpf'))" Condition="'$(UseWpf)' != 'true'" />
    </ItemGroup>
  </Target>
</Project>
