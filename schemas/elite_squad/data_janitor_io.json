{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataJanitor",
  "type": "object",
  "definitions": {
    "sanitize_request": {
      "type": "object",
      "required": ["raw"],
      "properties": {
        "raw": { "type": "object", "additionalProperties": true },
        "limits_profile": { "type": "string", "default": "default" }
      },
      "additionalProperties": false
    },
    "sanitize_response": {
      "type": "object",
      "required": ["clean", "rejected_keys", "ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "clean": { "type": "object" },
        "rejected_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "value": {},
              "reason": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
