def demo():
    """Simula duas operações baseadas em partidas reais do banco histórico."""
    trader = CornerAITrader(bankroll=1000.0)

    # ------------------------------------------------------------------
    # Cenário 1: Sport x Cuiabá (AO01) — 84' 1-1, sequência + pressão W2
    # ------------------------------------------------------------------
    state1 = {
        "minute": 84,
        "half": 2,
        "added_time": 5,
        "score_home": 1,
        "score_away": 1,
        "attacks_home": 104,
        "attacks_away": 81,
        "dangerous_attacks_home": 36,
        "dangerous_attacks_away": 49,
        "shots_on_target_home": 3,
        "shots_on_target_away": 3,
        "shots_inside_box_home": 4,
        "shots_inside_box_away": 5,
        "possession_home": 44.0,
        "possession_away": 56.0,
        "xg_home": 0.43,
        "xg_away": 0.40,
