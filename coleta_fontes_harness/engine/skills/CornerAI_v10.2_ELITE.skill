        "last_goal_team": "away",
        "var_recent": False,
        "long_stop_recent": False,
        "red_card_home": 0,
        "red_card_away": 0,
        "subs_offensive_home": 1,
        "subs_offensive_away": 2,
        "graph_standard_trend": [10, 20, 15, 25, 30, 35, 40, 45],
        "graph_accumulated_home": 23,
        "graph_accumulated_away": 48,
        "home_team": "Sport Recife",
        "away_team": "Cuiabá",
        "competition": "Brasileirão Série B",
    }

    res1 = trader.analyze(state1, odds=1.90)
    print("\n" + "=" * 62)
    print("ANÁLISE 1 — SPORT x CUIABÁ (84') — Caso clássico W2")
    print("=" * 62)
    print(json.dumps(res1, indent=2, ensure_ascii=False))

    # ------------------------------------------------------------------
