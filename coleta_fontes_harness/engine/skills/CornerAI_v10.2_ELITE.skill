class DataSourceAgent:
    def __init__(self, config: Config):
        self.cfg = config
        self.headers = {"x-rapidapi-key": config.RAPIDAPI_KEY, "x-rapidapi-host": config.RAPIDAPI_HOST}
        self._session = None
        self._sem = asyncio.Semaphore(10)

    async def _sess(self):
        if not self._session or self._session.closed:
            self._session = aiohttp.ClientSession(headers=self.headers, timeout=aiohttp.ClientTimeout(total=15))
        return self._session

    async def _req(self, ep: str, params: Dict) -> Optional[Dict]:
        async with self._sem:
            try:
                async with (await self._sess()).get(f"{self.cfg.RAPIDAPI_BASE_URL}/{ep}", params=params) as r:
                    if r.status == 200: return await r.json()
                    if r.status == 429:
                        await asyncio.sleep(5); return await self._req(ep, params)
                    logger.error(f"API {r.status} | {ep}")
            except Exception as e:
                logger.error(f"Req fail | {ep} | {e}")
        return None

    async def get_live_fixtures(self, league_id: Optional[int] = None) -> List[Dict]:
        p: Dict[str, Any] = {"live": "all"}
        if league_id: p["league"] = league_id
        d = await self._req("fixtures", p)
        return d.get("response", []) if d else []

    async def get_fixture_statistics(self, fid: int) -> Optional[List]:
        d = await self._req("fixtures/statistics", {"fixture": fid})
        return d.get("response") if d else None

    async def get_corners_live(self, fid: int) -> Dict[str, int]:
        stats = await self.get_fixture_statistics(fid)
        c = {"home": 0, "away": 0, "total": 0}
        if not stats: return c
        for i, ts in enumerate(stats):
            for s in ts.get("statistics", []):
                if s.get("type") == "Corner Kicks":
                    c["home" if i == 0 else "away"] = s.get("value", 0) or 0
        c["total"] = c["home"] + c["away"]
        return c

    async def get_dangerous_attacks(self, fid: int) -> Dict[str, int]:
        stats = await self.get_fixture_statistics(fid)
        r = {"home": 0, "away": 0, "diff": 0}
        if not stats: return r
        for i, ts in enumerate(stats):
            for s in ts.get("statistics", []):
                if s.get("type") == "Dangerous Attacks":
                    r["home" if i == 0 else "away"] = s.get("value", 0) or 0
        r["diff"] = abs(r["home"] - r["away"])
        return r

    async def close(self):
        if self._session and not self._session.closed:
            await self._session.close()

class NotificationAgent:
    def __init__(self, config: Config):
        self.cfg = config
        self._session = None
        self._sent: deque = deque(maxlen=100)

    def _key(self, s: Dict) -> str:
        return f"{s.get('fixture_id')}_{s.get('minute')}_{s.get('decision')}"

    def _tg(self, s: Dict) -> str:
        e = {"ENTRA": "🟢", "AGUARDA": "🟡", "NÃO ENTRA": "🔴"}.get(s.get("decision", ""), "⚪")
        return (f"{e} <b>CornerAI v7.1</b>\n━━━━━━━━━━━━━━━━━━━━━\n"
                f"⚽ <b>{s.get('home','?')} vs {s.get('away','?')}</b>\n"
                f"⏱ {s.get('minute','?')}' | 📊 {s.get('score',0)}/100 | 🎯 {s.get('decision','')}\n"
                f"MC: {s.get('mc_prob','N/A')}% | AP: {s.get('ap_home',0)}x{s.get('ap_away',0)} Δ{s.get('ap_diff',0)}\n"
                f"💡 {s.get('factors','-')}\n⚠️ {s.get('kills_active','Nenhuma')}\n"
                f"🕐 {datetime.now().strftime('%H:%M:%S')}")

    def _dc(self, s: Dict) -> Dict:
        color = {"ENTRA": 0x00FF00, "AGUARDA": 0xFFFF00, "NÃO ENTRA": 0xFF0000}.get(s.get("decision", ""), 0x808080)
        return {"embeds": [{"title": f"⚽ {s.get('home','?')} vs {s.get('away','?')}", "color": color,
            "fields": [
                {"name": "Min", "value": f"{s.get('minute','?')}'", "inline": True},
                {"name": "Score", "value": f"{s.get('score',0)}/100", "inline": True},
                {"name": "Decisão", "value": f"**{s.get('decision','')}**", "inline": True},
                {"name": "MC", "value": f"{s.get('mc_prob','N/A')}%", "inline": True},
                {"name": "Fatores", "value": s.get("factors", "-"), "inline": False},
            ], "footer": {"text": f"v7.1 | {datetime.now().strftime('%H:%M:%S')}"},
            "timestamp": datetime.utcnow().isoformat()}]}

    async def send_telegram(self, signal: Dict) -> bool:
        if not self.cfg.TELEGRAM_BOT_TOKEN or not self.cfg.TELEGRAM_CHAT_ID: return False
        k = self._key(signal)
        if k in self._sent: return False
        self._sent.append(k)
        try:
            from telegram import Bot
            from telegram.constants import ParseMode
            await Bot(token=self.cfg.TELEGRAM_BOT_TOKEN).send_message(
                chat_id=self.cfg.TELEGRAM_CHAT_ID, text=self._tg(signal), parse_mode=ParseMode.HTML)
            return True
        except Exception as e:
            logger.error(f"TG: {e}"); return False

    async def send_discord(self, signal: Dict) -> bool:
        if not self.cfg.DISCORD_WEBHOOK_URL: return False
        k = self._key(signal)
        if k in self._sent: return False
        self._sent.append(k)
        try:
            if not self._session or self._session.closed:
                self._session = aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=10))
            async with self._session.post(self.cfg.DISCORD_WEBHOOK_URL, json=self._dc(signal)) as r:
                return r.status in (200, 204)
        except Exception as e:
            logger.error(f"Discord: {e}"); return False

    async def broadcast(self, signal: Dict):
        rs = await asyncio.gather(self.send_telegram(signal), self.send_discord(signal), return_exceptions=True)
        logger.info(f"Broadcast: {sum(1 for r in rs if r is True)}/2")

    async def close(self):
        if self._session and not self._session.closed: await self._session.close()

# =============================================================================
# SEÇÃO 2: AGENTES INTELECTUAIS v7.1
# =============================================================================
class MonteCarloAgent:
    """Poisson calibrado 05/08/2026: λ_W1=0.069, λ_W2=0.090 — 2000 sims."""
    BASE_W1, BASE_W2, BASE_OUT = 0.069, 0.090, 0.030

    def __init__(self, n_sims: int = 2000, seed: Optional[int] = None):
        self.n_sims = max(500, n_sims)
        self.rng = random.Random(seed)

    def estimate(self, minute: int, half: int = 2, added: int = 4, **kw) -> Dict[str, Any]:
        if half == 1 and 30 <= minute <= 45 + added:
            base, end = self.BASE_W1, 45 + added
            window = "W1"
        elif half == 2 and minute >= 80:
            base, end = self.BASE_W2, 90 + added
            window = "W2"
        else:
            base, end, window = self.BASE_OUT, minute + 5, "OUT"
        horizon = max(0.5, float(end - minute + 0.5))
        rate, br = self._rate(base, minute, window, kw)
        hits = 0
        for _ in range(self.n_sims):
            lam = max(0.0, rate * self.rng.uniform(0.85, 1.15) * horizon)
            if self._poisson(lam) >= 1: hits += 1
        prob = hits / self.n_sims
        return {"probability": round(prob * 100, 1), "passes_threshold": prob >= 0.45,
                "rate_per_min": round(rate, 4), "horizon": round(horizon, 2),
                "simulations": self.n_sims, "breakdown": br, "window": window}

    def simulate(self, minute: int, ctx: Dict) -> Dict[str, Any]:
        half = 1 if minute <= 48 else 2
        return self.estimate(minute, half=half, added=4,
            ap_diff=ctx.get("ap_diff", 0), score_home=ctx.get("score_home", 0),
            score_away=ctx.get("score_away", 0), last_corner_minute=ctx.get("last_corner_minute"),
            last_goal_minute=ctx.get("last_goal_minute"), has_sequence=ctx.get("has_sequence", False),
            red_card=ctx.get("red_card_pressing_team", False), xg_dominant=ctx.get("xg_dominant", 0),
            momentum=ctx.get("momentum_rising", False), ip2_falling=ctx.get("ip2_trend") == "falling",
            possession=ctx.get("possession_dominant", 50))

    def _rate(self, base: float, minute: int, window: str, kw: Dict) -> Tuple[float, Dict]:
        r, br = base, {"base": base}
        ap = kw.get("ap_diff", 0)
        f = 1.45 if ap >= 20 else (1.30 if ap >= 12 else (1.12 if ap >= 6 else 1.0)); r *= f; br["ap"] = f
        lc = kw.get("last_corner_minute")
        if lc is not None:
            gap = minute - lc
            f = 1.35 if gap <= 4 else (1.10 if gap <= 8 else (0.50 if gap >= 20 else (0.60 if gap >= 15 else (0.82 if gap >= 10 else 1.0))))
        elif kw.get("has_sequence"): f = 1.35
        else: f = 0.75
        r *= f; br["seq"] = f
        sd = abs(kw.get("score_home", 0) - kw.get("score_away", 0))
        f = 1.15 if sd == 0 else (1.20 if sd == 1 else (0.60 if sd >= 2 else 1.0)); r *= f; br["score"] = f
        if window == "W1" and minute >= 43: f = 1.34
        elif window == "W2" and minute >= 88: f = 1.35
        elif window == "W2" and 80 <= minute <= 84: f = 1.45
        elif window == "W2" and minute >= 82: f = 1.25
        else: f = 1.0
        r *= f; br["peak"] = f
        if kw.get("momentum"): r *= 1.15; br["mom"] = 1.15
        if kw.get("ip2_falling"): r *= 0.65; br["ip2"] = 0.65
        lg = kw.get("last_goal_minute")
        if lg is not None and (minute - lg) <= 3: r *= 0.50; br["goal"] = 0.50
        if kw.get("red_card"): r *= 0.75; br["red"] = 0.75
        if kw.get("score_home", 0) == 0 and kw.get("score_away", 0) == 0 and minute >= 85 and kw.get("xg_dominant", 0) >= 0.55:
            r *= 0.70; br["g00"] = 0.70
        if kw.get("possession", 50) >= 60: r *= 1.08; br["poss"] = 1.08
        r = max(0.005, min(0.35, r)); br["final"] = r
        return r, br

    def _poisson(self, lam: float) -> int:
        if lam <= 0: return 0
        if lam < 30:
            L, k, p = math.exp(-lam), 0, 1.0
            while p > L: k += 1; p *= self.rng.random()
            return k - 1
        return max(0, int(round(self.rng.gauss(lam, math.sqrt(lam)))))

class FatigueAgent:
    def calculate(self, md: Dict) -> Dict[str, Any]:
        minute = md.get("minute", 0)
        subs = md.get("subs_home", 0) if md.get("pressing_team", "home") == "home" else md.get("subs_away", 0)
        fatigue = min(100, max(0, minute * 0.8 + max(0, md.get("total_attacks", 0) - 150) * 0.3 - subs * 8))
        sd = abs(md.get("score_home", 0) - md.get("score_away", 0))
        desp = min(30, (minute - 75) * 3) if minute >= 80 and sd <= 1 else 0
        eff = max(0, fatigue - desp)
        adj = -6 if eff >= 70 else (5 if eff >= 50 and desp >= 15 else 0)
        return {"fatigue_index": round(fatigue, 1), "desperation_index": round(desp, 1),
                "effective_fatigue": round(eff, 1), "score_adjustment": adj,
                "adjustment_type": "FADIGA" if adj < 0 else ("DESESPERO" if adj > 0 else "NEUTRO")}

class CorrelationAgent:
    PAIRS = [("SEQUENCIA", "CLUSTER", 0.5), ("SEQUENCIA", "ONDA", 0.6),
             ("MOMENTUM", "DANGEROUS_DIFF", 0.4), ("DOMINIO", "DANGEROUS_DIFF", 0.3),
             ("W2_82-86", "W2_88+", 1.0)]
    def adjust(self, bonuses: List[str], weights: Dict) -> Tuple[List[str], float]:
        active = {b.split("(")[0].split("+")[0] for b in bonuses}
        red, notes = 0.0, []
        for a, b, pct in self.PAIRS:
            if a in active and b in active:
                wa = weights.get("bonuses", {}).get(a, 0)
                wb = weights.get("bonuses", {}).get(b, 0)
                cut = min(wa, wb) * pct
                red += cut; notes.append(f"{a}/{b}*-{cut:.1f}")
        return notes, red

class LearningAgent:
    def __init__(self, path: str = "cornerai_weights_v7_learned.json"):
        self.path = Path(path)
        self.history: List[Dict] = []
        self.weights = self._load()

    def _load(self) -> Dict:
        if self.path.exists():
            with open(self.path) as f: return json.load(f)
        return {**{k: dict(v) for k, v in WEIGHTS_V7.items()},
                "meta": {"version": "7.1", "updates": 0, "last_update": None}}

    def _save(self):
        self.weights["meta"]["last_update"] = datetime.now().isoformat()
        self.weights["meta"]["updates"] = self.weights["meta"].get("updates", 0) + 1
        with open(self.path, "w") as f: json.dump(self.weights, f, indent=2)

    def record_outcome(self, signal: Dict, outcome: str):
        self.history.append({"ts": datetime.now().isoformat(), "signal": signal, "outcome": outcome})
        factors = [f.split("(")[0] for f in str(signal.get("factors", "")).split(", ") if f and f != "Nenhum"]
        kills = [k.split("(")[0] for k in str(signal.get("kills_active", "")).split(", ") if k and k != "Nenhuma"]
        if outcome == "acerto":
            for f in factors:
                if f in self.weights.get("bonuses", {}):
                    self.weights["bonuses"][f] = round(self.weights["bonuses"][f] * 1.005, 2)
        elif outcome == "erro":
            for f in factors:
                if f in self.weights.get("bonuses", {}):
                    self.weights["bonuses"][f] = round(self.weights["bonuses"][f] * 0.995, 2)
            for k in kills:
                if k in self.weights.get("kills", {}):
                    self.weights["kills"][k] = round(self.weights["kills"][k] * 1.0075, 2)
        self._save()

class PatternMatcher:
    def __init__(self, cases: List[Dict] = None):
        self.cases = cases or CASES_DATABASE

    def find_similar(self, md: Dict, top_n: int = 3) -> List[Dict]:
        scored = [(self._sim(md, c), c) for c in self.cases]
        scored.sort(key=lambda x: -x[0])
        return [{"case_id": c["id"], "match": c["match"], "similarity": round(s, 2),
                 "result": c["result"], "pattern": c["pattern"], "key_learning": c.get("key_learning", "")}
                for s, c in scored[:top_n]]

    def _sim(self, cur: Dict, case: Dict) -> float:
        sc, mx = 0.0, 8.0
        cw = "W2" if cur.get("minute", 0) >= 75 else "W1"
        if cw == case.get("window"): sc += 2.0
        md = abs(cur.get("minute", 0) - case.get("minute_entry", 0))
        sc += 1.5 if md <= 3 else (1.0 if md <= 7 else (0.5 if md <= 12 else 0))
        ad = abs(cur.get("ap_diff", 0) - case.get("ap_diff", 0))
        sc += 1.5 if ad <= 5 else (1.0 if ad <= 10 else (0.5 if ad <= 15 else 0))
        cf = set(cur.get("factors", [])); casf = set(case.get("factors", []))
        if cf and casf: sc += 2.0 * len(cf & casf) / max(1, len(cf | casf))
        sd_cur = abs(cur.get("score_home", 0) - cur.get("score_away", 0))
        try:
            parts = [p for p in case["match"].split() if "x" in p and p[0].isdigit()]
            if parts:
                h, a = parts[0].split("x"); csd = abs(int(h) - int(a))
                if sd_cur == csd: sc += 1.0
                elif abs(sd_cur - csd) <= 1: sc += 0.5
        except (ValueError, IndexError): pass
        return sc / mx

class RiskManager:
    def __init__(self, bankroll: float = 1000.0):
        self.bankroll = bankroll
        self.daily_entries = 0
        self.daily_results: List[str] = []
        self.max_daily = 8
        self.max_consec_loss = 3
        self.kelly_frac = 0.25

    def can_enter(self) -> Tuple[bool, str]:
        if self.daily_entries >= self.max_daily:
            return False, f"Stop diário ({self.max_daily})"
        recent = self.daily_results[-self.max_consec_loss:]
        if len(recent) >= self.max_consec_loss and all(r == "erro" for r in recent):
            return False, f"Stop {self.max_consec_loss} losses"
        return True, "OK"

    def calc_stake(self, score: float, mc_prob: float) -> Dict[str, Any]:
        p = mc_prob / 100.0
        b = max(0.01, score / 50.0)
        kelly = max(0, min((b * p - (1 - p)) / b, 0.15))
        stake_pct = kelly * self.kelly_frac
        return {"kelly_full_pct": round(kelly * 100, 2), "stake_pct": round(stake_pct * 100, 2),
                "stake_value": round(self.bankroll * stake_pct, 2),
                "confidence": "ALTA" if kelly >= 0.08 else ("MEDIA" if kelly >= 0.04 else "BAIXA")}

    def record(self, outcome: str):
        self.daily_entries += 1; self.daily_results.append(outcome)

    def reset_daily(self):
        self.daily_entries = 0; self.daily_results.clear()

# =============================================================================
# SEÇÃO 3: ENHANCED SCORE, BACKTEST, TRAINING, ORCHESTRATOR, CLI
# =============================================================================
class ScoreAgentBase:
    def __init__(self, weights: Dict = None):
        self.weights = weights or WEIGHTS_V7

    def calculate(self, md: Dict) -> Dict[str, Any]:
        base, tb, tk = 50.0, 0.0, 0.0
        bonuses, kills = [], []
        minute = md.get("minute", 0)
        ap = md.get("ap_diff", 0)
        sd = abs(md.get("score_home", 0) - md.get("score_away", 0))
        lcm, lgm = md.get("last_corner_minute") or 0, md.get("last_goal_minute") or 0
        B, K = self.weights["bonuses"], self.weights["kills"]

        def _b(cond, key):
            nonlocal tb
            if cond:
                v = B.get(key, 0); tb += v; bonuses.append(f"{key}(+{v})")
        def _k(cond, key):
            nonlocal tk
            if cond:
                v = K.get(key, 0); tk += v; kills.append(f"{key}(-{v})")

        _b(43 <= minute <= 48, "W1_43-48")
        _b(82 <= minute <= 86 and sd <= 1, "W2_82-86")
        _b(minute >= 88, "W2_88+")
        _b(lcm and (minute - lcm) <= 4, "SEQUENCIA")
        _b(ap >= 12, "DANGEROUS_DIFF")
        _b(sd <= 1, "PLACAR_APERTADO")
        _b(md.get("possession_dominant", 0) >= 60, "DOMINIO")
        _b(md.get("momentum_rising", False), "MOMENTUM")
        _k(lgm and (minute - lgm) <= 3, "GOL_SOFRIDO")
        _k(md.get("ip2_trend") == "falling", "IP2_FALSO")
        _k(sd >= 2, "PLACAR_ABERTO")
        _k(md.get("score_home", 0) == 0 and md.get("score_away", 0) == 0 and minute >= 85 and md.get("xg_dominant", 0) >= 0.6, "0-0_POS85")
        _k(lcm and (minute - lcm) >= 15, "ZONA_MORTA")
        _k(md.get("red_card_pressing_team", False), "RED_CARD")

        final = min(100, max(0, base + tb - tk))
        fc = len(bonuses)
        strong = tk >= 15
        if final >= 78 and fc >= 3 and not strong: dec = "ENTRA"
        elif 62 <= final <= 77: dec = "AGUARDA"
        else: dec = "NÃO ENTRA"
        return {"score": round(final, 1), "decision": dec, "bonuses": bonuses, "kills": kills,
                "factors_count": fc, "total_bonus": round(tb, 1), "total_kill": round(tk, 1)}

class EnhancedScoreAgent:
    def __init__(self, weights: Dict = None):
        self.base = ScoreAgentBase(weights)
        self.mc = MonteCarloAgent()
        self.fatigue = FatigueAgent()
        self.corr = CorrelationAgent()
        self.pattern = PatternMatcher()
        self.risk = RiskManager()

    def calculate_enhanced(self, md: Dict) -> Dict[str, Any]:
        br = self.base.calculate(md)
        mc_r = self.mc.simulate(md.get("minute", 0), md)
        fat_r = self.fatigue.calculate(md)
        _, corr_red = self.corr.adjust(br["bonuses"], self.base.weights)
        similar = self.pattern.find_similar(md, top_n=3)
        adj = min(100, max(0, br["score"] + fat_r["score_adjustment"] - corr_red))
        strong = br["total_kill"] >= 15
        if adj >= 78 and br["factors_count"] >= 3 and not strong and mc_r["passes_threshold"]:
            dec = "ENTRA"
        elif adj >= 70 and mc_r["probability"] >= 55 and not strong:
            dec = "AGUARDA"
        else:
            dec = "NÃO ENTRA"
        can, reason = self.risk.can_enter()
        if dec == "ENTRA" and not can: dec = "BLOQUEADO"
        stake = self.risk.calc_stake(adj, mc_r["probability"])
        return {"score_base": br["score"], "score_adjusted": round(adj, 1), "decision": dec,
                "monte_carlo": mc_r, "fatigue": fat_r, "correlation_reduction": round(corr_red, 1),
                "similar_cases": similar, "stake": stake, "bonuses": br["bonuses"], "kills": br["kills"],
                "risk_status": reason if not can else "OK"}

class BacktestEngine:
    def __init__(self, cases: List[Dict] = None):
        self.cases = cases or CASES_DATABASE

    def run(self, weights: Dict = None) -> Dict[str, Any]:
        w = weights or WEIGHTS_V7
        results = []
        for c in self.cases:
            if c["result"] == "PENDENTE": continue
            sim = 50.0 + sum(w["bonuses"].get(f, 0) for f in c.get("factors", [])) - sum(w["kills"].get(k, 0) for k in c.get("kills", []))
            sim = min(100, max(0, sim))
            fc = len(c.get("factors", []))
            sk = any(k in ("GOL_SOFRIDO", "PLACAR_ABERTO", "IP2_FALSO") for k in c.get("kills", []))
            sim_dec = "ENTRA" if sim >= 78 and fc >= 3 and not sk else ("AGUARDA" if 62 <= sim <= 77 else "NÃO ENTRA")
            actual = c["result"]
            correct = ((actual == "ACERTO" and sim_dec == "ENTRA") or
                       (actual == "ERRO" and sim_dec != "ENTRA") or
                       (actual == "CORRETO" and sim_dec == c["decision"]))
            results.append({"case_id": c["id"], "match": c["match"], "window": c["window"],
                            "sim_score": round(sim, 1), "sim_decision": sim_dec, "actual": actual, "correct": correct})
        total = len(results)
        ok = sum(1 for r in results if r["correct"])
        w1 = [r for r in results if r["window"] == "W1"]
        w2 = [r for r in results if r["window"] == "W2"]
        return {"total": total, "correct": ok, "accuracy": round(ok / max(1, total) * 100, 1),
                "w1_acc": round(sum(1 for r in w1 if r["correct"]) / max(1, len(w1)) * 100, 1),
                "w2_acc": round(sum(1 for r in w2 if r["correct"]) / max(1, len(w2)) * 100, 1),
                "details": results, "ts": datetime.now().isoformat()}

class TrainingPipeline:
    def __init__(self):
        self.bt = BacktestEngine()
        self.learner = LearningAgent()
        self.best_acc = 0.0

    def train(self, max_iter: int = 50, target: float = 85.0) -> Dict:
        logger.info(f"TRAIN | target={target}% max={max_iter}")
        best_w = json.loads(json.dumps(self.learner.weights))
        best_report, iters = None, 0
        for i in range(max_iter):
            iters = i + 1
            report = self.bt.run(self.learner.weights)
            acc = report["accuracy"]
            if acc > self.best_acc:
                self.best_acc = acc; best_w = json.loads(json.dumps(self.learner.weights)); best_report = report
            if acc >= target: break
            for d in report["details"]:
                if not d["correct"]:
                    c = next((x for x in CASES_DATABASE if x["id"] == d["case_id"]), None)
                    if c:
                        sig = {"factors": ", ".join(c.get("factors", [])), "kills_active": ", ".join(c.get("kills", []))}
                        self.learner.record_outcome(sig, "erro" if c["result"] == "ACERTO" else "acerto")
        self.learner.weights = best_w; self.learner._save()
        return {"iterations": iters, "best_accuracy": self.best_acc, "target": target,
                "achieved": self.best_acc >= target, "report": best_report}

class CornerAIOrchestrator:
    def __init__(self):
        self.cfg = CFG
        self.data = DataSourceAgent(self.cfg)
        self.notif = NotificationAgent(self.cfg)
        self.scorer = EnhancedScoreAgent()
        self._running = False

    def _in_window(self) -> bool:
        now = datetime.now().time()
        for s, e in self.cfg.JANELAS_ATIVAS:
            if (s <= e and s <= now <= e) or (s > e and (now >= s or now <= e)): return True
        return False

    async def _process(self, fixture: Dict) -> Optional[Dict]:
        fi = fixture.get("fixture", {})
        fid, elapsed = fi.get("id"), fi.get("status", {}).get("elapsed", 0) or 0
        if not (30 <= elapsed <= 48 or elapsed >= 80): return None
        teams, goals = fixture.get("teams", {}), fixture.get("goals", {})
        home = teams.get("home", {}).get("name", "?"); away = teams.get("away", {}).get("name", "?")
        sh, sa = goals.get("home", 0) or 0, goals.get("away", 0) or 0
        ap = await self.data.get_dangerous_attacks(fid)
        corners = await self.data.get_corners_live(fid)
        md = {"minute": elapsed, "score_home": sh, "score_away": sa,
              "ap_home": ap["home"], "ap_away": ap["away"], "ap_diff": ap["diff"],
              "corners_home": corners["home"], "corners_away": corners["away"],
              "last_corner_minute": None, "last_goal_minute": None, "ip2_trend": "stable",
              "possession_dominant": 0, "momentum_rising": ap["diff"] >= 15,
              "xg_dominant": 0, "red_card_pressing_team": False, "has_sequence": False,
              "total_attacks": ap["home"] + ap["away"], "subs_home": 0, "subs_away": 0,
              "pressing_team": "home", "factors": []}
        result = self.scorer.calculate_enhanced(md)
        return {"fixture_id": fid, "home": home, "away": away, "minute": elapsed,
                "score": result["score_adjusted"], "decision": result["decision"],
                "ap_home": ap["home"], "ap_away": ap["away"], "ap_diff": ap["diff"],
                "corners_home": corners["home"], "corners_away": corners["away"],
                "factors": ", ".join(result["bonuses"]) or "Nenhum",
                "kills_active": ", ".join(result["kills"]) or "Nenhuma",
                "mc_prob": result["monte_carlo"]["probability"]}

    async def _cycle(self):
        if not self._in_window(): return
        logger.info("━━━ Ciclo ━━━")
        for lid in self.cfg.TARGET_LEAGUES:
            try: fixtures = await self.data.get_live_fixtures(league_id=lid)
            except Exception as e: logger.error(f"Fixtures {lid}: {e}"); continue
            for f in fixtures:
                try:
                    sig = await self._process(f)
                    if sig and sig["decision"] in ("ENTRA", "AGUARDA"):
                        await self.notif.broadcast(sig)
                except Exception as e: logger.error(f"Process: {e}")

    async def run(self):
        logger.info("CornerAI v7.1 Unified | Ligas %s | %ss", self.cfg.TARGET_LEAGUES, self.cfg.CHECK_INTERVAL_SECONDS)
        self._running = True
        try:
            while self._running:
                await self._cycle()
                await asyncio.sleep(self.cfg.CHECK_INTERVAL_SECONDS)
        except (KeyboardInterrupt, SystemExit): pass
        finally:
            await self.data.close(); await self.notif.close()

def cli_train():
    print("=" * 60 + "\n CornerAI v7.1 — Training\n" + "=" * 60)
    r = TrainingPipeline().train(max_iter=50, target=80.0)
    print(f"Iter={r['iterations']} | Best={r['best_accuracy']}% | Atingido={'✅' if r['achieved'] else '❌'}")
    if r.get("report"):
        bt = r["report"]
        print(f"Cases={bt['total']} OK={bt['correct']} W1={bt['w1_acc']}% W2={bt['w2_acc']}%")
        for d in bt["details"]:
            print(f" {'✅' if d['correct'] else '❌'} {d['case_id']} | {d['match'][:28]:<28} | {d['sim_score']:.0f}→{d['sim_decision']}")

def cli_backtest():
    r = BacktestEngine().run()
    print(f"\nBACKTEST {r['ts']}\nAccuracy={r['accuracy']}% ({r['correct']}/{r['total']}) W1={r['w1_acc']}% W2={r['w2_acc']}%")
    for d in r["details"]:
        print(f" {'✅' if d['correct'] else '❌'} [{d['case_id']}] {d['match'][:30]:<30} | {d['sim_score']:.0f}→{d['sim_decision']:<10} | {d['actual']}")

def cli_mc():
    r = MonteCarloAgent().simulate(84, {"ap_diff": 13, "score_home": 1, "score_away": 1, "has_sequence": True, "last_corner_minute": 83})
    print(f"MC Sport-like 84': P={r['probability']}% Passa={r['passes_threshold']} rate={r['rate_per_min']}")
    r2 = MonteCarloAgent().simulate(87, {"ap_diff": 24, "score_home": 0, "score_away": 0, "last_corner_minute": 66, "xg_dominant": 0.7})
    print(f"MC VJS-like 87':  P={r2['probability']}% Passa={r2['passes_threshold']} rate={r2['rate_per_min']}")

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "train": cli_train()
    elif cmd == "backtest": cli_backtest()
    elif cmd == "mc": cli_mc()
    elif cmd == "run": asyncio.run(CornerAIOrchestrator().run())
    else:
        print("CornerAI v7.1 Unified | train | backtest | mc | run")
        cli_backtest()
```
```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CornerAI Automation Layer v7.0
================================
- DataSourceAgent: API-Football (RapidAPI) para dados In-Play
- NotificationAgent: Telegram + Discord Webhook
- ScoreAgent: cálculo Score v7.0 com pesos oficiais
- CornerAIOrchestrator: APScheduler loop a cada 60s nas janelas ativas

Dependências:
  pip install aiohttp loguru apscheduler python-telegram-bot

Variáveis de ambiente:
  RAPIDAPI_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, DISCORD_WEBHOOK_URL
"""

import asyncio
import aiohttp
import json
import os
from datetime import datetime, time as dtime
from typing import Optional, Dict, Any, List
from dataclasses import dataclass, field
from collections import deque

try:
    from cornerai_montecarlo_v7 import MonteCarloAgent, apply_mc_gate, MCResult
except ImportError:
    MonteCarloAgent = None
    apply_mc_gate = None
    MCResult = None

try:
    from loguru import logger
except ImportError:
    import logging
    logging.basicConfig(level=logging.INFO)
    logger = logging.getLogger("CornerAI")

try:
    from apscheduler.schedulers.asyncio import AsyncIOScheduler
    from apscheduler.triggers.interval import IntervalTrigger
except ImportError:
    AsyncIOScheduler = None
    IntervalTrigger = None

try:
    from telegram import Bot
    from telegram.constants import ParseMode
except ImportError:
    Bot = None
    ParseMode = None


# ==========================================
# CONFIGURAÇÕES
# ==========================================
@dataclass
class Config:
    RAPIDAPI_KEY: str = os.getenv("RAPIDAPI_KEY", "")
    RAPIDAPI_HOST: str = "api-football-v1.p.rapidapi.com"
    RAPIDAPI_BASE_URL: str = "https://api-football-v1.p.rapidapi.com/v3"
    TELEGRAM_BOT_TOKEN: str = os.getenv("TELEGRAM_BOT_TOKEN", "")
    TELEGRAM_CHAT_ID: str = os.getenv("TELEGRAM_CHAT_ID", "")
    DISCORD_WEBHOOK_URL: str = os.getenv("DISCORD_WEBHOOK_URL", "")
    JANELAS_ATIVAS: List[tuple] = field(default_factory=lambda: [
        (dtime(15, 0), dtime(23, 59)),
        (dtime(0, 0), dtime(2, 0)),
    ])
    CHECK_INTERVAL_SECONDS: int = 60
    WEIGHTS_V7: Dict[str, Any] = field(default_factory=lambda: {
        "bonuses": {
            "W1_43-48": 15, "W2_82-86": 18, "W2_88+": 22,
            "SEQUENCIA": 10.1, "DANGEROUS_DIFF": 10.1,
            "PLACAR_APERTADO": 7, "DOMINIO": 6.1,
            "SUBS_OFENSIVAS": 5.1, "CLUSTER": 12,
            "ONDA": 9, "MOMENTUM": 12, "VOLUME": 8.1,
            "EDGE_MERCADO": 5.1, "FADIGA": -6,
            "DESESPERO": 5, "STEAM": 6, "SHARP": 4,
            "CHUVA": 4, "ARBITRO": 3
        },
        "kills": {
            "GOL_SOFRIDO": 20, "GOL_MARCADO": 8,
            "IP2_FALSO": 16, "PLACAR_ABERTO": 14.9,
            "APPM_BAIXO": 9.9, "VAR": 12,
            "0-0_POS85": 7, "RED_CARD": 10,
            "ZONA_MORTA": 12, "MERCADO_UNDER": 8, "VENTO": 3
        }
    })

CFG = Config()


# ==========================================
# DATA SOURCE AGENT (API-Football)
# ==========================================
class DataSourceAgent:
    def __init__(self, config: Config):
        self.config = config
        self.headers = {
            "x-rapidapi-key": config.RAPIDAPI_KEY,
            "x-rapidapi-host": config.RAPIDAPI_HOST,
        }
        self._session: Optional[aiohttp.ClientSession] = None
        self._rate_limit = asyncio.Semaphore(10)

    async def _get_session(self) -> aiohttp.ClientSession:
        if self._session is None or self._session.closed:
            timeout = aiohttp.ClientTimeout(total=15)
            self._session = aiohttp.ClientSession(headers=self.headers, timeout=timeout)
        return self._session

    async def _request(self, endpoint: str, params: Dict[str, Any]) -> Optional[Dict]:
        async with self._rate_limit:
            session = await self._get_session()
            url = f"{self.config.RAPIDAPI_BASE_URL}/{endpoint}"
            try:
                async with session.get(url, params=params) as resp:
                    if resp.status == 200:
                        return await resp.json()
                    elif resp.status == 429:
                        logger.warning(f"Rate limit | {endpoint}")
                        await asyncio.sleep(5)
                        return await self._request(endpoint, params)
                    else:
                        logger.error(f"API Error {resp.status} | {endpoint}")
                        return None
            except Exception as e:
                logger.error(f"Request error | {endpoint} | {e}")
                return None

    async def get_live_fixtures(self, league_id: Optional[int] = None) -> List[Dict]:
        params: Dict[str, Any] = {"live": "all"}
        if league_id:
            params["league"] = league_id
        data = await self._request("fixtures", params)
        if data and data.get("response"):
            logger.info(f"Live fixtures: {len(data['response'])}")
            return data["response"]
        return []

    async def get_fixture_statistics(self, fixture_id: int) -> Optional[Dict]:
        data = await self._request("fixtures/statistics", {"fixture": fixture_id})
        if data and data.get("response"):
            return data["response"]
        return None

    async def get_fixture_events(self, fixture_id: int) -> List[Dict]:
        data = await self._request("fixtures/events", {"fixture": fixture_id})
        if data and data.get("response"):
            return data["response"]
        return []

    async def get_corners_live(self, fixture_id: int) -> Optional[Dict]:
        stats = await self.get_fixture_statistics(fixture_id)
        if not stats:
            return None
        corners = {"home": 0, "away": 0, "total": 0}
        for i, team_stats in enumerate(stats):
            for stat in team_stats.get("statistics", []):
                if stat.get("type") == "Corner Kicks":
                    value = stat.get("value", 0) or 0
                    if i == 0:
                        corners["home"] = value
                    else:
                        corners["away"] = value
        corners["total"] = corners["home"] + corners["away"]
        return corners

    async def get_dangerous_attacks(self, fixture_id: int) -> Dict[str, int]:
        stats = await self.get_fixture_statistics(fixture_id)
        result = {"home": 0, "away": 0, "diff": 0}
        if not stats:
            return result
        for i, team_stats in enumerate(stats):
            for stat in team_stats.get("statistics", []):
                if stat.get("type") == "Dangerous Attacks":
                    value = stat.get("value", 0) or 0
                    if i == 0:
                        result["home"] = value
                    else:
                        result["away"] = value
        result["diff"] = abs(result["home"] - result["away"])
        return result

    async def close(self):
        if self._session and not self._session.closed:
            await self._session.close()


# ==========================================
# NOTIFICATION AGENT
# ==========================================
class NotificationAgent:
    def __init__(self, config: Config):
        self.config = config
        self._telegram_bot = None
        self._session: Optional[aiohttp.ClientSession] = None
        self._sent_signals: deque = deque(maxlen=100)

    @property
    def telegram_bot(self):
        if self._telegram_bot is None and Bot is not None:
            self._telegram_bot = Bot(token=self.config.TELEGRAM_BOT_TOKEN)
        return self._telegram_bot

    async def _get_session(self) -> aiohttp.ClientSession:
        if self._session is None or self._session.closed:
            self._session = aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=10))
        return self._session

    def _build_signal_message(self, signal: Dict[str, Any]) -> str:
        decision = signal.get("decision", "AGUARDA")
        emoji = {"ENTRA": "🟢", "AGUARDA": "🟡", "NÃO ENTRA": "🔴"}.get(decision, "⚪")
        return (
            f"{emoji} <b>CornerAI Signal v7.0</b>\n"
            f"━━━━━━━━━━━━━━━━━━━━━\n"
            f"⚽ <b>{signal.get('home', '?')} vs {signal.get('away', '?')}</b>\n"
            f"⏱ Minuto: <b>{signal.get('minute', '?')}'</b>\n"
            f"📊 Score: <b>{signal.get('score', 0)}/100</b>\n"
            f"🎯 Decisão: <b>{decision}</b>\n"
            f"━━━━━━━━━━━━━━━━━━━━━\n"
            f"📈 AP: {signal.get('ap_home', 0)} x {signal.get('ap_away', 0)} "
            f"(Δ{signal.get('ap_diff', 0)})\n"
            f"🔄 Escanteios: {signal.get('corners_home', 0)} x {signal.get('corners_away', 0)}\n"
            f"💡 Fatores: {signal.get('factors', '-')}\n"
            f"⚠️ Kills: {signal.get('kills_active', 'Nenhuma')}\n"
            f"━━━━━━━━━━━━━━━━━━━━━\n"
            f"🕐 {datetime.now().strftime('%H:%M:%S')} | MC: {signal.get('mc_prob', 'N/A')}%"
        )

    def _build_discord_embed(self, signal: Dict[str, Any]) -> Dict:
        decision = signal.get("decision", "AGUARDA")
        color = {"ENTRA": 0x00FF00, "AGUARDA": 0xFFFF00, "NÃO ENTRA": 0xFF0000}.get(decision, 0x808080)
        return {
            "embeds": [{
                "title": f"⚽ CornerAI Signal — {signal.get('home', '?')} vs {signal.get('away', '?')}",
                "color": color,
                "fields": [
                    {"name": "⏱ Minuto", "value": f"{signal.get('minute', '?')}'", "inline": True},
                    {"name": "📊 Score", "value": f"{signal.get('score', 0)}/100", "inline": True},
                    {"name": "🎯 Decisão", "value": f"**{decision}**", "inline": True},
                    {"name": "📈 Ataques Perigosos",
                     "value": f"{signal.get('ap_home', 0)} x {signal.get('ap_away', 0)} (Δ{signal.get('ap_diff', 0)})",
                     "inline": False},
                    {"name": "🔄 Escanteios",
                     "value": f"{signal.get('corners_home', 0)} x {signal.get('corners_away', 0)}", "inline": True},
                    {"name": "💡 Fatores", "value": signal.get("factors", "-"), "inline": False},
                    {"name": "⚠️ Kills", "value": signal.get("kills_active", "Nenhuma"), "inline": False},
                ],
                "footer": {"text": f"CornerAI v7.0 | MC: {signal.get('mc_prob', 'N/A')}% | {datetime.now().strftime('%H:%M:%S')}"},
                "timestamp": datetime.utcnow().isoformat(),
            }]
        }

    def _signal_key(self, signal: Dict) -> str:
        return f"{signal.get('fixture_id')}_{signal.get('minute')}_{signal.get('decision')}"

    async def send_telegram(self, signal: Dict[str, Any]) -> bool:
        if not self.config.TELEGRAM_BOT_TOKEN or not self.config.TELEGRAM_CHAT_ID or Bot is None:
            return False
        key = self._signal_key(signal)
        if key in self._sent_signals:
            return False
        self._sent_signals.append(key)
        try:
            await self.telegram_bot.send_message(
                chat_id=self.config.TELEGRAM_CHAT_ID,
                text=self._build_signal_message(signal),
                parse_mode=ParseMode.HTML if ParseMode else None,
            )
            logger.info(f"Telegram OK | {signal.get('home')} vs {signal.get('away')}")
            return True
        except Exception as e:
            logger.error(f"Telegram erro: {e}")
            return False

    async def send_discord(self, signal: Dict[str, Any]) -> bool:
        if not self.config.DISCORD_WEBHOOK_URL:
            return False
        key = self._signal_key(signal)
        if key in self._sent_signals:
            return False
        self._sent_signals.append(key)
        try:
            session = await self._get_session()
            async with session.post(
                self.config.DISCORD_WEBHOOK_URL,
                json=self._build_discord_embed(signal),
                headers={"Content-Type": "application/json"},
            ) as resp:
                if resp.status in (200, 204):
                    logger.info(f"Discord OK | {signal.get('home')} vs {signal.get('away')}")
                    return True
                logger.error(f"Discord HTTP {resp.status}")
                return False
        except Exception as e:
            logger.error(f"Discord erro: {e}")
            return False

    async def broadcast(self, signal: Dict[str, Any]):
        results = await asyncio.gather(
            self.send_telegram(signal),
            self.send_discord(signal),
            return_exceptions=True,
        )
        success = sum(1 for r in results if r is True)
        logger.info(f"Broadcast: {success}/2 canais")

    async def close(self):
        if self._session and not self._session.closed:
            await self._session.close()


# ==========================================
# SCORE AGENT v7.0
# ==========================================
class ScoreAgent:
    def __init__(self, config: Config):
        self.weights = config.WEIGHTS_V7

    def calculate(self, match_data: Dict[str, Any]) -> Dict[str, Any]:
        base_score = 50
        bonuses_applied = []
        kills_applied = []
        total_bonus = 0.0
        total_kill = 0.0

        minute = match_data.get("minute", 0)
        ap_diff = match_data.get("ap_diff", 0)
        score_diff = abs(match_data.get("score_home", 0) - match_data.get("score_away", 0))
        last_corner_min = match_data.get("last_corner_minute") or 0
        last_goal_min = match_data.get("last_goal_minute") or 0
        ip2_trend = match_data.get("ip2_trend", "stable")

        # Bônus
        if 43 <= minute <= 48:
            b = self.weights["bonuses"]["W1_43-48"]
            total_bonus += b
            bonuses_applied.append(f"W1_43-48(+{b})")
        if 82 <= minute <= 86 and score_diff <= 1:
            b = self.weights["bonuses"]["W2_82-86"]
            total_bonus += b
            bonuses_applied.append(f"W2_82-86(+{b})")
        if minute >= 88:
            b = self.weights["bonuses"]["W2_88+"]
            total_bonus += b
            bonuses_applied.append(f"W2_88+(+{b})")
        if last_corner_min and (minute - last_corner_min) <= 4:
            b = self.weights["bonuses"]["SEQUENCIA"]
            total_bonus += b
            bonuses_applied.append(f"SEQUENCIA(+{b})")
        if ap_diff >= 12:
            b = self.weights["bonuses"]["DANGEROUS_DIFF"]
            total_bonus += b
            bonuses_applied.append(f"AP_DIFF(+{b})")
        if score_diff <= 1:
            b = self.weights["bonuses"]["PLACAR_APERTADO"]
            total_bonus += b
            bonuses_applied.append(f"PLACAR_APERTADO(+{b})")
        if match_data.get("possession_dominant", 0) >= 60:
            b = self.weights["bonuses"]["DOMINIO"]
            total_bonus += b
            bonuses_applied.append(f"DOMINIO(+{b})")
        if match_data.get("momentum_rising", False):
            b = self.weights["bonuses"]["MOMENTUM"]
            total_bonus += b
            bonuses_applied.append(f"MOMENTUM(+{b})")

        # Kills
        if last_goal_min and (minute - last_goal_min) <= 3:
            k = self.weights["kills"]["GOL_SOFRIDO"]
            total_kill += k
            kills_applied.append(f"GOL_SOFRIDO(-{k})")
        if ip2_trend == "falling":
            k = self.weights["kills"]["IP2_FALSO"]
            total_kill += k
            kills_applied.append(f"IP2_FALSO(-{k})")
        if score_diff >= 2:
            k = self.weights["kills"]["PLACAR_ABERTO"]
            total_kill += k
            kills_applied.append(f"PLACAR_ABERTO(-{k})")
        if (match_data.get("score_home", 0) == 0 and match_data.get("score_away", 0) == 0
                and minute >= 85 and match_data.get("xg_dominant", 0) >= 0.6):
            k = self.weights["kills"]["0-0_POS85"]
            total_kill += k
            kills_applied.append(f"0-0_POS85(-{k})")
        if last_corner_min and (minute - last_corner_min) >= 15:
            k = self.weights["kills"]["ZONA_MORTA"]
            total_kill += k
            kills_applied.append(f"ZONA_MORTA(-{k})")
        if match_data.get("red_card_pressing_team", False):
            k = self.weights["kills"]["RED_CARD"]
            total_kill += k
            kills_applied.append(f"RED_CARD(-{k})")

        final_score = min(100, max(0, base_score + total_bonus - total_kill))
        factors_count = len(bonuses_applied)
        has_strong_kill = total_kill >= 15

        if final_score >= 78 and factors_count >= 3 and not has_strong_kill:
            decision = "ENTRA"
        elif 62 <= final_score <= 77:
            decision = "AGUARDA"
        else:
            decision = "NÃO ENTRA"

        return {
            "score": round(final_score, 1),
            "decision": decision,
            "bonuses": bonuses_applied,
            "kills": kills_applied,
            "factors_count": factors_count,
            "total_bonus": round(total_bonus, 1),
            "total_kill": round(total_kill, 1),
        }


# ==========================================
# ORCHESTRATOR
# ==========================================
class CornerAIOrchestrator:
    def __init__(self):
        self.config = CFG
        self.data_agent = DataSourceAgent(self.config)
        self.notification_agent = NotificationAgent(self.config)
        self.score_agent = ScoreAgent(self.config)
        self.mc_agent = MonteCarloAgent(n_sims=2000) if MonteCarloAgent else None
        self.scheduler = AsyncIOScheduler(timezone="America/Sao_Paulo") if AsyncIOScheduler else None
        self._running = False
        self.target_leagues = [71, 72]  # Série A, Série B

    def _is_within_active_window(self) -> bool:
        now = datetime.now().time()
        for start, end in self.config.JANELAS_ATIVAS:
            if start <= end:
                if start <= now <= end:
                    return True
            else:
                if now >= start or now <= end:
                    return True
        return False

    async def _process_fixture(self, fixture: Dict) -> Optional[Dict[str, Any]]:
        fixture_info = fixture.get("fixture", {})
        fixture_id = fixture_info.get("id")
        status = fixture_info.get("status", {})
        elapsed = status.get("elapsed", 0) or 0

        in_w1 = 30 <= elapsed <= 48
        in_w2 = elapsed >= 80
        if not (in_w1 or in_w2):
            return None

        teams = fixture.get("teams", {})
        home_name = teams.get("home", {}).get("name", "?")
        away_name = teams.get("away", {}).get("name", "?")
        goals = fixture.get("goals", {})
        score_home = goals.get("home", 0) or 0
        score_away = goals.get("away", 0) or 0

        logger.info(f"Processando: {home_name} vs {away_name} | {elapsed}' | {score_home}-{score_away}")

        ap_data = await self.data_agent.get_dangerous_attacks(fixture_id)
        corners = await self.data_agent.get_corners_live(fixture_id) or {"home": 0, "away": 0, "total": 0}

        match_data = {
            "minute": elapsed,
            "score_home": score_home,
            "score_away": score_away,
            "ap_home": ap_data["home"],
            "ap_away": ap_data["away"],
            "ap_diff": ap_data["diff"],
            "corners_home": corners["home"],
            "corners_away": corners["away"],
            "last_corner_minute": None,
            "last_goal_minute": None,
            "ip2_trend": "stable",
            "possession_dominant": 0,
            "momentum_rising": ap_data["diff"] >= 15,
            "xg_dominant": 0,
            "red_card_pressing_team": False,
        }

        result = self.score_agent.calculate(match_data)

        # Monte Carlo gate
        mc_prob = "N/A"
        mc_rec = ""
        decision = result["decision"]
        if self.mc_agent is not None:
            match_data["half"] = 1 if elapsed <= 48 else 2
            match_data["added_time"] = 4
            mc = self.mc_agent.estimate_from_dict(match_data)
            mc_prob = mc.prob_pct
            mc_rec = mc.recommendation
            has_strong = result["total_kill"] >= 15
            if apply_mc_gate is not None:
                decision, _just = apply_mc_gate(
                    result["score"], result["factors_count"], has_strong, mc
                )

        signal = {
            "fixture_id": fixture_id,
            "home": home_name,
            "away": away_name,
            "minute": elapsed,
            "score": result["score"],
            "decision": decision,
            "ap_home": ap_data["home"],
            "ap_away": ap_data["away"],
            "ap_diff": ap_data["diff"],
            "corners_home": corners["home"],
            "corners_away": corners["away"],
            "factors": ", ".join(result["bonuses"]) or "Nenhum",
            "kills_active": ", ".join(result["kills"]) or "Nenhuma",
            "mc_prob": mc_prob,
            "mc_recommendation": mc_rec,
        }
        logger.info(
            f"SIGNAL | {home_name} vs {away_name} | {elapsed}' | "
            f"Score={result['score']} | {result['decision']}"
        )
        return signal

    async def _check_cycle(self):
        if not self._is_within_active_window():
            logger.debug("Fora da janela ativa — skip")
            return
        logger.info("━━━ Ciclo de verificação iniciado ━━━")
        for league_id in self.target_leagues:
            try:
                fixtures = await self.data_agent.get_live_fixtures(league_id=league_id)
            except Exception as e:
                logger.error(f"Erro fixtures league={league_id}: {e}")
                continue
            for fixture in fixtures:
                try:
                    signal = await self._process_fixture(fixture)
                    if signal and signal["decision"] in ("ENTRA", "AGUARDA"):
                        await self.notification_agent.broadcast(signal)
                except Exception as e:
                    logger.error(f"Erro processando fixture: {e}")
        logger.info("━━━ Ciclo finalizado ━━━")

    def _setup_scheduler(self):
        if not self.scheduler:
            logger.error("APScheduler não disponível")
            return
        self.scheduler.add_job(
            self._check_cycle,
            trigger=IntervalTrigger(seconds=self.config.CHECK_INTERVAL_SECONDS),
            id="cornerai_main_loop",
            name="CornerAI Main Check Loop",
            replace_existing=True,
            max_instances=1,
            misfire_grace_time=30,
        )

    async def start(self):
        logger.info("=" * 50)
        logger.info("CornerAI v7.0 — Orquestrador Iniciado")
        logger.info(f"Ligas: {self.target_leagues}")
        logger.info(f"Intervalo: {self.config.CHECK_INTERVAL_SECONDS}s")
        logger.info("=" * 50)
        self._setup_scheduler()
        if self.scheduler:
            self.scheduler.start()
        self._running = True
        try:
            while self._running:
                await asyncio.sleep(1)
        except (KeyboardInterrupt, SystemExit):
            await self.stop()

    async def stop(self):
        logger.info("Parando CornerAI Orchestrator...")
        self._running = False
        if self.scheduler:
            self.scheduler.shutdown(wait=False)
        await self.data_agent.close()
        await self.notification_agent.close()
        logger.info("Parado.")


async def main():
    orchestrator = CornerAIOrchestrator()
    await orchestrator.start()


if __name__ == "__main__":
    asyncio.run(main())
```
