#!/usr/bin/env python3
"""CornerAI v8.0 — Sistema Unificado de Trading de Escanteios
MatchState tipado, Kelly correto, MC com seed, Pattern cosseno, Adam, 18 agentes
"""
import asyncio, json, os, sys, random, math
from datetime import datetime, time as dtime
from typing import Optional, Dict, Any, List, Tuple
from dataclasses import dataclass, field
from collections import defaultdict, deque
from pathlib import Path
from functools import lru_cache
try:
    import aiohttp
except ImportError:
    aiohttp = None
try:
    from loguru import logger
    logger.remove()
    logger.add("logs/cornerai_{time:YYYY-MM-DD}.log", rotation="00:00", retention="30 days",
               compression="gz", level="DEBUG", enqueue=True,
               format="{time:HH:mm:ss.SSS}|{level:<8}|{message}")
    logger.add(lambda m: print(m, end=""), level="INFO",
               format="<green>{time:HH:mm:ss}</green>|<level>{level:<8}</level>|<cyan>{message}</cyan>\n")
except ImportError:
    import logging
    logging.basicConfig(level=logging.INFO, format="%(asctime)s|%(levelname)s|%(message)s")
    logger = logging.getLogger("cornerai")

@dataclass
class Config:
    RAPIDAPI_KEY: str = os.getenv("RAPIDAPI_KEY", "")
    RAPIDAPI_HOST: str = "api-football-v1.p.rapidapi.com"
    RAPIDAPI_BASE: str = "https://api-football-v1.p.rapidapi.com/v3"
    TG_BOT: str = os.getenv("TELEGRAM_BOT_TOKEN", "")
    TG_CHAT: str = os.getenv("TELEGRAM_CHAT_ID", "")
    DISCORD_URL: str = os.getenv("DISCORD_WEBHOOK_URL", "")
    JANELAS: List[Tuple] = field(default_factory=lambda: [(dtime(15, 0), dtime(23, 59)), (dtime(0, 0), dtime(2, 0))])
    CHECK_INT: int = 60
    TARGET_LEAGUES: List[int] = field(default_factory=lambda: [71, 72, 73, 75])
    BANKROLL: float = 1000.0
    KELLY_FRAC: float = 0.25
    MAX_DAILY: int = 8
    MAX_CONSEC: int = 3
    COOLDOWN_MIN: int = 3
    MC_SIMS: int = 2000
