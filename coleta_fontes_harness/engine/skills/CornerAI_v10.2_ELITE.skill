@dataclass
class MatchState:
    minute: int; half: int; added_time: int; score_home: int; score_away: int
    attacks_home: int = 0; attacks_away: int = 0
    dangerous_attacks_home: int = 0; dangerous_attacks_away: int = 0
    shots_on_target_home: int = 0; shots_on_target_away: int = 0
    shots_inside_box_home: int = 0; shots_inside_box_away: int = 0
    possession_home: float = 50.0; possession_away: float = 50.0
    xg_home: float = 0.0; xg_away: float = 0.0
    corners_home: int = 0; corners_away: int = 0
    last_corner_minute: Optional[int] = None; last_corner_team: Optional[str] = None
    last_goal_minute: Optional[int] = None; last_goal_team: Optional[str] = None
    var_recent: bool = False; long_stop_recent: bool = False
    red_card_home: int = 0; red_card_away: int = 0
    subs_offensive_home: int = 0; subs_offensive_away: int = 0
    subs_total_home: int = 0; subs_total_away: int = 0
    graph_standard_trend: List[float] = field(default_factory=list)
    graph_accumulated_home: int = 0; graph_accumulated_away: int = 0
    home_team: str = ""; away_team: str = ""; competition: str = ""
    odds_over: float = 1.85; odds_under: float = 1.95; liquidity: float = 0.0
    weather: str = "normal"; referee_avg_corners: float = 9.5
    fixture_id: Optional[int] = None

    @property
    def total_corners(self) -> int: return self.corners_home + self.corners_away
    @property
    def score_diff(self) -> int: return abs(self.score_home - self.score_away)
    @property
    def is_draw(self) -> bool: return self.score_home == self.score_away
    @property
    def ap_diff_home(self) -> int: return self.dangerous_attacks_home - self.dangerous_attacks_away
    @property
    def ap_diff_away(self) -> int: return self.dangerous_attacks_away - self.dangerous_attacks_home
    @property
    def window(self) -> str:
        if self.half == 1 and 30 <= self.minute <= 45 + self.added_time: return "W1"
        if self.half == 2 and 75 <= self.minute <= 90 + self.added_time: return "W2"
        return "OUT"
    @property
    def match_key(self) -> str: return f"{self.home_team}_{self.away_team}"
    @property
    def time_remaining(self) -> int:
        if self.window == "W1": return max(0, 45 + self.added_time - self.minute)
        if self.window == "W2": return max(0, 90 + self.added_time - self.minute)
        return 0
    @property
    def dominant_team(self) -> str: return "home" if self.possession_home > self.possession_away else "away"
    @property
    def dominant_ap(self) -> int: return max(self.ap_diff_home, self.ap_diff_away)

    def to_vec(self) -> List[float]:
        return [
            self.minute / 90, self.score_home / 5, self.score_away / 5,
            self.ap_diff_home / 50, self.ap_diff_away / 50,
            self.possession_home / 100, self.possession_away / 100,
            self.xg_home, self.xg_away, self.total_corners / 20,
            (self.minute - (self.last_corner_minute or self.minute)) / 20,
            1.0 if self.is_draw else 0.0, self.score_diff / 5, self.dominant_ap / 50,
        ]

class DataSourceAgent:
    def __init__(self, cfg: Config = CFG): self.cfg = cfg
    async def live_fixtures(self, league_id=None): return []
    async def build_state(self, fixture): return None
    async def close(self): pass

class NotificationAgent:
    def __init__(self, cfg: Config = CFG): self.cfg = cfg
    async def broadcast(self, s): pass
    async def close(self): pass

class DataQualityAgent:
    def __init__(self):
        self._hist: deque = deque(maxlen=40)
        self.tol_xg = 0.05
    def validate(self, s: MatchState) -> Tuple[bool, List[str]]:
        issues = []
        if not (95 <= s.possession_home + s.possession_away <= 105):
            issues.append("POSSE")
        if self._hist:
            p = self._hist[-1]
            if s.half == p.half:
                if s.minute < p.minute: issues.append("RELOGIO")
                if s.dangerous_attacks_home < p.dangerous_attacks_home: issues.append("DA_H_DECR")
                if s.dangerous_attacks_away < p.dangerous_attacks_away: issues.append("DA_A_DECR")
                if s.corners_home < p.corners_home: issues.append("COR_H_DECR")
                if s.corners_away < p.corners_away: issues.append("COR_A_DECR")
                if s.xg_home < p.xg_home - self.tol_xg: issues.append("xG_H_DECR")
                if s.xg_away < p.xg_away - self.tol_xg: issues.append("xG_A_DECR")
        self._hist.append(s)
        return len(issues) == 0, issues

class MonteCarloAgent:
    """MC com taxas relativas a janela + seed controlavel. Calibracao v7 embutida."""
    BASE_W1, BASE_W2 = 0.069, 0.090
    def __init__(self, n: int = 2000):
        self.n = n
    def simulate(self, s: MatchState, seed: Optional[int] = None) -> Dict[str, Any]:
        if s.window == "OUT":
            return {"prob": 0.0, "passes": False, "avg_t": 0, "exp_min": s.minute, "mult": 0}
        rng = random.Random(seed or (s.fixture_id or CFG.SEED))
        base = self.BASE_W1 if s.window == "W1" else self.BASE_W2
        rem = max(1, s.time_remaining)
        ap, sd = s.dominant_ap, s.score_diff
        mult = 1.0
        if ap >= 20: mult *= 1.45
        elif ap >= 12: mult *= 1.30
        elif ap >= 6: mult *= 1.12
        if s.last_corner_minute is not None:
            gap = s.minute - s.last_corner_minute
            if gap <= 4: mult *= 1.35
            elif gap <= 8: mult *= 1.10
            elif gap >= 20: mult *= 0.50
            elif gap >= 15: mult *= 0.60
            elif gap >= 10: mult *= 0.82
        if sd == 0: mult *= 1.15
        elif sd == 1: mult *= 1.20
        elif sd >= 2: mult *= 0.60
        if s.window == "W1" and s.minute >= 43: mult *= 1.34
        elif s.window == "W2" and s.minute >= 88: mult *= 1.35
        elif s.window == "W2" and 80 <= s.minute <= 84: mult *= 1.45
        elif s.window == "W2" and s.minute >= 82: mult *= 1.25
        if s.weather == "rain": mult *= 1.15
        if s.is_draw and s.minute >= 85 and max(s.xg_home, s.xg_away) >= 0.55: mult *= 0.70
        if (s.red_card_home + s.red_card_away) > 0: mult *= 0.75
        rate = max(0.005, min(0.35, base * mult))
        hits, ttf = 0, []
        for _ in range(self.n):
            # Poisson no horizonte
            lam = rate * rem * rng.uniform(0.85, 1.15)
            # amostra poisson simples
            if lam <= 0:
                continue
            L, k, p = math.exp(-min(lam, 20)), 0, 1.0
            while p > L:
                k += 1
                p *= rng.random()
            if k - 1 >= 1:
                hits += 1
                # tempo medio aproximado
                ttf.append(rng.uniform(0.3, rem))
        prob = hits / self.n
        avg_t = sum(ttf) / len(ttf) if ttf else rem
        return {"prob": prob, "passes": prob >= 0.45, "avg_t": round(avg_t, 1),
                "exp_min": s.minute + round(avg_t), "mult": round(mult, 2), "rate": round(rate, 4)}

class FatigueAgent:
    def calculate(self, s: MatchState) -> Dict[str, Any]:
        minute = s.minute
        subs = s.subs_total_home if s.dominant_team == "home" else s.subs_total_away
        total_atk = s.dangerous_attacks_home + s.dangerous_attacks_away
        fatigue = min(100, max(0, minute * 0.8 + max(0, total_atk - 150) * 0.3 - subs * 8))
        desespero = min(30, (minute - 75) * 3) if minute >= 80 and s.score_diff <= 1 else 0
        eff = max(0, fatigue - desespero)
        adj = -6 if eff >= 70 else (5 if eff >= 50 and desespero >= 15 else 0)
        return {"fatigue": round(fatigue, 1), "desespero": round(desespero, 1), "eff": round(eff, 1),
                "adj": adj, "type": "FADIGA" if adj < 0 else ("DESESPERO" if adj > 0 else "NEUTRO")}

class CorrelationAgent:
    GROUPS = [
        ({"SEQUENCIA", "CLUSTER", "ONDA"}, 0.6),
        ({"MOMENTUM", "DANGEROUS_DIFF"}, 0.5),
        ({"DOMINIO", "DANGEROUS_DIFF"}, 0.5),
        ({"DOMINIO", "SEQUENCIA", "DANGEROUS_DIFF"}, 0.4),
        ({"W2_82-86", "W2_88+"}, 1.0),
        ({"MUST_WIN_N1", "MUST_WIN_N2", "PLACAR_APERTADO"}, 0.4),
        ({"XC_ALTO", "DOMINIO"}, 0.5),
    ]
    BONUS_CAP = 42.0  # teto de bônus líquido antes de kills
    def adjust(self, bonuses: List[str], weights: Dict) -> Tuple[List[str], float]:
        active = {b.split("(")[0].strip() for b in bonuses}
        red, notes = 0.0, []
        for grp, pct in self.GROUPS:
            hit = [a for a in active if any(g in a for g in grp)]
            need = 3 if len(grp) >= 3 else 2
            if len(hit) >= need:
                ws = [weights["bonuses"].get(h, weights["bonuses"].get(h.split("_")[0], 0)) for h in hit]
                # map partial names
                ws2 = []
                for h in hit:
                    w = weights["bonuses"].get(h, 0)
                    if not w:
                        for k,v in weights["bonuses"].items():
                            if k in h or h in k:
                                w = v; break
                    ws2.append(w)
                m = min(ws2) if ws2 else 0
                red += abs(m) * pct
                notes.append(f"CORR:{'+'.join(hit[:3])}")
        return notes, red

class PatternMatcher:
    def __init__(self, cases: List[Dict] = None):
        self.cases = cases or CASES_DB
        self._vecs = [self._case_vec(c) for c in self.cases]
    def _case_vec(self, c: Dict) -> List[float]:
        return [
            c.get("minute", 0) / 90, c.get("score_home", 0) / 5, c.get("score_away", 0) / 5,
            c.get("ap_home", 0) / 50, c.get("ap_away", 0) / 50, c.get("ap_diff", 0) / 50,
            1.0 if c.get("sequence") else 0.0, c.get("possession_dominant", 50) / 100,
            1.0 if c.get("momentum_rising") else 0.0, c.get("xg_dominant", 0),
            1.0 if c.get("red_card") else 0.0, 1.0 if c.get("weather") == "rain" else 0.0,
        ]
    def _cos(self, a: List[float], b: List[float]) -> float:
        dp = sum(x * y for x, y in zip(a, b))
        na = math.sqrt(sum(x * x for x in a))
        nb = math.sqrt(sum(x * x for x in b))
        return dp / (na * nb) if na and nb else 0.0
    def find(self, s: MatchState, top_n: int = 3) -> List[Dict]:
        v = s.to_vec()
        # alinhar dimensoes (to_vec tem 14, case_vec 12) — usar subset
        v12 = v[:12] if len(v) >= 12 else v + [0] * (12 - len(v))
        scored = [(self._cos(v12, cv), c) for c, cv in zip(self.cases, self._vecs)]
        scored.sort(key=lambda x: -x[0])
        return [
            {"id": c["id"], "match": c["match"], "sim": round(sv, 3), "result": c["result"],
             "pattern": c.get("pattern", ""), "learning": c.get("key_learning", "")}
            for sv, c in scored[:top_n]
        ]

class ContextAgent:
    def __init__(self):
        self._cache: Dict[str, Dict] = {}
    def load(self, s: MatchState) -> Dict:
        k = f"{s.home_team}_{s.away_team}_{s.competition}"
        if k not in self._cache:
            self._cache[k] = {"avg_c_m": 9.3, "h2h": 10.5, "h_w1": 0.72, "a_w2": 0.68, "h_da": 28.5, "a_da": 24.3}
        return self._cache[k]
    def score(self, s: MatchState) -> Tuple[float, List[str]]:
        # Placeholder H2H/médias desligado até dados reais (auditoria A: +6 grátis inflava Score)
        ctx = self.load(s)
        if not getattr(s, "context_real", False):
            return 0.0, []
        sc, n = 0.0, []
        if ctx.get("h2h", 0) > 9: sc += 4; n.append("H2H_ACIMA")
        if ctx.get("avg_c_m", 0) > 9.0: sc += 3; n.append("ALTA_MEDIA")
        return sc, n

class MomentumAgent:
    def __init__(self, hist: deque):
        self.hist = hist
    def score(self, s: MatchState) -> Tuple[float, str]:
        if len(self.hist) < 2:
            return (12, "MOMENTUM_ALTO") if s.dominant_ap >= 20 else (0, "")
        return (12, "MOMENTUM_ALTO") if s.dominant_ap >= 20 else ((7, "MOMENTUM_MED") if s.dominant_ap >= 12 else (0, ""))

class DriftAgent:
    def __init__(self, window: int = 20):
        self._scores: deque = deque(maxlen=window)
    def check(self, score: float, bonuses, kills) -> Tuple[bool, str]:
        self._scores.append(score)
        if len(self._scores) < 10:
            return False, ""
        recent = list(self._scores)
        avg = sum(recent) / len(recent)
        var = sum((x - avg) ** 2 for x in recent) / len(recent)
        if var > 400: return True, f"DRIFT_VAR_{var:.0f}"
        return False, ""

class ConfidenceAgent:
    def interval(self, base_score: float, bonuses: List[str], kills: List[str]) -> Tuple[float, float, float]:
        # heuristica simples de largura
        width = 5 + len(kills) * 3 + max(0, 10 - len(bonuses)) * 2
        lo = max(0, base_score - width / 2)
        hi = min(100, base_score + width / 2)
        return round(lo, 1), round(hi, 1), round(hi - lo, 1)

class RiskManager:
    def __init__(self, bankroll: float = CFG.BANKROLL):
        self.br = bankroll
        self.daily = 0
        self.results: deque = deque(maxlen=10)
        self.cooldown: Dict[str, int] = {}
        self.max_d = CFG.MAX_DAILY
        self.max_c = CFG.MAX_CONSEC
        self.kf = CFG.KELLY_FRAC
    def can_enter(self, mk: str, window: str, minute: int) -> Tuple[bool, str]:
        k = f"{mk}_{window}"
        if self.cooldown.get(k, 0) > minute:
            return False, f"COOLDOWN_{self.cooldown[k]}'"
        if self.daily >= self.max_d:
            return False, f"DAILY_MAX_{self.max_d}"
        recent = list(self.results)
        if len(recent) >= self.max_c and all(r == "RED" for r in recent[-self.max_c:]):
            return False, f"CONSEC_{self.max_c}"
        return True, "OK"
    def calc_stake(self, score: float, mc_prob: float, odds: float = 1.85, conf: float = 0.5) -> Dict[str, Any]:
        # Kelly correto: f* = (b*p - q) / b  onde b = odds-1, p = prob, q = 1-p
        p = max(0.01, min(0.99, mc_prob * conf))
        b = max(0.01, odds - 1)
        q = 1 - p
        kelly = max(0, min((b * p - q) / b, 0.15))
        stake_pct = kelly * self.kf
        return {
            "kelly_full": round(kelly * 100, 2),
            "stake_pct": round(stake_pct * 100, 2),
            "value": round(self.br * stake_pct, 2),
            "conf": "ALTA" if kelly >= 0.08 else ("MED" if kelly >= 0.04 else "BAIXA"),
        }
    def record(self, mk: str, window: str, minute: int, outcome: str, profit: float = 0):
        self.daily += 1
        self.results.append(outcome)
        self.br += profit
        if outcome == "RED":
            self.cooldown[f"{mk}_{window}"] = minute + CFG.COOLDOWN_MIN
    def reset(self):
        self.daily = 0
        self.results.clear()
        self.cooldown.clear()

class LearningAgent:
    def __init__(self, path: str = "cornerai_v8_weights.json"):
        self.path = Path(path)
        self.lr = 0.05
        self.beta1, self.beta2, self.eps = 0.9, 0.999, 1e-8
        self.m: Dict = defaultdict(lambda: defaultdict(float))
        self.v: Dict = defaultdict(lambda: defaultdict(float))
        self.t = 0
        self.history: List[Dict] = []
        self.w = self._load()
    def _load(self) -> Dict:
        if self.path.exists():
            with open(self.path) as f:
                return json.load(f)
        return {k: dict(v) for k, v in WEIGHTS_V8.items()} | {"meta": {"v": "8.0", "upd": 0, "last": None}}
    def _save(self):
        self.w.setdefault("meta", {})["last"] = datetime.now().isoformat()
        self.w["meta"]["upd"] = self.w["meta"].get("upd", 0) + 1
        with open(self.path, "w") as f:
            json.dump(self.w, f, indent=2)
    def record(self, bonuses: List[str], kills: List[str], outcome: str, mc_err: float = 0.0):
        self.t += 1
        self.history.append({"t": self.t, "out": outcome})
        for b in bonuses:
            k = b.split("(")[0].strip()
            for wk in list(self.w.get("bonuses", {})):
                if wk in k or k in wk:
                    g = (1 if outcome == "GREEN" else -1) * (1 + abs(mc_err))
                    self.m["bonuses"][wk] = self.beta1 * self.m["bonuses"][wk] + (1 - self.beta1) * g
                    self.v["bonuses"][wk] = self.beta2 * self.v["bonuses"][wk] + (1 - self.beta2) * g * g
                    mhat = self.m["bonuses"][wk] / (1 - self.beta1 ** self.t)
                    vhat = self.v["bonuses"][wk] / (1 - self.beta2 ** self.t)
                    self.w["bonuses"][wk] = max(0.5, self.w["bonuses"][wk] + self.lr * mhat / (math.sqrt(vhat) + self.eps))
        for k in kills:
            kk = k.split("(")[0].strip()
            for wk in list(self.w.get("kills", {})):
                if wk in kk or kk in wk:
                    g = (-1 if outcome == "GREEN" else 1) * (1 + abs(mc_err))
                    self.m["kills"][wk] = self.beta1 * self.m["kills"][wk] + (1 - self.beta1) * g
                    self.v["kills"][wk] = self.beta2 * self.v["kills"][wk] + (1 - self.beta2) * g * g
                    mhat = self.m["kills"][wk] / (1 - self.beta1 ** self.t)
                    vhat = self.v["kills"][wk] / (1 - self.beta2 ** self.t)
                    self.w["kills"][wk] = max(0.5, self.w["kills"][wk] + self.lr * mhat / (math.sqrt(vhat) + self.eps))
        self._save()


# --- Elite v9 helpers: Must Win, xC, Stop-Live, Gatilhos 2-de-3 ---

def goal_alert(s: "MatchState") -> dict:
    """Alerta de gol como CONTEXTO para escanteios. Nunca produto principal."""
    m = s.minute
    sd = s.score_diff
    lgm = s.last_goal_minute
    alert = {"active": False, "type": None, "msg": "", "impact": ""}
    # GOAL_JUST
    if lgm is not None and 0 <= (m - lgm) <= 3:
        alert = {
            "active": True, "type": "GOAL_JUST",
            "msg": f"Gol recente aos {lgm}' (há {m-lgm} min)",
            "impact": "Kill GOL_* ativo — resfriar 3 min antes de novo ENTRA",
        }
        return alert
    # GOAL_RISK (P005)
    if s.is_draw and m >= 85 and max(s.xg_home, s.xg_away) >= 0.55 and s.dominant_ap >= 8:
        alert = {
            "active": True, "type": "GOAL_RISK",
            "msg": "0-0 pós-85' + domínio/xG — risco de gol no lugar do canto (P005)",
            "impact": "Preferir AGUARDA; kill 0-0_POS85",
        }
        return alert
    # GOAL_OPEN
    if sd >= 2:
        alert = {
            "active": True, "type": "GOAL_OPEN",
            "msg": f"Placar aberto (diff {sd})",
            "impact": "Kill PLACAR_ABERTO — necessidade ofensiva reduzida",
        }
        return alert
    # GOAL_EQUALIZER hint: empate recente já coberto por GOAL_JUST; se empate e W2
    if s.is_draw and m >= 80 and lgm is not None and (m - lgm) <= 8:
        alert = {
            "active": True, "type": "GOAL_EQUALIZER",
            "msg": f"Empate recente ({lgm}') — possível reativação de pressão",
            "impact": "Monitorar sequência de canto 2-5 min após empate",
        }
        return alert
    return alert


def build_reg_log(s: "MatchState", result: dict, reg_id: str = None, odds: dict = None,
                  request_type: str = "ANALISE_LIVE", user_request: str = "") -> str:
    """Monta registro REG-* em markdown para CornerAI_Log_Analises_Entradas.md."""
    now = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    rid = reg_id or f"REG-{datetime.now().strftime('%Y%m%d')}-XXX"
    odds = odds or {}
    ga = result.get("goal_alert") or {}
    lines = [
        f"### {rid}",
        f"**Timestamp solicitação:** {now}",
        f"**Tipo:** {request_type}",
        "",
        "#### 1. Identificação",
        f"- {s.competition or 'N/D'} | {s.home_team} × {s.away_team}",
        f"- Fixture: {s.fixture_id or 'N/D'} | Janela: {s.window}",
        f"- Pedido: {user_request or 'N/D'}",
        "",
        "#### 3. Relógio e placar",
        f"- Minuto: {s.minute}' (half {s.half}, +{s.added_time}) | Placar: {s.score_home}×{s.score_away}",
        "",
        "#### 4. Odds",
    ]
    if odds:
        for k, v in odds.items():
            lines.append(f"- {k}: {v}")
    else:
        lines.append(f"- Over cantos ref: {getattr(s, 'odds_over', 'N/D')} | Under: {getattr(s, 'odds_under', 'N/D')}")
    lines += [
        "",
        "#### 5. Estatísticas (Casa | Visitante)",
        f"| AP | {s.dangerous_attacks_home} | {s.dangerous_attacks_away} |",
        f"| Posse | {s.possession_home} | {s.possession_away} |",
        f"| Escanteios | {s.corners_home} | {s.corners_away} |",
        f"| xG | {s.xg_home} | {s.xg_away} |",
        f"| Último canto | {s.last_corner_minute} | — |",
        f"| Último gol | {s.last_goal_minute} | {s.last_goal_team or '—'} |",
        "",
        "#### 7. CornerAI",
        f"- Score: {result.get('score')} | Decisão: **{result.get('decision')}**",
        f"- Bônus: {result.get('bonuses')}",
        f"- Kills: {result.get('kills')}",
        f"- MC: {result.get('mc', {})}",
        f"- Gatilhos: {result.get('n_triggers')}/3 {result.get('triggers')}",
        f"- Must Win: N{result.get('must_win')} | Stop65: {result.get('stop_live_65')}",
        f"- Goal Alert: {ga if ga.get('active') else 'inativo'}",
        "",
        "#### 8. Decisão",
        f"- **{result.get('decision')}**",
        "",
        "#### 9. Resultado (POS_JOGO — preencher depois)",
        "- Minuto real canto: ",
        "- Acerto/Erro: ",
        "- Cantos finais Casa | Visitante | Total: ",
        "- Motivo / padrão: ",
        "",
        "---",
        "",
    ]
    return "\n".join(lines)

def append_reg_log(markdown_block: str, path: str = "CornerAI_Log_Analises_Entradas.md"):
    """Append REG block to log file."""
    p = Path(path)
    if not p.exists():
        p.write_text("# CornerAI Log\n\n", encoding="utf-8")
    with p.open("a", encoding="utf-8") as f:
        f.write("\n" + markdown_block)
    return str(p)


def must_win_level(s: "MatchState") -> int:
    """Heuristic Must Win: N1=desespero, N2=alta, N3=cumprimento. 0=desconhecido."""
    sd = s.score_diff
    if s.window == "OUT":
        return 0
    # Time atrás por 1 ou empate em W2 com necessidade
    if sd == 0:
        return 2  # empate motiva
    if sd == 1:
        return 1  # desespero relativo
    if sd >= 2:
        return 3  # placar aberto → cumprimento do líder
    return 0

def calc_xc(corners_made_avg: float, corners_conceded_opp_avg: float, league_avg: float = 5.0) -> float:
    """xC = feitos × sofridos_adv / média_liga. league_avg ~ cantos por time por jogo."""
    if league_avg <= 0:
        return 1.0
    return (corners_made_avg * corners_conceded_opp_avg) / league_avg

def stop_live_65(s: "MatchState") -> bool:
    """0 cantos no 2T até 65' + pressão baixa → Stop-Live."""
    if s.half != 2 or s.minute < 65 or s.minute >= 80:
        return False
    # Sem cantos no 2T: se last_corner foi no 1T ou None e minute>=65
    lc = s.last_corner_minute
    no_corners_2t = (lc is None) or (lc <= 45)
    low_pressure = s.dominant_ap < 8
    return no_corners_2t and low_pressure

def count_triggers(s: "MatchState", xc: float = 1.0) -> tuple:
    """Retorna (n_ativos, lista_labels). Precisa ≥2 para confirmar ENTRA."""
    active = []
    # G1 pressão territorial (proxy: AP diff ou posse dominante)
    if s.dominant_ap >= 12 or max(s.possession_home, s.possession_away) >= 58:
        active.append("G1_PRESSAO")
    # G2 conversão
    gap_ok = s.last_corner_minute is not None and (s.minute - s.last_corner_minute) <= 4
    if xc >= 1.2 or gap_ok or s.dominant_ap >= 12:
        active.append("G2_CONVERSAO")
    # G3 contexto
    mw = must_win_level(s)
    red = (s.red_card_home + s.red_card_away) > 0
    if mw in (1, 2) and s.score_diff <= 1 and not red:
        active.append("G3_CONTEXTO")
    return len(active), active



class TimingAgent:
    """Bloqueia ENTRA fora do pico temporal, salvo sequência forte."""
    W1_PEAK = (40, 48)
    W2_PEAK = (82, 88)
    W2_LATE = 88

    def in_peak(self, s: "MatchState") -> tuple:
        m = s.minute
        if s.window == "W1":
            ok = self.W1_PEAK[0] <= m <= self.W1_PEAK[1] + s.added_time
            return ok, "W1_PEAK_40-48" if ok else "W1_EARLY_OR_LATE"
        if s.window == "W2":
            if m >= self.W2_LATE:
                return True, "W2_88+"
            ok = self.W2_PEAK[0] <= m <= self.W2_PEAK[1]
            return ok, "W2_PEAK_82-88" if ok else "W2_OFF_PEAK"
        return False, "OUT_OF_WINDOW"

    def strong_sequence(self, s: "MatchState") -> bool:
        if s.last_corner_minute is None:
            return False
        return (s.minute - s.last_corner_minute) <= 4 and s.dominant_ap >= 12

    def allows_enter(self, s: "MatchState", score: float = 0) -> tuple:
        peak, label = self.in_peak(s)
        if peak:
            return True, label
        # W1 38-39' com sequência: override moderado (P006 pattern)
        if s.window == "W1" and s.minute >= 38 and self.strong_sequence(s) and score >= 80:
            return True, "SEQUENCIA_W1_OVERRIDE"
        if self.strong_sequence(s) and s.window == "W2" and score >= 85:
            return True, "SEQUENCIA_FORTE_OVERRIDE"
        return False, f"TIMING_BLOCK:{label}"


class GateAgent:
    """Gate unificado: Score + MC + gatilhos + kill + Stop-Live + Timing + Risk."""
    def __init__(self, risk: "RiskManager" = None, timing: TimingAgent = None):
        self.risk = risk or RiskManager()
        self.timing = timing or TimingAgent()

    def can_enter(self, s: "MatchState", result: dict) -> dict:
        reasons = []
        score = result.get("score", 0)
        mc = result.get("mc") or {}
        mc_prob = mc.get("prob", 0) if isinstance(mc, dict) else 0
        mc_pass = mc.get("passes", mc_prob >= 0.45) if isinstance(mc, dict) else mc_prob >= 0.45
        fc = result.get("fc", 0)
        tk = result.get("tk", 0)
        n_trig = result.get("n_triggers", 0)
        kills = result.get("kills") or []
        kill_names = " ".join(str(k) for k in kills)
        named_strong = any(x in kill_names for x in (
            "0-0_POS85", "DOMINIO_ESTERIL", "ZONA_MORTA", "PLACAR_ABERTO", "GOL_SOFRIDO", "STOP_LIVE"
        ))
        sk = tk >= 15 or named_strong
        stop65 = result.get("stop_live_65") or stop_live_65(s)

        if stop65:
            return {"ok": False, "decision": "NÃO ENTRA", "reason": "STOP_LIVE_65", "reasons": ["STOP_LIVE_65"]}
        if sk:
            return {"ok": False, "decision": "NÃO ENTRA", "reason": "KILL_FORTE", "reasons": ["KILL_FORTE", kill_names[:40]]}

        timing_ok, timing_label = self.timing.allows_enter(s, score=result.get("score", 0))
        if not timing_ok:
            reasons.append(timing_label)
            # fora do pico: no máximo AGUARDA
            if score >= 70 and mc_prob >= 0.55:
                return {"ok": False, "decision": "AGUARDA", "reason": timing_label, "reasons": reasons}
            return {"ok": False, "decision": "AGUARDA" if score >= 62 else "NÃO ENTRA", "reason": timing_label, "reasons": reasons}

        risk_ok, risk_reason = self.risk.can_enter(s.match_key, s.window, s.minute)
        if not risk_ok:
            return {"ok": False, "decision": "BLOQUEADO", "reason": risk_reason, "reasons": [risk_reason]}

        if score >= 78 and fc >= 3 and not sk and mc_pass and n_trig >= 2 and timing_ok:
            return {"ok": True, "decision": "ENTRA", "reason": "GATE_OK", "reasons": ["SCORE", "MC", "TRIGGERS", timing_label]}
        if score >= 78 and fc >= 3 and mc_pass and n_trig < 2:
            return {"ok": False, "decision": "AGUARDA", "reason": "GATILHOS<2", "reasons": ["GATILHOS<2"]}
        if score >= 70 and mc_prob >= 0.55 and not sk:
            return {"ok": False, "decision": "AGUARDA", "reason": "ZONA_TRANSICAO", "reasons": ["ZONA_TRANSICAO"]}
        if 62 <= score <= 77:
            return {"ok": False, "decision": "AGUARDA", "reason": "SCORE_TRANSICAO", "reasons": ["SCORE_TRANSICAO"]}
        return {"ok": False, "decision": "NÃO ENTRA", "reason": "ABAIXO_LIMIAR", "reasons": ["ABAIXO_LIMIAR"]}


class EnhancedScoreAgent:
    def __init__(self, weights: Dict = None, hist: deque = None):
        self.w = weights or WEIGHTS_V8
        self.hist = hist or deque(maxlen=40)
        self.mc = MonteCarloAgent(CFG.MC_SIMS)
        self.fat = FatigueAgent()
        self.corr = CorrelationAgent()
        self.pat = PatternMatcher()
        self.ctx = ContextAgent()
        self.mom = MomentumAgent(self.hist)
        self.drift = DriftAgent()
        self.conf = ConfidenceAgent()
    def calculate(self, s: MatchState) -> Dict[str, Any]:
        B, K = self.w["bonuses"], self.w["kills"]
        base, tb, tk = 50.0, 0.0, 0.0
        bns, kls = [], []
        m, ap, sd = s.minute, s.dominant_ap, s.score_diff
        lcm, lgm = s.last_corner_minute, s.last_goal_minute

        def _b(cond, key):
            nonlocal tb
            if cond and key in B:
                v = B[key]
                tb += v
                bns.append(f"{key}(+{v})")

        def _k(cond, key):
            nonlocal tk
            if cond and key in K:
                v = K[key]
                tk += v
                kls.append(f"{key}(-{v})")

        _b(43 <= m <= 48 and s.window == "W1", "W1_43-48")
        _b(82 <= m <= 86 and sd <= 1 and s.window == "W2", "W2_82-86")
        _b(m >= 88 and s.window == "W2", "W2_88+")
        _b(lcm is not None and m - lcm <= 4, "SEQUENCIA")
        _b(ap >= 12, "DANGEROUS_DIFF")
        _b(sd <= 1, "PLACAR_APERTADO")
        _b(max(s.possession_home, s.possession_away) >= 55 and max(s.shots_inside_box_home, s.shots_inside_box_away) >= 2, "DOMINIO")
        _b(s.half == 2 and s.subs_offensive_home + s.subs_offensive_away >= 2, "SUBS_OFENSIVAS")

        ms, ml = self.mom.score(s)
        if ms > 0:
            tb += ms
            bns.append(f"{ml}(+{ms})")

        fr = self.fat.calculate(s)
        if fr["adj"] > 0:
            _b(True, "DESESPERO")
        elif fr["adj"] < 0:
            tb += fr["adj"]
            bns.append(f"FADIGA({fr['adj']})")

        if s.weather == "rain":
            _b(True, "CHUVA")
        elif s.weather == "wind":
            tk += 3
            kls.append("VENTO(-3)")
        if s.referee_avg_corners > 10.5:
            _b(True, "ARBITRO")

        # --- Elite v9: Must Win + xC real (sem proxy) + Stop-Live ---
        mw = must_win_level(s)
        if mw == 1:
            _b(True, "MUST_WIN_N1")
        elif mw == 2:
            _b(True, "MUST_WIN_N2")
        xc_proxy = 1.0
        made = getattr(s, "corners_made_avg", None)
        conc = getattr(s, "corners_conceded_opp_avg", None)
        if made is not None and conc is not None:
            xc_proxy = calc_xc(float(made), float(conc), float(getattr(s, "league_avg_corners", 5.0) or 5.0))
            if xc_proxy >= 1.5:
                _b(True, "XC_ALTO")
            elif xc_proxy < 1.0:
                _k(True, "XC_BAIXO")
        stop65 = stop_live_65(s)
        if stop65:
            _k(True, "STOP_LIVE_65")

        # Kills
        if lgm is not None and m - lgm <= 3:
            _k(True, "GOL_SOFRIDO")
        if len(s.graph_standard_trend) >= 2 and s.graph_standard_trend[-1] < s.graph_standard_trend[-2] - 10:
            _k(True, "IP2_FALSO")
        _k(sd >= 2, "PLACAR_ABERTO")
        _k(s.window == "W2" and m > 85 and s.is_draw and max(s.xg_home, s.xg_away) > 0.55, "0-0_POS85")
        _k(s.red_card_home > 0 or s.red_card_away > 0, "RED_CARD")
        _k(lcm is not None and m - lcm >= 15 and s.window != "OUT", "ZONA_MORTA")
        _k(s.var_recent or s.long_stop_recent, "VAR")
        # DOMINIO_ESTERIL (P004): volume ofensivo alto + poucos cantos convertidos
        gap = (m - lcm) if lcm is not None else 99
        few_corners = s.total_corners <= 6 and m >= 80
        no_seq = gap > 4
        if s.dominant_ap >= 20 and few_corners and no_seq:
            _k(True, "DOMINIO_ESTERIL")
        elif s.dominant_ap >= 25 and gap >= 8 and s.window == "W2":
            _k(True, "DOMINIO_ESTERIL")
        # domínio extremo + baixa conversão (cantos totais baixos no final)
        elif s.dominant_ap >= 28 and s.total_corners <= 5 and m >= 84 and s.window == "W2":
            _k(True, "DOMINIO_ESTERIL")

        cs, cn = self.ctx.score(s)
        if cs > 0:
            tb += cs
            for n in cn:
                bns.append(f"{n}(+{int(cs/max(1,len(cn)))})")

        corr_notes, corr_red = self.corr.adjust(bns, self.w)
        # Teto de bônus líquidos (auditoria A1 — evita Score 100 em todo setup)
        cap = getattr(self.corr, "BONUS_CAP", 42.0)
        tb_capped = min(tb, cap)
        if tb > cap:
            corr_notes = list(corr_notes) + [f"CAP:{tb:.0f}->{cap:.0f}"]
        score_raw = base + tb_capped - tk - corr_red
        lo, hi, width = self.conf.interval(score_raw, bns, kls)
        score = min(100, max(0, score_raw))
        confidence = max(0.3, min(1.0, 1.0 - width / 100.0))

        mc = self.mc.simulate(s)
        fc = len(bns)
        sk = tk >= 15
        mc_pass = mc["passes"]

        n_trig, trigs = count_triggers(s, xc_proxy if "xc_proxy" in dir() else 1.0)
        # recalcular xc_proxy se escopo local falhou
        try:
            _xc = xc_proxy
        except NameError:
            _xc = 1.0
            n_trig, trigs = count_triggers(s, _xc)

        # Gate unificado (Timing + Score + MC + gatilhos + kill + stop)
        provisional = {
            "score": score, "fc": fc, "tk": tk, "mc": mc,
            "n_triggers": n_trig, "stop_live_65": stop_live_65(s),
            "kills": kls,
        }
        gate = GateAgent().can_enter(s, provisional)
        dec = gate["decision"]

        sim = self.pat.find(s, 3)
        peak_ok, peak_label = TimingAgent().in_peak(s)
        return {
            "score": round(score, 1), "decision": dec, "bonuses": bns, "kills": kls,
            "fc": fc, "tb": round(tb, 1), "tk": round(tk, 1), "mc": mc, "fatigue": fr,
            "corr_red": round(corr_red, 1), "corr_notes": corr_notes, "similar": sim,
            "conf_lo": lo, "conf_hi": hi, "conf_width": width, "confidence": round(confidence, 2),
            "triggers": trigs, "n_triggers": n_trig, "must_win": must_win_level(s),
            "stop_live_65": stop_live_65(s),
            "goal_alert": goal_alert(s),
            "gate": gate, "timing_peak": peak_ok, "timing_label": peak_label,
        }

class BacktestEngine:
    def __init__(self, cases: List[Dict] = None):
        self.cases = cases or CASES_DB
    def run(self, weights: Dict = None) -> Dict[str, Any]:
        w = weights or WEIGHTS_V8
        results = []
        for c in self.cases:
            if c.get("result") == "PENDENTE":
                continue
            half = 1 if c["minute"] <= 48 else 2
            s = MatchState(
                minute=c["minute"], half=half, added_time=4,
                score_home=c["score_home"], score_away=c["score_away"],
                dangerous_attacks_home=c["ap_home"], dangerous_attacks_away=c["ap_away"],
                possession_home=c.get("possession_dominant", 50),
                possession_away=100 - c.get("possession_dominant", 50),
                xg_home=c.get("xg_dominant", 0.5), xg_away=0.3,
                corners_home=c.get("corners", 5) // 2, corners_away=c.get("corners", 5) - c.get("corners", 5) // 2,
                last_corner_minute=c.get("last_corner"), last_goal_minute=c.get("last_goal"),
                red_card_home=1 if c.get("red_card") and c["ap_home"] >= c["ap_away"] else 0,
                red_card_away=1 if c.get("red_card") and c["ap_away"] > c["ap_home"] else 0,
                weather=c.get("weather", "normal"), referee_avg_corners=c.get("referee_avg", 9.5),
                home_team=c["match"].split()[0], away_team=c["match"].split()[-1],
                shots_inside_box_home=3 if c.get("possession_dominant", 50) >= 55 else 1,
                shots_inside_box_away=1,
            )
            agent = EnhancedScoreAgent(w)
            r = agent.calculate(s)
            actual = c["result"]
            # CORRETO / proteção: AGUARDA ou NÃO ENTRA ambos OK se o esperado era não entrar
            expected_dec = c.get("decision", "AGUARDA")
            correct = (
                (actual == "ACERTO" and r["decision"] == "ENTRA") or
                (actual == "ERRO" and r["decision"] != "ENTRA") or
                (actual == "CORRETO" and r["decision"] in ("AGUARDA", "NÃO ENTRA", "BLOQUEADO")) or
                (actual == "CORRETO" and r["decision"] == expected_dec)
            )
            results.append({
                "id": c["id"], "match": c["match"], "win": c["window"],
                "sim_score": r["score"], "sim_dec": r["decision"], "actual": actual,
                "ok": correct, "mc": r["mc"]["prob"], "conf": r["confidence"],
            })
        total = len(results)
        ok = sum(1 for r in results if r["ok"])
        w1 = [r for r in results if r["win"] == "W1"]
        w2 = [r for r in results if r["win"] == "W2"]
        return {
            "total": total, "ok": ok, "acc": round(ok / max(1, total) * 100, 1),
            "w1_acc": round(sum(1 for r in w1 if r["ok"]) / max(1, len(w1)) * 100, 1),
            "w2_acc": round(sum(1 for r in w2 if r["ok"]) / max(1, len(w2)) * 100, 1),
            "avg_mc": round(sum(r["mc"] for r in results) / max(1, total) * 100, 1),
            "avg_conf": round(sum(r["conf"] for r in results) / max(1, total) * 100, 1),
            "details": results, "ts": datetime.now().isoformat(),
        }

class TrainingPipeline:
    def __init__(self):
        self.bt = BacktestEngine()
        self.ln = LearningAgent()
    def train(self, max_iter: int = 50, target: float = 85.0) -> Dict:
        best_acc, best_w, best_r = 0.0, None, None
        for i in range(max_iter):
            r = self.bt.run(self.ln.w)
            acc = r["acc"]
            if acc > best_acc:
                best_acc, best_w, best_r = acc, json.loads(json.dumps(self.ln.w)), r
            if acc >= target:
                break
            for d in r["details"]:
                if not d["ok"]:
                    c = next((x for x in CASES_DB if x["id"] == d["id"]), None)
                    if c:
                        out = "GREEN" if d["actual"] == "ERRO" else "RED"
                        self.ln.record(c.get("factors", []), c.get("kills", []), out)
        if best_w:
            self.ln.w = best_w
            self.ln._save()
        return {"iters": i + 1, "best_acc": best_acc, "target": target, "hit": best_acc >= target, "report": best_r}

class CornerAIOrchestrator:
    def __init__(self, cfg: Config = CFG):
        self.cfg = cfg
        self.ds = DataSourceAgent(cfg)
        self.nt = NotificationAgent(cfg)
        self.scorer = EnhancedScoreAgent()
        self.risk = RiskManager(cfg.BANKROLL)
        self.quality = DataQualityAgent()
        self.running = False
    def _in_window(self) -> bool:
        now = datetime.now().time()
        return any((s <= e and s <= now <= e) or (s > e and (now >= s or now <= e)) for s, e in self.cfg.JANELAS)
    async def run(self):
        logger.info("CornerAI v8.0 Orchestrator started")
        self.running = True
        try:
            while self.running:
                await asyncio.sleep(self.cfg.CHECK_INT)
        except (KeyboardInterrupt, SystemExit):
            pass
        finally:
            await self.ds.close()
            await self.nt.close()


def cli_backtest():
    r = BacktestEngine().run()
    print(f"\n{'='*60}\nBACKTEST v9 TRADER | {r['ts']}\n{'='*60}")
    print(f"Acc geral: {r['acc']}% ({r['ok']}/{r['total']}) | W1: {r['w1_acc']}% | W2: {r['w2_acc']}%")
    # Assertividade só ENTRA
    entra = [d for d in r["details"] if d["sim_dec"] == "ENTRA"]
    if entra:
        ok_e = sum(1 for d in entra if d["ok"])
        print(f"Assertividade ENTRA only: {ok_e}/{len(entra)} = {100*ok_e/len(entra):.1f}%")
    for d in r["details"]:
        print(f" {'OK' if d['ok'] else 'X '} [{d['id']}] {d['match'][:28]:<28} | Score={d['sim_score']:.0f} -> {d['sim_dec']:<10} | MC={d['mc']:.0%} | {d['actual']}")

def cli_demo():
    print("=" * 60 + "\nCornerAI v9 TRADER — Demo\n" + "=" * 60)
    scorer = EnhancedScoreAgent()
    risk = RiskManager()
    gate = GateAgent(risk=risk)
    demos = [
        dict(m=84, h=2, a=5, sh=1, sa=1, aph=36, apa=49, poh=44, poa=56, xgh=0.43, xga=0.40,
             ch=8, ca=11, lc=83, lg=75, name="Sport x Cuiaba (84')"),
        dict(m=40, h=1, a=3, sh=0, sa=0, aph=25, apa=6, poh=57, poa=43, xgh=0.75, xga=0.36,
             ch=6, ca=1, lc=36, lg=None, name="AGO x Athletic (40')"),
        dict(m=30, h=1, a=2, sh=0, sa=0, aph=18, apa=6, poh=65, poa=35, xgh=0.6, xga=0.3,
             ch=1, ca=0, lc=22, lg=None, name="Palmeiras x SaoPaulo (30') CEDO"),
        dict(m=82, h=2, a=4, sh=3, sa=0, aph=60, apa=15, poh=65, poa=35, xgh=2.5, xga=0.2,
             ch=12, ca=3, lc=78, lg=70, name="Palmeiras x America (82') ABERTO"),
        dict(m=87, h=2, a=4, sh=0, sa=0, aph=51, apa=27, poh=53, poa=47, xgh=0.8, xga=0.3,
             ch=4, ca=1, lc=66, lg=None, name="VJS x PKU (87') SECA"),
    ]
    for d in demos:
        s = MatchState(
            minute=d["m"], half=d["h"], added_time=d["a"], score_home=d["sh"], score_away=d["sa"],
            dangerous_attacks_home=d["aph"], dangerous_attacks_away=d["apa"],
            possession_home=d["poh"], possession_away=d["poa"],
            xg_home=d["xgh"], xg_away=d["xga"], corners_home=d["ch"], corners_away=d["ca"],
            last_corner_minute=d["lc"], last_goal_minute=d["lg"],
            shots_inside_box_home=4, shots_inside_box_away=1,
            home_team=d["name"].split()[0], away_team=d["name"].split()[-1],
        )
        r = scorer.calculate(s)
        g = r.get("gate") or gate.can_enter(s, r)
        dec = g.get("decision", r["decision"])
        stake = risk.calc_stake(r["score"], r["mc"]["prob"], 1.90, r["confidence"]) if dec == "ENTRA" else {"value": 0, "kelly_full": 0}
        print(f"\n>> {d['name']}")
        print(f"   Score: {r['score']}/100 | Decisao: {dec} | MC: {r['mc']['prob']:.0%} | Conf: {r['confidence']:.0%}")
        print(f"   Timing: {r.get('timing_label')} | Gate: {g.get('reason')}")
        print(f"   Gatilhos: {r.get('n_triggers', '?')}/3 {r.get('triggers', [])} | MustWin: N{r.get('must_win', 0)}")
        ga = r.get("goal_alert") or {}
        if ga.get("active"):
            print(f"   GOL-CTX: {ga.get('type')} — {ga.get('msg')}")
        print(f"   Stake: R${stake['value']} | Kelly: {stake.get('kelly_full', 0)}%")

def cli_train():
    print("=" * 60 + "\nCornerAI v9 — Training\n" + "=" * 60)
    r = TrainingPipeline().train(max_iter=30, target=85.0)
    print(f"Iter: {r['iters']} | Best: {r['best_acc']}% | Target: {'YES' if r['hit'] else 'NO'}")
    if r.get("report"):
        b = r["report"]
        print(f"Cases: {b['total']} OK: {b['ok']} W1: {b['w1_acc']}% W2: {b['w2_acc']}%")

def cli_analyze():
    """Uso: python cornerai_v8.py analyze min=84 half=2 sh=1 sa=1 aph=36 apa=49 lc=83 home=Sport away=Cuiaba"""
    args = {}
    for a in sys.argv[2:]:
        if "=" in a:
            k, v = a.split("=", 1)
            args[k.strip()] = v.strip()
    def _i(k, d=0):
        try: return int(args.get(k, d))
        except: return d
    def _f(k, d=0.0):
        try: return float(args.get(k, d))
        except: return d
    s = MatchState(
        minute=_i("min", 84), half=_i("half", 2), added_time=_i("add", 4),
        score_home=_i("sh", 0), score_away=_i("sa", 0),
        dangerous_attacks_home=_i("aph", 20), dangerous_attacks_away=_i("apa", 15),
        possession_home=_f("poh", 55), possession_away=_f("poa", 45),
        xg_home=_f("xgh", 0.5), xg_away=_f("xga", 0.4),
        corners_home=_i("ch", 4), corners_away=_i("ca", 3),
        last_corner_minute=_i("lc", 0) or None,
        last_goal_minute=_i("lg", 0) or None,
        shots_inside_box_home=_i("sibh", 3), shots_inside_box_away=_i("siba", 1),
        home_team=args.get("home", "Home"), away_team=args.get("away", "Away"),
        competition=args.get("comp", ""),
    )
    r = EnhancedScoreAgent().calculate(s)
    g = r.get("gate") or GateAgent().can_enter(s, r)
    print("=" * 60)
    print(f"ANALYZE | {s.home_team} x {s.away_team} | {s.minute}' | {s.score_home}x{s.score_away}")
    print(f"Score={r['score']} | Decisao={g.get('decision')} | Gate={g.get('reason')} | Timing={r.get('timing_label')}")
    print(f"MC={r['mc'].get('prob', 0):.0%} | Gatilhos={r.get('n_triggers')}/3 {r.get('triggers')}")
    print(f"Bonus={r.get('bonuses')}")
    print(f"Kills={r.get('kills')}")
    # auto log
    block = build_reg_log(s, {**r, "decision": g.get("decision")}, request_type="ANALISE_LIVE",
                         user_request="cli analyze")
    path = append_reg_log(block, "/home/workdir/artifacts/CornerAI_Log_Analises_Entradas.md")
    print(f"REG gravado -> {path}")

def cli_log():
    """Mostra últimos registros do log."""
    path = Path("/home/workdir/artifacts/CornerAI_Log_Analises_Entradas.md")
    if not path.exists():
        print("Log vazio")
        return
    lines = path.read_text(encoding="utf-8").splitlines()
    regs = [i for i, ln in enumerate(lines) if ln.startswith("### REG-")]
    print(f"Total REGs: {len(regs)}")
    for i in regs[-5:]:
        print("\n".join(lines[i:i+12]))
        print("---")

def cli_settle():
    """Uso: python cornerai_v8.py settle REG-20260806-002 actual_min=44 result=ACERTO corners_h=5 corners_a=3 note=texto"""
    args = {}
    for a in sys.argv[2:]:
        if "=" in a:
            k, v = a.split("=", 1)
            args[k.strip()] = v.strip()
    rid = args.get("id") or (sys.argv[2] if len(sys.argv) > 2 and not sys.argv[2].startswith("id=") and "=" not in sys.argv[2] else None)
    if not rid:
        print("Uso: settle id=REG-... actual_min=44 result=ACERTO|ERRO corners_h=N corners_a=N note=...")
        return
    path = Path("/home/workdir/artifacts/CornerAI_Log_Analises_Entradas.md")
    text = path.read_text(encoding="utf-8") if path.exists() else ""
    settle_block = f"""
#### POS_JOGO ({rid})
- Minuto real canto: {args.get('actual_min', 'N/D')}
- Acerto/Erro: {args.get('result', 'N/D')}
- Cantos finais Casa | Visitante: {args.get('corners_h', '?')} | {args.get('corners_a', '?')}
- Nota: {args.get('note', '')}
- Settled at: {datetime.now().isoformat()}
"""
    path.write_text(text + "\n" + settle_block, encoding="utf-8")
    print(f"POS_JOGO gravado para {rid}")

def cli_report():
    """Assertividade focada em decisões ENTRA (backtest)."""
    r = BacktestEngine().run()
    entra = [d for d in r["details"] if d["sim_dec"] == "ENTRA"]
    aguarda = [d for d in r["details"] if d["sim_dec"] == "AGUARDA"]
    nao = [d for d in r["details"] if d["sim_dec"] == "NÃO ENTRA"]
    print("=" * 60)
    print("RELATORIO ASSERTIVIDADE TRADER (só decisões do motor)")
    print("=" * 60)
    print(f"Geral: {r['acc']}% ({r['ok']}/{r['total']})")
    if entra:
        ok = sum(1 for d in entra if d["ok"])
        print(f"ENTRA: {ok}/{len(entra)} = {100*ok/len(entra):.1f}%  << metrica principal do trader")
        for d in entra:
            print(f"  {'OK' if d['ok'] else 'FP'} {d['id']} {d['match'][:24]} score={d['sim_score']:.0f} actual={d['actual']}")
    else:
        print("ENTRA: nenhuma no backtest")
    print(f"AGUARDA: {len(aguarda)} | NÃO ENTRA: {len(nao)}")
    print("Meta realista: 80-83% nas ENTRAs com mais POS_JOGO.")

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "train":
        cli_train()
    elif cmd == "backtest":
        cli_backtest()
    elif cmd == "demo":
        cli_demo()
    elif cmd == "analyze":
        cli_analyze()
    elif cmd == "log":
        cli_log()
    elif cmd == "settle":
        cli_settle()
    elif cmd == "report":
        cli_report()
    elif cmd == "run":
        asyncio.run(CornerAIOrchestrator().run())
    else:
        print("CornerAI v9 TRADER | analyze | log | settle | report | train | backtest | demo | run")
        cli_demo()
        print()
        cli_report()
