        "xg_away": 0.36,
        "corners_home": 6,
        "corners_away": 1,
        "last_corner_minute": 36,
        "last_corner_team": "home",
        "last_goal_minute": None,
        "last_goal_team": None,
        "var_recent": False,
        "long_stop_recent": False,
        "red_card_home": 0,
        "red_card_away": 0,
        "subs_offensive_home": 0,
        "subs_offensive_away": 0,
        "graph_standard_trend": [20, 35, 50, 60, 55, 50, 45, 40],
        "graph_accumulated_home": 60,
        "graph_accumulated_away": 20,
        "home_team": "Atlético-GO",
        "away_team": "Athletic Club",
        "competition": "Brasileirão Série B",
    }

    res2 = trader.analyze(state2, odds=1.85)
    print("\n" + "=" * 62)
    print("ANÁLISE 2 — ATLÉTICO-GO x ATHLETIC (40') — Cluster W1")
    print("=" * 62)
    print(json.dumps(res2, indent=2, ensure_ascii=False))

    # ------------------------------------------------------------------
    # Cenário 3: Juventude x Atlético-MG (PARTIDA 005) — 89' 0-0
    # Teste do kill zone de risco de gol
    # ------------------------------------------------------------------
    state3 = {
        "minute": 89,
        "half": 2,
        "added_time": 4,
        "score_home": 0,
        "score_away": 0,
        "attacks_home": 53,
        "attacks_away": 91,
        "dangerous_attacks_home": 37,
        "dangerous_attacks_away": 39,
        "shots_on_target_home": 3,
        "shots_on_target_away": 2,
        "shots_inside_box_home": 6,
        "shots_inside_box_away": 8,
        "possession_home": 40.0,
        "possession_away": 60.0,
        "xg_home": 0.42,
        "xg_away": 0.67,
        "corners_home": 4,
        "corners_away": 5,
        "last_corner_minute": 78,
        "last_corner_team": "away",
        "last_goal_minute": None,
        "last_goal_team": None,
        "var_recent": False,
        "long_stop_recent": False,
        "red_card_home": 0,
        "red_card_away": 0,
        "subs_offensive_home": 2,
        "subs_offensive_away": 3,
        "graph_standard_trend": [30, 35, 40, 45, 50, 55, 58, 60],
        "graph_accumulated_home": 39,
        "graph_accumulated_away": 61,
        "home_team": "Juventude",
        "away_team": "Atlético-MG",
        "competition": "Copa do Brasil",
    }

    res3 = trader.analyze(state3, odds=1.80)
    print("\n" + "=" * 62)
    print("ANÁLISE 3 — JUVENTUDE x ATLÉTICO-MG (89') — Teste kill zone PARTIDA 005")
    print("=" * 62)
    print(json.dumps(res3, indent=2, ensure_ascii=False))

    # Feedback simulado
    if res1.get("trade_id"):
        trader.feedback_trade(res1["trade_id"], 87, "GREEN")
    if res2.get("trade_id"):
        trader.feedback_trade(res2["trade_id"], 43, "GREEN")
    if res3.get("trade_id"):
        # Neste caso real saiu gol → deveria ter sido AGUARDA ou NÃO ENTRA
        trader.feedback_trade(res3["trade_id"], 90, "RED")

    print("\n" + trader.generate_report())
    trader.learn_agent.export_model("/home/workdir/artifacts/cornerai_weights_v5.1.json")


if __name__ == "__main__":
    demo()
