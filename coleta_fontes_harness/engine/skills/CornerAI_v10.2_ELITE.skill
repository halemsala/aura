#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
================================================================================
CORNERAI PRO MAX — SISTEMA MULTI-AGENTE DE TRADING DE ESCANTEIOS v6.0
================================================================================
Autor: CornerAI Project (Engenharia Máxima)
Data:  2026-08-05
Atualização: PARTIDA 007 (cartão vermelho) + PARTIDA 008 (seca prolongada) incorporadas

JANELAS OFICIAIS:
  • W1: 30' do 1º tempo até o intervalo (45 + acréscimos)
  • W2: 80' do 2º tempo até o final (90 + acréscimos)

AGENTES (14 total):
  1. DataAgent        — Coleta e validação de dados ao vivo
  2. DataQualityAgent — Validação rigorosa de consistência e drift
  3. MarketAgent      — Monitoramento de odds, liquidez e linhas
  4. PatternAgent     — Detecção de clusters, ondas e sequências
  5. ContextAgent     — Dados históricos do confronto e competição
  6. MomentumAgent    — Cálculo de momentum de pressão (derivada)
  7. VolumetryAgent   — Volume esperado vs realizado de escanteios
  8. ScoreAgent       — Score CornerAI ponderado (0-100)
  9. RiskAgent        — Stop loss, trailing stop, exposição máxima
 10. DecisionAgent    — Matriz de decisão hierárquica
 11. MultiEntryAgent  — Gestão de múltiplas entradas por janela
 12. ExecutionAgent   — Kelly Criterion, registro e execução
 13. AlertAgent       — Alertas em tempo real
 14. LearningAgent    — Ajuste de pesos via reforço
================================================================================
"""

import json
import logging
import random
import math
from dataclasses import dataclass, field, asdict
from datetime import datetime
from enum import Enum
from typing import List, Dict, Optional, Tuple, Deque
from collections import deque, defaultdict

# ==============================================================================
# CONFIGURAÇÕES GLOBAIS
# ==============================================================================
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)-8s | %(name)-28s | %(message)s",
    datefmt="%H:%M:%S"
)
logger = logging.getLogger("CornerAI")


class Decision(Enum):
    ENTRA = "ENTRA"
    AGUARDA = "AGUARDA"
    NAO_ENTRA = "NÃO ENTRA"


class Window(Enum):
    W1 = "W1_30_45+"
    W2 = "W2_80_90+"
    OUT = "FORA_DAS_JANELAS"


class AlertLevel(Enum):
    INFO = "INFO"
    WARNING = "WARNING"
    CRITICAL = "CRITICAL"


# ==============================================================================
# ESTRUTURAS DE DADOS
# ==============================================================================

@dataclass
class MatchState:
    minute: int
    half: int
    added_time: int
    score_home: int
    score_away: int
    attacks_home: int
    attacks_away: int
    dangerous_attacks_home: int
    dangerous_attacks_away: int
    shots_on_target_home: int
    shots_on_target_away: int
    shots_inside_box_home: int
    shots_inside_box_away: int
    possession_home: float
    possession_away: float
    xg_home: float
    xg_away: float
    corners_home: int
    corners_away: int
    last_corner_minute: Optional[int] = None
    last_corner_team: Optional[str] = None
    last_goal_minute: Optional[int] = None
    last_goal_team: Optional[str] = None
    var_recent: bool = False
    long_stop_recent: bool = False
    red_card_home: int = 0
    red_card_away: int = 0
    subs_offensive_home: int = 0
    subs_offensive_away: int = 0
    graph_standard_trend: List[float] = field(default_factory=list)
    graph_accumulated_home: int = 0
    graph_accumulated_away: int = 0
    home_team: str = ""
    away_team: str = ""
    competition: str = ""
    odds_over: float = 1.85
    odds_under: float = 1.95
    liquidity: float = 0.0

    @property
    def total_corners(self) -> int:
        return self.corners_home + self.corners_away

    @property
    def score_diff(self) -> int:
        return abs(self.score_home - self.score_away)

    @property
    def is_draw(self) -> bool:
        return self.score_home == self.score_away

    @property
    def dangerous_diff_home(self) -> int:
        return self.dangerous_attacks_home - self.dangerous_attacks_away

    @property
    def dangerous_diff_away(self) -> int:
        return self.dangerous_attacks_away - self.dangerous_attacks_home

    @property
    def window(self) -> Window:
        if self.half == 1 and 30 <= self.minute <= 45 + self.added_time:
            return Window.W1
        if self.half == 2 and 80 <= self.minute <= 90 + self.added_time:
            return Window.W2
        return Window.OUT


@dataclass
class Trade:
    id: str
    timestamp: str
    window: Window
    decision: Decision
    minute_predicted: int
    minute_real: Optional[int]
    result: Optional[str]
    stake: float
    odds: float
    profit: float = 0.0
    notes: str = ""
    entry_count: int = 1


@dataclass
class Alert:
    level: AlertLevel
    message: str
    timestamp: str
    minute: int


@dataclass
class HistoricalContext:
    avg_corners_home: float = 0.0
    avg_corners_away: float = 0.0
    avg_corners_match: float = 0.0
    h2h_avg_corners: float = 0.0
    league_avg_w1: float = 0.0
    league_avg_w2: float = 0.0
    home_w1_rate: float = 0.0
    away_w2_rate: float = 0.0


# ==============================================================================
# 1. DATA AGENT
# ==============================================================================

class DataAgent:
    def __init__(self):
        self.history: Deque[MatchState] = deque(maxlen=30)
        self.logger = logging.getLogger("CornerAI.DataAgent")

    def ingest(self, raw: dict) -> MatchState:
        state = MatchState(**raw)
        self.history.append(state)
        self.logger.info(f"[INGEST] {state.home_team} x {state.away_team} | "
                         f"{state.minute}' {state.half}T | {state.score_home}-{state.score_away}")
        return state

    def compute_appm(self, team: str = "home", window_min: int = 5) -> float:
        if len(self.history) < 2:
            return 0.0
        recent = [s for s in self.history if s.half == self.history[-1].half]
        if len(recent) < 2:
            return 0.0
        delta_da = (recent[-1].dangerous_attacks_home - recent[0].dangerous_attacks_home) \
            if team == "home" else \
            (recent[-1].dangerous_attacks_away - recent[0].dangerous_attacks_away)
        delta_t = max(1, recent[-1].minute - recent[0].minute)
        return round(delta_da / delta_t, 2)

    def is_sequence(self, state: MatchState, max_gap: int = 4) -> bool:
        if state.last_corner_minute is None:
            return False
        return (state.minute - state.last_corner_minute) <= max_gap

    def recent_goals(self, minutes: int = 3) -> Tuple[Optional[int], Optional[str]]:
        if not self.history:
            return None, None
        last = self.history[-1]
        if last.last_goal_minute and (last.minute - last.last_goal_minute) <= minutes:
            return last.last_goal_minute, last.last_goal_team
        return None, None


# ==============================================================================
# 2. DATA QUALITY AGENT
# ==============================================================================

class DataQualityAgent:
    """Valida consistência dos dados e detecta drift anômalo."""

    def __init__(self, data_agent: DataAgent):
        self.data = data_agent
        self.logger = logging.getLogger("CornerAI.DataQualityAgent")
        self.issues: List[str] = []

    def validate(self, state: MatchState) -> Tuple[bool, List[str]]:
        issues = []
        # D1: Posse deve somar ~100
        if not 95 <= state.possession_home + state.possession_away <= 105:
            issues.append("POSSE_INCONSISTENTE")
        # D2: Ataques perigosos não podem diminuir
        if len(self.data.history) >= 2:
            prev = self.data.history[-2]
            if state.dangerous_attacks_home < prev.dangerous_attacks_home:
                issues.append("DA_HOME_DECRESCENTE")
            if state.dangerous_attacks_away < prev.dangerous_attacks_away:
                issues.append("DA_AWAY_DECRESCENTE")
        # D3: Escanteios não podem diminuir
        if len(self.data.history) >= 2:
            prev = self.data.history[-2]
            if state.corners_home < prev.corners_home:
                issues.append("CANTOS_HOME_DECRESCENTE")
            if state.corners_away < prev.corners_away:
                issues.append("CANTOS_AWAY_DECRESCENTE")
        # D4: Minuto deve avançar
        if len(self.data.history) >= 2:
            prev = self.data.history[-2]
            if state.minute < prev.minute and state.half == prev.half:
                issues.append("RELOGIO_REGRESSIVO")
        # D5: xG não pode diminuir
        if len(self.data.history) >= 2:
            prev = self.data.history[-2]
            if state.xg_home < prev.xg_home - 0.01:
                issues.append("xG_HOME_DECRESCENTE")
            if state.xg_away < prev.xg_away - 0.01:
                issues.append("xG_AWAY_DECRESCENTE")
        valid = len(issues) == 0
        if not valid:
            self.logger.warning(f"[QUALITY] Issues: {issues}")
        self.issues = issues
        return valid, issues


# ==============================================================================
# 3. MARKET AGENT
# ==============================================================================

class MarketAgent:
    """Monitora odds, liquidez e movimentação de linhas em tempo real."""

    def __init__(self):
        self.odds_history: Deque[Tuple[int, float, float]] = deque(maxlen=20)
        self.logger = logging.getLogger("CornerAI.MarketAgent")

    def update(self, state: MatchState):
        self.odds_history.append((state.minute, state.odds_over, state.odds_under))

    def odds_drift(self) -> Tuple[float, float]:
        """Retorna drift das odds over e under (negativo = subiu)."""
        if len(self.odds_history) < 2:
            return 0.0, 0.0
        first = self.odds_history[0]
        last = self.odds_history[-1]
        return round(last[1] - first[1], 3), round(last[2] - first[2], 3)

    def is_liquid(self, threshold: float = 500.0) -> bool:
        if not self.odds_history:
            return False
        # Simulação: liquidez mínima para execução
        return self.odds_history[-1][1] > 0  # placeholder para lógica real

    def market_sentiment(self) -> str:
        """Analisa se o mercado está pressionando over ou under."""
        if len(self.odds_history) < 3:
            return "NEUTRO"
        over_drift, under_drift = self.odds_drift()
        if over_drift < -0.10 and under_drift > 0.10:
            return "OVER_PRESSAO"
        if over_drift > 0.10 and under_drift < -0.10:
            return "UNDER_PRESSAO"
        return "NEUTRO"

    def edge_vs_market(self, state: MatchState, score: int) -> float:
        """Calcula edge do modelo vs odds implícitas do mercado."""
        prob_model = 0.50 + (score - 75) * 0.01
        prob_market = 1 / state.odds_over
        return round(prob_model - prob_market, 3)


# ==============================================================================
# 4. PATTERN AGENT
# ==============================================================================

class PatternAgent:
    """Detecta clusters, ondas de pressão e padrões sequenciais."""

    def __init__(self, data_agent: DataAgent):
        self.data = data_agent
        self.logger = logging.getLogger("CornerAI.PatternAgent")

    def detect_cluster(self, state: MatchState) -> Tuple[bool, int, str]:
        """Detecta cluster de escanteios nos últimos 10 minutos."""
        if len(self.data.history) < 3:
            return False, 0, ""
        recent = [s for s in self.data.history if state.minute - s.minute <= 10]
        corners_in_cluster = sum(1 for s in recent if s.last_corner_minute and 
                                  state.minute - s.last_corner_minute <= 10)
        if corners_in_cluster >= 3:
            return True, corners_in_cluster, f"CLUSTER_{corners_in_cluster}_CANTOS_10MIN"
        return False, 0, ""

    def detect_wave(self, state: MatchState) -> Tuple[bool, str]:
        """Detecta onda de pressão sustentada (3+ amostras crescentes)."""
        if len(state.graph_standard_trend) < 4:
            return False, ""
        trend = state.graph_standard_trend[-4:]
        ascents = sum(1 for i in range(1, len(trend)) if trend[i] > trend[i-1])
        if ascents >= 3:
            return True, "ONDA_PRESSAO_CRESCENTE"
        return False, ""

    def detect_dead_zone(self, state: MatchState) -> bool:
        """Detecta zona morta: sem cantos há 8+ minutos na janela ativa."""
        if state.last_corner_minute is None:
            return True
        gap = state.minute - state.last_corner_minute
        if state.window != Window.OUT and gap >= 8:
            return True
        return False

    def pressure_index(self, state: MatchState) -> float:
        """Índice de pressão composto (0-100)."""
        da_total = state.dangerous_attacks_home + state.dangerous_attacks_away
        shots_total = state.shots_on_target_home + state.shots_on_target_away
        xg_total = state.xg_home + state.xg_away
        # Normalização heurística
        pi = min(100, (da_total / 2) + (shots_total * 3) + (xg_total * 10))
        return round(pi, 1)


# ==============================================================================
# 5. CONTEXT AGENT
# ==============================================================================

class ContextAgent:
    """Dados históricos do confronto, times e competição."""

    def __init__(self):
        self.cache: Dict[str, HistoricalContext] = {}
        self.logger = logging.getLogger("CornerAI.ContextAgent")

    def load_context(self, home: str, away: str, competition: str) -> HistoricalContext:
        key = f"{home}_{away}_{competition}"
        if key in self.cache:
            return self.cache[key]
        # Dados simulados — em produção virariam de API/banco
        ctx = HistoricalContext(
            avg_corners_home=5.2,
            avg_corners_away=4.1,
            avg_corners_match=9.3,
            h2h_avg_corners=10.5,
            league_avg_w1=1.8,
            league_avg_w2=2.1,
            home_w1_rate=0.72,
            away_w2_rate=0.68
        )
        self.cache[key] = ctx
        return ctx

    def context_score(self, state: MatchState) -> Tuple[float, List[str]]:
        ctx = self.load_context(state.home_team, state.away_team, state.competition)
        score = 0.0
        notes = []
        # C1: Média H2H acima da liga
        if ctx.h2h_avg_corners > ctx.league_avg_w1 + ctx.league_avg_w2:
            score += 8
            notes.append("H2H_ACIMA_MEDIA")
        # C2: Time da casa forte em W1
        if ctx.home_w1_rate > 0.70:
            score += 6
            notes.append("HOME_FORTE_W1")
        # C3: Time visitante forte em W2
        if ctx.away_w2_rate > 0.65:
            score += 5
            notes.append("AWAY_FORTE_W2")
        # C4: Média de cantos da partida acima de 9
        if ctx.avg_corners_match > 9.0:
            score += 4
            notes.append("ALTA_MEDIA_CANTOS")
        return score, notes


# ==============================================================================
# 6. MOMENTUM AGENT
# ==============================================================================

class MomentumAgent:
    """Calcula momentum de pressão (derivada segunda dos ataques perigosos)."""

    def __init__(self, data_agent: DataAgent):
        self.data = data_agent
        self.logger = logging.getLogger("CornerAI.MomentumAgent")

    def momentum(self, state: MatchState, team: str = "home") -> float:
        if len(self.data.history) < 3:
            return 0.0
        recent = list(self.data.history)[-3:]
        da_vals = [s.dangerous_attacks_home if team == "home" else s.dangerous_attacks_away 
                   for s in recent]
        minutes = [s.minute for s in recent]
        # Derivada aproximada: delta_DA / delta_min
        if len(da_vals) < 2 or len(minutes) < 2:
            return 0.0
        deltas = []
        for i in range(1, len(da_vals)):
            dt = max(1, minutes[i] - minutes[i-1])
            deltas.append((da_vals[i] - da_vals[i-1]) / dt)
        if not deltas:
            return 0.0
        # Momentum = média das derivadas recentes
        return round(sum(deltas) / len(deltas), 2)

    def momentum_score(self, state: MatchState) -> Tuple[float, str]:
        mom_h = self.momentum(state, "home")
        mom_a = self.momentum(state, "away")
        max_mom = max(mom_h, mom_a)
        if max_mom >= 2.5:
            return 12, f"MOMENTUM_ALTO_{max_mom}"
        elif max_mom >= 1.5:
            return 7, f"MOMENTUM_MEDIO_{max_mom}"
        return 0, ""


# ==============================================================================
# 7. VOLUMETRY AGENT
# ==============================================================================

class VolumetryAgent:
    """Compara volume de escanteios esperado vs realizado."""

    def __init__(self, data_agent: DataAgent):
        self.data = data_agent
        self.logger = logging.getLogger("CornerAI.VolumetryAgent")

    def expected_corners(self, state: MatchState) -> float:
        """Cantos esperados baseado em xG e finalizações."""
        xg_factor = (state.xg_home + state.xg_away) * 2.5
        shots_factor = (state.shots_on_target_home + state.shots_on_target_away) * 0.3
        return round(xg_factor + shots_factor, 1)

    def volume_delta(self, state: MatchState) -> Tuple[float, str]:
        expected = self.expected_corners(state)
        actual = state.total_corners
        delta = actual - expected
        if delta >= 3:
            return 8, f"VOLUME_ACIMA_{delta}"
        elif delta <= -3:
            return -8, f"VOLUME_ABAIXO_{delta}"
        return 0, ""

    def w1_w2_efficiency(self, state: MatchState) -> float:
        """Eficiência de cantos na janela atual."""
        if state.window == Window.OUT:
            return 0.0
        # Razão entre cantos e ataques perigosos na janela
        da_total = state.dangerous_attacks_home + state.dangerous_attacks_away
        if da_total == 0:
            return 0.0
        return round(state.total_corners / da_total * 100, 2)


# ==============================================================================
# 8. SCORE AGENT v6.0
# ==============================================================================

class ScoreAgent:
    def __init__(self, data_agent: DataAgent, pattern_agent: PatternAgent,
                 context_agent: ContextAgent, momentum_agent: MomentumAgent,
                 volumetry_agent: VolumetryAgent, market_agent: MarketAgent):
        self.data = data_agent
        self.pattern = pattern_agent
        self.context = context_agent
        self.momentum = momentum_agent
        self.volumetry = volumetry_agent
        self.market = market_agent
        self.logger = logging.getLogger("CornerAI.ScoreAgent")

    def calculate(self, state: MatchState) -> Tuple[int, List[str], List[str], float]:
        score = 50
        bonuses = []
        kills = []

        # --- BÔNUS ---
        # B1: W1 43-48'
        if state.window == Window.W1 and 43 <= state.minute <= 48:
            score += 15; bonuses.append("W1_43-48 (+15)")

        # B2: W2 82-86' apertado + IP alto
        if state.window == Window.W2 and 82 <= state.minute <= 86:
            if state.score_diff <= 1:
                appm = self.data.compute_appm("home") + self.data.compute_appm("away")
                if appm >= 1.0:
                    score += 18; bonuses.append("W2_82-86_apertado_IPalto (+18)")

        # B3: W2 88+'
        if state.window == Window.W2 and state.minute >= 88:
            score += 22; bonuses.append("W2_88+_residual (+22)")

        # B4: Sequência
        if self.data.is_sequence(state):
            score += 10; bonuses.append("SEQUENCIA_<=4min (+10)")

        # B5: Dangerous diff >= 12
        if max(state.dangerous_diff_home, state.dangerous_diff_away) >= 12:
            score += 10; bonuses.append("DANGEROUS_DIFF_>12 (+10)")

        # B6: Placar apertado
        if state.score_diff <= 1:
            score += 7; bonuses.append("PLACAR_APERTADO (+7)")

        # B7: Domínio posse + finalizações
        dom_p = max(state.possession_home, state.possession_away)
        dom_s = max(state.shots_inside_box_home, state.shots_inside_box_away)
        if dom_p > 55 and dom_s >= 3:
            score += 6; bonuses.append("DOMINIO_POSSE_FINALIZACAO_AREA (+6)")

        # B8: Subs ofensivas
        if state.half == 2 and (state.subs_offensive_home + state.subs_offensive_away) >= 2:
            score += 5; bonuses.append("SUBS_OFENSIVAS_2T (+5)")

        # B9: Cluster de cantos
        has_cluster, count, label = self.pattern.detect_cluster(state)
        if has_cluster:
            score += 12; bonuses.append(f"CLUSTER_{count}_CANTOS (+12)")

        # B10: Onda de pressão
        has_wave, wave_label = self.pattern.detect_wave(state)
        if has_wave:
            score += 9; bonuses.append(f"{wave_label} (+9)")

        # B11: Contexto histórico
        ctx_score, ctx_notes = self.context.context_score(state)
        if ctx_score > 0:
            score += int(ctx_score)
            bonuses.extend([f"{n} (+{int(ctx_score/len(ctx_notes))})" for n in ctx_notes])

        # B12: Momentum
        mom_score, mom_label = self.momentum.momentum_score(state)
        if mom_score > 0:
            score += mom_score; bonuses.append(f"{mom_label} (+{mom_score})")

        # B13: Volume
        vol_score, vol_label = self.volumetry.volume_delta(state)
        if vol_score > 0:
            score += vol_score; bonuses.append(f"{vol_label} (+{vol_score})")

        # B14: Edge vs mercado
        edge = self.market.edge_vs_market(state, score)
        if edge > 0.05:
            score += 5; bonuses.append(f"EDGE_MERCADO_{edge} (+5)")

        # --- KILL ZONES ---
        _, goal_team = self.data.recent_goals(3)
        if goal_team:
            score -= 20; kills.append("GOL_SOFRIDO_ULT_3min (-20)")
            score -= 14; kills.append("GOL_MARCADO_ULT_3min (-14)")

        if len(state.graph_standard_trend) >= 2:
            if state.graph_standard_trend[-1] < state.graph_standard_trend[-2] - 10:
                score -= 16; kills.append("IP2_FALSO_PICO (-16)")

        if state.score_diff >= 2:
            score -= 15; kills.append("PLACAR_ABERTO_>2 (-15)")

        appm_5 = self.data.compute_appm("home", 5) + self.data.compute_appm("away", 5)
        if appm_5 < 0.3:
            score -= 10; kills.append("APPM_BAIXO_ULT_8min (-10)")

        if state.var_recent or state.long_stop_recent:
            score -= 12; kills.append("VAR_PARALISACAO (-12)")

        if state.window == Window.W2 and state.minute > 85 and state.is_draw:
            if max(state.xg_home, state.xg_away) > 0.6:
                score -= 7; kills.append("0-0_POS85_xG_ALTO_risco_gol (-7)")

        if state.red_card_home > 0 or state.red_card_away > 0:
            score -= 10; kills.append("CARTAO_VERMELHO (-10)")

        # K9: Zona morta
        if self.pattern.detect_dead_zone(state):
            score -= 12; kills.append("ZONA_MORTA_8MIN_SEM_CANTO (-12)")
        # PARTIDA 008: seca prolongada >=15-20 min — redutor mais forte
        if state.last_corner_minute is not None:
            gap = state.minute - state.last_corner_minute
            if gap >= 15:
                score -= 8; kills.append(f"SECA_PROLONGADA_{gap}MIN (-8)")

        # K10: Volume abaixo
        vol_score_neg, vol_label_neg = self.volumetry.volume_delta(state)
        if vol_score_neg < 0:
            score += vol_score_neg; kills.append(f"{vol_label_neg} ({vol_score_neg})")

        # K11: Mercado contra
        sentiment = self.market.market_sentiment()
        if sentiment == "UNDER_PRESSAO":
            score -= 8; kills.append("MERCADO_PRESSAO_UNDER (-8)")

        score = max(0, min(100, score))
        self.logger.info(f"[SCORE] {score}/100 | Bônus:{len(bonuses)} | Kills:{len(kills)}")
        return score, bonuses, kills, edge


# ==============================================================================
# 9. RISK AGENT
# ==============================================================================

class RiskAgent:
    """Gestão de risco dinâmica: exposição, stop loss, trailing stop."""

    def __init__(self, bankroll: float = 1000.0):
        self.bankroll = bankroll
        self.max_exposure_pct = 0.15
        self.max_trade_pct = 0.05
        self.daily_loss_limit = 0.10
        self.daily_loss = 0.0
        self.logger = logging.getLogger("CornerAI.RiskAgent")

    def can_trade(self, stake: float, open_exposure: float) -> Tuple[bool, str]:
        if stake > self.bankroll * self.max_trade_pct:
            return False, f"STAKE_EXCEDE_MAX_{self.max_trade_pct*100}%"
        if open_exposure + stake > self.bankroll * self.max_exposure_pct:
            return False, f"EXPOSICAO_EXCEDE_{self.max_exposure_pct*100}%"
        if self.daily_loss >= self.bankroll * self.daily_loss_limit:
            return False, "LIMITE_DIARIO_PERDA_ATINGIDO"
        return True, "OK"

    def update_daily_loss(self, profit: float):
        if profit < 0:
            self.daily_loss += abs(profit)
        else:
            self.daily_loss = max(0, self.daily_loss - profit * 0.5)

    def reset_daily(self):
        self.daily_loss = 0.0


# ==============================================================================
# 10. MULTI ENTRY AGENT
# ==============================================================================

class MultiEntryAgent:
    """Gerencia múltiplas entradas na mesma janela com regras de scaling."""

    def __init__(self):
        self.entries: Dict[str, List[Trade]] = defaultdict(list)
        self.max_entries_per_window = 2
        self.logger = logging.getLogger("CornerAI.MultiEntryAgent")

    def can_enter(self, match_key: str, window: Window) -> bool:
        key = f"{match_key}_{window.value}"
        return len(self.entries[key]) < self.max_entries_per_window

    def register_entry(self, match_key: str, window: Window, trade: Trade):
        key = f"{match_key}_{window.value}"
        self.entries[key].append(trade)

    def get_entry_count(self, match_key: str, window: Window) -> int:
        key = f"{match_key}_{window.value}"
        return len(self.entries[key])

    def should_scale_in(self, state: MatchState, score: int, entry_count: int) -> bool:
        if entry_count >= self.max_entries_per_window:
            return False
        if entry_count == 1 and score >= 85:
            return True
        return False


# ==============================================================================
# 11. ALERT AGENT
# ==============================================================================

class AlertAgent:
    """Emite alertas em tempo real baseado em thresholds."""

    def __init__(self):
        self.alerts: List[Alert] = []
        self.logger = logging.getLogger("CornerAI.AlertAgent")

    def emit(self, level: AlertLevel, message: str, minute: int):
        alert = Alert(level=level, message=message, timestamp=datetime.now().isoformat(), minute=minute)
        self.alerts.append(alert)
        self.logger.info(f"[ALERT {level.value}] {message}")

    def check_thresholds(self, state: MatchState, score: int, decision: Decision):
        if score >= 80 and decision == Decision.AGUARDA:
            self.emit(AlertLevel.WARNING, f"Score {score} alto mas decisão AGUARDA — verificar kills", state.minute)
        if state.score_diff >= 2 and state.window != Window.OUT:
            self.emit(AlertLevel.INFO, f"Placar aberto {state.score_diff} gols — cautela", state.minute)
        if state.minute >= 88 and state.is_draw and state.total_corners < 3:
            self.emit(AlertLevel.CRITICAL, "0-0 pós-88' com poucos cantos — risco máximo", state.minute)


# ==============================================================================
# 12. DECISION AGENT v6.0
# ==============================================================================

class DecisionAgent:
    def __init__(self, score_agent: ScoreAgent, data_agent: DataAgent,
                 pattern_agent: PatternAgent, multi_entry: MultiEntryAgent,
                 risk_agent: RiskAgent, alert_agent: AlertAgent):
        self.score_agent = score_agent
        self.data = data_agent
        self.pattern = pattern_agent
        self.multi = multi_entry
        self.risk = risk_agent
        self.alert = alert_agent
        self.logger = logging.getLogger("CornerAI.DecisionAgent")

    def decide(self, state: MatchState, match_key: str, open_exposure: float = 0.0
               ) -> Tuple[Decision, int, Optional[int], str, float, List[str], List[str]]:
        score, bonuses, kills, edge = self.score_agent.calculate(state)
        self.alert.check_thresholds(state, score, Decision.AGUARDA)

        if state.window == Window.OUT:
            return Decision.NAO_ENTRA, score, None, "Fora das janelas.", edge, bonuses, kills

        positive_factors = len(bonuses)
        has_strong_kill = any(k.startswith(("GOL_SOFRIDO", "PLACAR_ABERTO", "VAR_PARALISACAO",
                                            "CARTAO_VERMELHO", "0-0_POS85", "ZONA_MORTA")) for k in kills)

        # Minuto previsto
        if state.window == Window.W2 and state.minute >= 88:
            predicted = min(90 + state.added_time, state.minute + 2)
        elif state.window == Window.W2 and 82 <= state.minute <= 85:
            predicted = state.minute + 2
        elif state.window == Window.W1 and 43 <= state.minute <= 48:
            predicted = 45 + state.added_time
        elif self.data.is_sequence(state):
            predicted = state.minute + 2
        else:
            predicted = state.minute + 3

        if predicted and predicted <= state.minute:
            predicted = state.minute + 1

        # Verifica multi-entry
        entry_count = self.multi.get_entry_count(match_key, state.window)
        can_multi = self.multi.can_enter(match_key, state.window)

        # MATRIZ v6.0
        if score >= 78 and positive_factors >= 3 and not has_strong_kill:
            if not can_multi:
                decision = Decision.AGUARDA
                justification = f"Score {score} mas limite de entradas ({entry_count}) atingido."
            else:
                decision = Decision.ENTRA
                justification = f"Score {score}≥78 | {positive_factors} fatores | Sem kill forte | Janela {state.window.value}"
        elif 65 <= score <= 77:
            decision = Decision.AGUARDA
            justification = f"Score {score} na zona de transição. Aguardando confirmação."
        else:
            decision = Decision.NAO_ENTRA
            justification = f"Score {score}≤64 ou kill ativa ({len(kills)} penalidades)."

        self.logger.info(f"[DECISAO] {decision.value} | Score {score} | Previsto {predicted}' | Edge {edge}")
        return decision, score, predicted, justification, edge, bonuses, kills


# ==============================================================================
# 13. EXECUTION AGENT v6.0
# ==============================================================================

class ExecutionAgent:
    def __init__(self, bankroll: float = 1000.0, kelly_fraction: float = 0.25):
        self.bankroll = bankroll
        self.kelly = kelly_fraction
        self.trades: List[Trade] = []
        self.logger = logging.getLogger("CornerAI.ExecutionAgent")

    def stake_size(self, score: int, odds: float = 1.85, edge: float = 0.0) -> float:
        if score < 78:
            return 0.0
        prob = 0.50 + (score - 75) * 0.01
        if edge > 0:
            prob += edge
        edge_calc = prob - (1 / odds)
        if edge_calc <= 0:
            return 0.0
        kelly_stake = self.bankroll * edge_calc / (odds - 1)
        return round(min(kelly_stake * self.kelly, self.bankroll * 0.05), 2)

    def execute(self, state: MatchState, decision: Decision, score: int,
                predicted_minute: Optional[int], odds: float = 1.85,
                edge: float = 0.0, entry_count: int = 1) -> Optional[Trade]:
        if decision != Decision.ENTRA:
            return None
        stake = self.stake_size(score, odds, edge)
        if stake <= 0:
            self.logger.warning("[EXEC] Stake zero — edge insuficiente.")
            return None
        trade = Trade(
            id=f"T{datetime.now().strftime('%H%M%S')}_{random.randint(1000,9999)}",
            timestamp=datetime.now().isoformat(),
            window=state.window,
            decision=decision,
            minute_predicted=predicted_minute or state.minute + 2,
            minute_real=None,
            result=None,
            stake=stake,
            odds=odds,
            entry_count=entry_count
        )
        self.trades.append(trade)
        self.logger.info(f"[EXEC] {trade.id} | Stake R${stake} | Odds {odds} | Entrada #{entry_count}")
        return trade

    def settle(self, trade_id: str, minute_real: int, result: str):
        for t in self.trades:
            if t.id == trade_id:
                t.minute_real = minute_real
                t.result = result
                if result == "GREEN":
                    t.profit = round(t.stake * (t.odds - 1), 2)
                    self.bankroll += t.profit
                elif result == "RED":
                    t.profit = -t.stake
                    self.bankroll -= t.stake
                else:
                    t.profit = 0.0
                self.logger.info(f"[SETTLE] {trade_id} -> {result} | Banca: R${round(self.bankroll,2)}")
                break

    def report(self) -> dict:
        greens = len([t for t in self.trades if t.result == "GREEN"])
        reds = len([t for t in self.trades if t.result == "RED"])
        total = greens + reds
        win_rate = (greens / total * 100) if total > 0 else 0
        profit = self.bankroll - 1000
        return {
            "total_trades": len(self.trades),
            "greens": greens,
            "reds": reds,
            "win_rate_pct": round(win_rate, 2),
            "bankroll": round(self.bankroll, 2),
            "profit": round(profit, 2),
            "roi_pct": round(profit / 10, 2) if profit != 0 else 0
        }


# ==============================================================================
# 14. LEARNING AGENT
# ==============================================================================

class LearningAgent:
    def __init__(self):
        self.weights = {
            "W1_43-48": 15, "W2_82-86": 18, "W2_88+": 22,
            "SEQUENCIA": 10, "DANGEROUS_DIFF": 10, "PLACAR_APERTADO": 7,
            "DOMINIO": 6, "SUBS_OFENSIVAS": 5, "CLUSTER": 12,
            "ONDA": 9, "MOMENTUM": 12, "VOLUME": 8, "EDGE_MERCADO": 5
        }
        self.kill_weights = {
            "GOL_SOFRIDO": 20, "GOL_MARCADO": 14, "IP2_FALSO": 16,
            "PLACAR_ABERTO": 15, "APPM_BAIXO": 10, "VAR": 12,
            "0-0_POS85": 7, "RED_CARD": 10, "ZONA_MORTA": 12, "MERCADO_UNDER": 8
        }
        self.history = []
        self.logger = logging.getLogger("CornerAI.LearningAgent")

    def feedback(self, state: MatchState, bonuses: List[str], kills: List[str],
                 decision: Decision, result: str, minute_diff: int):
        self.history.append({
            "state": asdict(state), "bonuses": bonuses, "kills": kills,
            "decision": decision.value, "result": result, "minute_diff": minute_diff
        })
        lr = 0.05
        for b in bonuses:
            key = b.split(" (+" )[0].strip()
            for wk in self.weights:
                if wk in key:
                    delta = +lr if result == "GREEN" else -lr
                    self.weights[wk] = max(1, self.weights[wk] + delta)
        for k in kills:
            key = k.split(" (-")[0].strip()
            for wk in self.kill_weights:
                if wk in key:
                    delta = -lr if result == "GREEN" else +lr
                    self.kill_weights[wk] = max(1, self.kill_weights[wk] + delta)
        self.logger.info(f"[LEARN] {result} | Diff {minute_diff}min | Ajustes: {len(bonuses)+len(kills)}")

    def export_model(self, path: str = "cornerai_weights.json"):
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"bonuses": self.weights, "kills": self.kill_weights,
                       "samples": len(self.history)}, f, indent=2, ensure_ascii=False)
        self.logger.info(f"[EXPORT] Modelo salvo em {path}")


# ==============================================================================
# ORQUESTRADOR PRINCIPAL v6.0
# ==============================================================================

class CornerAITrader:
    def __init__(self, bankroll: float = 1000.0):
        self.data_agent = DataAgent()
        self.quality_agent = DataQualityAgent(self.data_agent)
        self.market_agent = MarketAgent()
        self.pattern_agent = PatternAgent(self.data_agent)
        self.context_agent = ContextAgent()
        self.momentum_agent = MomentumAgent(self.data_agent)
        self.volumetry_agent = VolumetryAgent(self.data_agent)
        self.score_agent = ScoreAgent(
            self.data_agent, self.pattern_agent, self.context_agent,
            self.momentum_agent, self.volumetry_agent, self.market_agent
        )
        self.risk_agent = RiskAgent(bankroll)
        self.multi_entry = MultiEntryAgent()
        self.alert_agent = AlertAgent()
        self.decision_agent = DecisionAgent(
            self.score_agent, self.data_agent, self.pattern_agent,
            self.multi_entry, self.risk_agent, self.alert_agent
        )
        self.exec_agent = ExecutionAgent(bankroll)
        self.learn_agent = LearningAgent()
        self.logger = logging.getLogger("CornerAI.Trader")

    def analyze(self, raw_state: dict, odds: float = 1.85) -> dict:
        state = self.data_agent.ingest(raw_state)
        self.market_agent.update(state)

        # Validação de qualidade
        valid, issues = self.quality_agent.validate(state)
        if not valid:
            self.alert_agent.emit(AlertLevel.CRITICAL, f"Dados inconsistentes: {issues}", state.minute)

        match_key = f"{state.home_team}_{state.away_team}"
        open_exposure = sum(t.stake for t in self.exec_agent.trades if t.result is None)

        decision, score, predicted, justification, edge, bonuses, kills = \
            self.decision_agent.decide(state, match_key, open_exposure)

        # Verificação de risco
        if decision == Decision.ENTRA:
            stake = self.exec_agent.stake_size(score, odds, edge)
            can_trade, risk_msg = self.risk_agent.can_trade(stake, open_exposure)
            if not can_trade:
                decision = Decision.NAO_ENTRA
                justification += f" | BLOQUEADO_RISCO: {risk_msg}"
                self.alert_agent.emit(AlertLevel.WARNING, risk_msg, state.minute)

        # Execução
        entry_count = self.multi_entry.get_entry_count(match_key, state.window)
        trade = self.exec_agent.execute(state, decision, score, predicted, odds, edge, entry_count + 1)
        if trade:
            self.multi_entry.register_entry(match_key, state.window, trade)

        result = {
            "match": f"{state.home_team} x {state.away_team}",
            "competition": state.competition,
            "minute": state.minute,
            "half": state.half,
            "window": state.window.value,
            "score_match": f"{state.score_home}-{state.score_away}",
            "score_cornerai": score,
            "decision": decision.value,
            "predicted_minute": predicted,
            "justification": justification,
            "edge_vs_market": edge,
            "bonuses": bonuses,
            "kills": kills,
            "data_quality_issues": issues if not valid else [],
            "market_sentiment": self.market_agent.market_sentiment(),
            "pressure_index": self.pattern_agent.pressure_index(state),
            "trade_id": trade.id if trade else None,
            "stake": trade.stake if trade else 0.0,
            "entry_number": trade.entry_count if trade else 0,
            "bankroll": round(self.exec_agent.bankroll, 2),
            "alerts": [{"level": a.level.value, "msg": a.message, "min": a.minute} for a in self.alert_agent.alerts[-3:]]
        }
        self.logger.info(f"[ANALYZE] {state.home_team} x {state.away_team} | {decision.value} | Score {score}")
        return result

    def feedback_trade(self, trade_id: str, minute_real: int, result: str):
        trade = next((t for t in self.exec_agent.trades if t.id == trade_id), None)
        if not trade:
            return
        diff = abs(trade.minute_predicted - minute_real)
        last_state = self.data_agent.history[-1] if self.data_agent.history else None
        if last_state:
            score, bonuses, kills, _ = self.score_agent.calculate(last_state)
            self.learn_agent.feedback(last_state, bonuses, kills,
                                      Decision(trade.decision.value), result, diff)
        self.exec_agent.settle(trade_id, minute_real, result)
        self.risk_agent.update_daily_loss(trade.profit)

    def generate_report(self) -> str:
        r = self.exec_agent.report()
        lines = [
            "=" * 60,
            "CORNERAI PRO MAX — RELATÓRIO DE PERFORMANCE v6.0",
            "=" * 60,
            f"Total de Operações : {r['total_trades']}",
            f"Greens             : {r['greens']}",
            f"Reds               : {r['reds']}",
            f"Win Rate           : {r['win_rate_pct']}%",
            f"Banca Atual        : R$ {r['bankroll']}",
            f"Lucro/Prejuízo     : R$ {r['profit']}",
            f"ROI                : {r['roi_pct']}%",
            f"Alertas Emitidos   : {len(self.alert_agent.alerts)}",
            f"Amostras Learning  : {len(self.learn_agent.history)}",
            "=" * 60,
        ]
        return "\n".join(lines)


# ==============================================================================
# DEMO / SIMULAÇÃO
# ==============================================================================

def demo():
    trader = CornerAITrader(bankroll=1000.0)

    # Cenário 1: W2 — Sport x Cuiabá (84')
    state1 = {
        "minute": 84, "half": 2, "added_time": 5,
        "score_home": 1, "score_away": 1,
        "attacks_home": 104, "attacks_away": 81,
        "dangerous_attacks_home": 36, "dangerous_attacks_away": 49,
        "shots_on_target_home": 3, "shots_on_target_away": 3,
        "shots_inside_box_home": 4, "shots_inside_box_away": 5,
        "possession_home": 44.0, "possession_away": 56.0,
        "xg_home": 0.43, "xg_away": 0.40,
        "corners_home": 8, "corners_away": 11,
        "last_corner_minute": 83, "last_corner_team": "away",
        "last_goal_minute": 75, "last_goal_team": "away",
        "var_recent": False, "long_stop_recent": False,
        "red_card_home": 0, "red_card_away": 0,
        "subs_offensive_home": 1, "subs_offensive_away": 2,
        "graph_standard_trend": [10, 20, 15, 25, 30, 35, 40, 45],
        "graph_accumulated_home": 23, "graph_accumulated_away": 48,
        "home_team": "Sport Recife", "away_team": "Cuiabá",
        "competition": "Brasileirão Série B",
        "odds_over": 1.90, "odds_under": 1.95, "liquidity": 1200.0
    }

    res1 = trader.analyze(state1, odds=1.90)
    print("\n" + "=" * 60)
    print("RESULTADO 1 — SPORT x CUIABÁ (84')")
    print("=" * 60)
    print(json.dumps(res1, indent=2, ensure_ascii=False))

    # Cenário 2: W1 — Atlético-GO x Athletic (40')
    state2 = {
        "minute": 40, "half": 1, "added_time": 3,
        "score_home": 0, "score_away": 0,
        "attacks_home": 51, "attacks_away": 27,
        "dangerous_attacks_home": 25, "dangerous_attacks_away": 6,
        "shots_on_target_home": 3, "shots_on_target_away": 1,
        "shots_inside_box_home": 10, "shots_inside_box_away": 1,
        "possession_home": 57.0, "possession_away": 43.0,
        "xg_home": 0.75, "xg_away": 0.36,
        "corners_home": 6, "corners_away": 1,
        "last_corner_minute": 36, "last_corner_team": "home",
        "last_goal_minute": None, "last_goal_team": None,
        "var_recent": False, "long_stop_recent": False,
        "red_card_home": 0, "red_card_away": 0,
        "subs_offensive_home": 0, "subs_offensive_away": 0,
        "graph_standard_trend": [20, 35, 50, 60, 55, 50, 45, 40],
        "graph_accumulated_home": 60, "graph_accumulated_away": 20,
        "home_team": "Atlético-GO", "away_team": "Athletic Club",
        "competition": "Brasileirão Série B",
        "odds_over": 1.85, "odds_under": 1.95, "liquidity": 800.0
    }

    res2 = trader.analyze(state2, odds=1.85)
    print("\n" + "=" * 60)
    print("RESULTADO 2 — ATLÉTICO-GO x ATHLETIC (40')")
    print("=" * 60)
    print(json.dumps(res2, indent=2, ensure_ascii=False))

    # Feedbacks
    if res1.get("trade_id"):
        trader.feedback_trade(res1["trade_id"], 87, "GREEN")
    if res2.get("trade_id"):
        trader.feedback_trade(res2["trade_id"], 43, "GREEN")

    print("\n" + trader.generate_report())
    trader.learn_agent.export_model("/home/workdir/artifacts/cornerai_weights_v6.json")


if __name__ == "__main__":
    demo()
```
```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
================================================================================
CORNERAI PRO — SISTEMA MULTI-AGENTE DE TRADING DE ESCANTEIOS v5.1
================================================================================
Autor: CornerAI Project
Data:  2026-08-05
Atualização: Integração completa do Score v5.1, aprendizados das PARTIDAS
             004/005/006, densidades temporais e kill zones oficiais.

Janelas Oficiais:
  • W1: 30' do 1º tempo até o intervalo (incluindo acréscimos)
  • W2: 80' do 2º tempo até o final (incluindo acréscimos)

Princípios Absolutos:
1. Nunca inventar dados.
2. Nunca ignorar o tempo do jogo.
3. Cruzar sempre todas as evidências.
4. Diferenciar: observado × confirmado × inferência.
5. Nunca prever minuto anterior ao relógio atual.
6. Nunca prometer que um escanteio ocorrerá.
================================================================================
"""

from __future__ import annotations

import json
import logging
import random
from dataclasses import dataclass, field
from datetime import datetime
from enum import Enum
from typing import List, Dict, Optional, Tuple
from collections import deque

# ==============================================================================
# CONFIGURAÇÕES GLOBAIS E LOGGING
# ==============================================================================
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)-8s | %(name)-25s | %(message)s",
    datefmt="%H:%M:%S"
)
logger = logging.getLogger("CornerAI")


class Decision(Enum):
    ENTRA = "ENTRA"
    AGUARDA = "AGUARDA"
    NAO_ENTRA = "NÃO ENTRA"


class Window(Enum):
    W1 = "W1_30_45+"
    W2 = "W2_80_90+"
    OUT = "FORA_DAS_JANELAS"


# ==============================================================================
# 1. ESTRUTURAS DE DADOS
# ==============================================================================

@dataclass
class MatchState:
    """Estado ao vivo da partida — dados observados/confirmados."""
    minute: int
    half: int                        # 1 ou 2
    added_time: int                  # Acréscimos anunciados
    score_home: int
    score_away: int
    attacks_home: int
    attacks_away: int
    dangerous_attacks_home: int
    dangerous_attacks_away: int
    shots_on_target_home: int = 0
    shots_on_target_away: int = 0
    shots_inside_box_home: int = 0
    shots_inside_box_away: int = 0
    possession_home: float = 50.0
    possession_away: float = 50.0
    xg_home: float = 0.0
    xg_away: float = 0.0
    corners_home: int = 0
    corners_away: int = 0
    last_corner_minute: Optional[int] = None
    last_corner_team: Optional[str] = None
    last_goal_minute: Optional[int] = None
    last_goal_team: Optional[str] = None   # "home" ou "away"
    var_recent: bool = False
    long_stop_recent: bool = False
    red_card_home: int = 0
    red_card_away: int = 0
    subs_offensive_home: int = 0
    subs_offensive_away: int = 0
    # Gráfico SokkerPro
    graph_standard_trend: List[float] = field(default_factory=list)
    graph_accumulated_home: int = 0
    graph_accumulated_away: int = 0
    # Metadados
    home_team: str = ""
    away_team: str = ""
    competition: str = ""

    @property
    def total_corners(self) -> int:
        return self.corners_home + self.corners_away

    @property
    def score_diff(self) -> int:
        return abs(self.score_home - self.score_away)

    @property
    def is_draw(self) -> bool:
        return self.score_home == self.score_away

    @property
    def dangerous_diff_home(self) -> int:
        return self.dangerous_attacks_home - self.dangerous_attacks_away

    @property
    def dangerous_diff_away(self) -> int:
        return self.dangerous_attacks_away - self.dangerous_attacks_home

    @property
    def window(self) -> Window:
        if self.half == 1 and 30 <= self.minute <= (45 + max(0, self.added_time)):
            return Window.W1
        if self.half == 2 and 80 <= self.minute <= (90 + max(0, self.added_time)):
            return Window.W2
        return Window.OUT

    @property
    def dominant_side(self) -> str:
        """Retorna 'home' ou 'away' com base em ataques perigosos."""
        if self.dangerous_attacks_home >= self.dangerous_attacks_away:
            return "home"
        return "away"


@dataclass
class Trade:
    """Registro de uma operação executada."""
    id: str
    timestamp: str
    window: Window
    decision: Decision
    minute_predicted: int
    minute_real: Optional[int] = None
    result: Optional[str] = None  # GREEN, RED, VOID
    stake: float = 0.0
    odds: float = 1.85
    profit: float = 0.0
    notes: str = ""


# ==============================================================================
# 2. AGENTE DE COLETA E VALIDAÇÃO DE DADOS
# ==============================================================================

class DataAgent:
    """
    Responsável por:
    • Receber inputs manuais ou API
    • Validar consistência (nunca inventar dados)
    • Calcular métricas derivadas (APPM, sequências)
    """

    def __init__(self):
        self.history: deque = deque(maxlen=30)
        self.logger = logging.getLogger("CornerAI.DataAgent")

    def ingest(self, raw: dict) -> MatchState:
        """Converte dict bruto em MatchState validado."""
        # Garante campos obrigatórios com defaults seguros
        required = {
            "minute": 0, "half": 1, "added_time": 0,
            "score_home": 0, "score_away": 0,
            "attacks_home": 0, "attacks_away": 0,
            "dangerous_attacks_home": 0, "dangerous_attacks_away": 0,
        }
        for k, v in required.items():
            raw.setdefault(k, v)

        state = MatchState(**{k: raw.get(k, getattr(MatchState, k, None))
                              for k in MatchState.__dataclass_fields__})
        self.history.append(state)
        self.logger.info(
            f"[INGEST] {state.home_team} x {state.away_team} | "
            f"{state.minute}' {state.half}T | Placar {state.score_home}-{state.score_away} | "
            f"Janela {state.window.value}"
        )
        return state

    def compute_appm(self, team: str = "home", lookback: int = 8) -> float:
        """Ataques Perigosos Por Minuto nos últimos N minutos aproximados."""
        if len(self.history) < 2:
            return 0.0
        recent = list(self.history)[-min(lookback, len(self.history)):]
        if len(recent) < 2:
            return 0.0
        first, last = recent[0], recent[-1]
        if team == "home":
            delta_da = last.dangerous_attacks_home - first.dangerous_attacks_home
        else:
            delta_da = last.dangerous_attacks_away - first.dangerous_attacks_away
        delta_t = max(1, last.minute - first.minute)
        return round(delta_da / delta_t, 3)

    def is_sequence(self, state: MatchState) -> bool:
        """Último escanteio ocorreu há ≤ 4 minutos?"""
        if state.last_corner_minute is None:
            return False
        return (state.minute - state.last_corner_minute) <= 4

    def minutes_since_goal(self, state: MatchState) -> Optional[int]:
        if state.last_goal_minute is None:
            return None
        return state.minute - state.last_goal_minute

    def pressure_falling(self, state: MatchState, threshold: float = 8.0) -> bool:
        """Detecta queda de pressão no gráfico (falso pico)."""
        trend = state.graph_standard_trend
        if len(trend) < 2:
            return False
        return (trend[-2] - trend[-1]) >= threshold


# ==============================================================================
# 3. AGENTE DE SCORE — CORNERAI v5.1 OFICIAL
# ==============================================================================

class ScoreAgent:
    """
    Calcula o Score CornerAI (0-100) aplicando exatamente as tabelas oficiais
    de bônus e kill zones do documento v5.1 + aprendizado PARTIDA 005.
    """

    def __init__(self, data_agent: DataAgent):
        self.data = data_agent
        self.logger = logging.getLogger("CornerAI.ScoreAgent")

    def calculate(self, state: MatchState) -> Tuple[int, List[str], List[str]]:
        score = 50  # base neutro
        bonuses: List[str] = []
        kills: List[str] = []

        # ------------------------------------------------------------------
        # BÔNUS OFICIAIS (aumentam Score)
        # ------------------------------------------------------------------

        # B1: Minuto 43-48' (W1) + pressão média ou superior
        if state.window == Window.W1 and 43 <= state.minute <= 48:
            appm = self.data.compute_appm("home") + self.data.compute_appm("away")
            if appm >= 0.4 or max(state.dangerous_attacks_home, state.dangerous_attacks_away) >= 8:
                bonus = 15
                score += bonus
                bonuses.append(f"W1_43-48 (+{bonus})")

        # B2: 82-86' (W2) + placar apertado + IP/volume alto
        if state.window == Window.W2 and 82 <= state.minute <= 86:
            if state.score_diff <= 1:
                appm = self.data.compute_appm("home") + self.data.compute_appm("away")
                if appm >= 0.6 or max(state.dangerous_diff_home, state.dangerous_diff_away) >= 8:
                    bonus = 18
                    score += bonus
                    bonuses.append(f"W2_82-86_apertado (+{bonus})")

        # B3: 88'+ / acréscimos + qualquer pressão residual
        if state.window == Window.W2 and state.minute >= 88:
            bonus = 22
            score += bonus
            bonuses.append(f"W2_88+_residual (+{bonus})")

        # B4: Sequência recente (último escanteio ≤ 4 min)
        if self.data.is_sequence(state):
            bonus = 10
            score += bonus
            bonuses.append(f"SEQUENCIA_<=4min (+{bonus})")

        # B5: Diferença de ataques perigosos ≥ +12
        if max(state.dangerous_diff_home, state.dangerous_diff_away) >= 12:
            bonus = 10
            score += bonus
            bonuses.append(f"DANGEROUS_DIFF_>=12 (+{bonus})")

        # B6: Placar empatado ou diferença de 1 gol
        if state.score_diff <= 1:
            bonus = 7
            score += bonus
            bonuses.append(f"PLACAR_APERTADO (+{bonus})")

        # B7: Domínio de posse + finalizações na área
        dominant_poss = max(state.possession_home, state.possession_away)
        dominant_shots = max(state.shots_inside_box_home, state.shots_inside_box_away)
        if dominant_poss >= 55 and dominant_shots >= 3:
            bonus = 6
            score += bonus
            bonuses.append(f"DOMINIO_POSSE_AREA (+{bonus})")

        # B8 (extra BR): Substituições ofensivas no 2T
        if state.half == 2 and (state.subs_offensive_home + state.subs_offensive_away) >= 2:
            bonus = 4
            score += bonus
            bonuses.append(f"SUBS_OFENSIVAS_2T (+{bonus})")

        # ------------------------------------------------------------------
        # KILL ZONES OFICIAIS (reduzem Score)
        # ------------------------------------------------------------------

        mins_since_goal = self.data.minutes_since_goal(state)

        # K1: Gol sofrido nos últimos 3 min (time que sofreu tende a recuar)
        if mins_since_goal is not None and mins_since_goal <= 3:
            # Se o time que sofreu o gol é o que estava pressionando, impacto maior
            kill = 20
            score -= kill
            kills.append(f"GOL_SOFRIDO_ULT_3min (-{kill})")

        # K2: Gol marcado nos últimos 3 min (time que marcou tende a gerenciar)
        if mins_since_goal is not None and mins_since_goal <= 3:
            kill = 12
            score -= kill
            kills.append(f"GOL_MARCADO_ULT_3min (-{kill})")

        # K3: Pressão caindo / falso pico
        if self.data.pressure_falling(state):
            kill = 16
            score -= kill
            kills.append(f"IP2_FALSO_PICO (-{kill})")

        # K4: Diferença de placar ≥ 2 (kill zone clássica)
        if state.score_diff >= 2:
            kill = 15
            score -= kill
            kills.append(f"PLACAR_ABERTO_>=2 (-{kill})")

        # K5: Poucos ataques perigosos (< 3 nos últimos ~8 min)
        appm_total = self.data.compute_appm("home") + self.data.compute_appm("away")
        if appm_total < 0.25 and state.minute > 35:
            kill = 10
            score -= kill
            kills.append(f"APPM_BAIXO (-{kill})")

        # K6: VAR / longa paralisação recente
        if state.var_recent or state.long_stop_recent:
            kill = 12
            score -= kill
            kills.append(f"VAR_PARALISACAO (-{kill})")

        # K7: 0-0 pós-85' + domínio + xG superior (aprendizado PARTIDA 005)
        # Risco de gol no lugar do escanteio
        if (state.window == Window.W2 and state.minute >= 85 and state.is_draw
                and max(state.xg_home, state.xg_away) >= 0.55):
            kill = 7
            score -= kill
            kills.append(f"0-0_POS85_xG_ALTO_risco_gol (-{kill})")

        # K8: Cartão vermelho
        if state.red_card_home > 0 or state.red_card_away > 0:
            kill = 10
            score -= kill
            kills.append(f"CARTAO_VERMELHO (-{kill})")

        # ------------------------------------------------------------------
        score = max(0, min(100, int(round(score))))
        self.logger.info(f"[SCORE] {score}/100 | Bônus: {len(bonuses)} | Kills: {len(kills)}")
        return score, bonuses, kills


# ==============================================================================
# 4. AGENTE DE DECISÃO — MATRIZ v5.1
# ==============================================================================

class DecisionAgent:
    """
    Hierarquia oficial de confiança para ENTRA:
    1. Acréscimos (90+) com pressão residual
    2. 82-85' com placar apertado + volume/sequência
    3. 44-48' com pressão sustentada
    4. Sequência já iniciada
    """

    def __init__(self, score_agent: ScoreAgent, data_agent: DataAgent):
        self.score_agent = score_agent
        self.data = data_agent
        self.logger = logging.getLogger("CornerAI.DecisionAgent")

    def decide(self, state: MatchState) -> Tuple[Decision, int, Optional[int], str]:
        score, bonuses, kills = self.score_agent.calculate(state)

        if state.window == Window.OUT:
            return Decision.NAO_ENTRA, score, None, "Fora das janelas oficiais W1 ou W2."

        positive_factors = len(bonuses)
        strong_kills = [k for k in kills if any(
            tag in k for tag in ("GOL_SOFRIDO", "PLACAR_ABERTO", "VAR_PARALISACAO",
                                 "CARTAO_VERMELHO", "0-0_POS85")
        )]
        has_strong_kill = len(strong_kills) > 0

        # Hierarquia de minuto previsto
        predicted = self._predict_minute(state)

        # Matriz de decisão
        if score >= 78 and positive_factors >= 3 and not has_strong_kill:
            decision = Decision.ENTRA
            justification = (
                f"Score {score} ≥ 78 | {positive_factors} fatores positivos | "
                f"Sem kill zone forte | Janela {state.window.value}"
            )
        elif 62 <= score <= 77:
            decision = Decision.AGUARDA
            justification = (
                f"Score {score} na zona de transição (62-77). "
                f"Aguardando 1-2 confirmações adicionais."
            )
        else:
            decision = Decision.NAO_ENTRA
            justification = (
                f"Score {score} ≤ 55 ou kill zone ativa ({len(kills)} penalidades). "
                f"Pressão insuficiente ou contexto desfavorável."
            )

        self.logger.info(
            f"[DECISAO] {decision.value} | Score {score} | Previsto: {predicted}'"
        )
        return decision, score, predicted, justification

    def _predict_minute(self, state: MatchState) -> Optional[int]:
        """Retorna apenas UM minuto futuro (nunca anterior ao relógio)."""
        if state.window == Window.W2 and state.minute >= 88:
            pred = min(90 + state.added_time, state.minute + 2)
        elif state.window == Window.W2 and 82 <= state.minute <= 85:
            pred = state.minute + 2
        elif state.window == Window.W1 and 43 <= state.minute <= 48:
            pred = 45 + max(0, state.added_time)
        elif self.data.is_sequence(state):
            pred = state.minute + 2
        else:
            pred = state.minute + 3

        # Nunca prever minuto anterior ou igual ao atual
        if pred <= state.minute:
            pred = state.minute + 1
        return pred


# ==============================================================================
# 5. AGENTE DE EXECUÇÃO E GESTÃO DE BANCA
# ==============================================================================

class ExecutionAgent:
    """Kelly fracionado + registro de trades."""

    def __init__(self, bankroll: float = 1000.0, kelly_fraction: float = 0.25):
        self.initial_bankroll = bankroll
        self.bankroll = bankroll
        self.kelly = kelly_fraction
        self.trades: List[Trade] = []
        self.logger = logging.getLogger("CornerAI.ExecutionAgent")

    def stake_size(self, score: int, odds: float = 1.85) -> float:
        if score < 78:
            return 0.0
        # Heurística de probabilidade baseada no Score (calibrada na base histórica)
        # Score 78 → ~55% | Score 90 → ~67%
        prob = 0.45 + (score - 70) * 0.012
        edge = prob - (1.0 / odds)
        if edge <= 0:
            return 0.0
        kelly_full = self.bankroll * edge / (odds - 1)
        stake = kelly_full * self.kelly
        # Cap de 5% da banca
        return round(min(stake, self.bankroll * 0.05), 2)

    def execute(self, state: MatchState, decision: Decision, score: int,
                predicted_minute: Optional[int], odds: float = 1.85) -> Optional[Trade]:
        if decision != Decision.ENTRA:
            return None

        stake = self.stake_size(score, odds)
        if stake <= 0:
            self.logger.warning("[EXEC] Stake zero — edge insuficiente.")
            return None

        trade = Trade(
            id=f"T{datetime.now().strftime('%H%M%S')}_{random.randint(1000,9999)}",
            timestamp=datetime.now().isoformat(timespec="seconds"),
            window=state.window,
            decision=decision,
            minute_predicted=predicted_minute or (state.minute + 2),
            stake=stake,
            odds=odds,
        )
        self.trades.append(trade)
        self.logger.info(
            f"[EXEC] {trade.id} | Stake R${stake:.2f} | Odds {odds} | "
            f"Previsto {trade.minute_predicted}'"
        )
        return trade

    def settle(self, trade_id: str, minute_real: int, result: str):
        for t in self.trades:
            if t.id == trade_id:
                t.minute_real = minute_real
                t.result = result.upper()
                if t.result == "GREEN":
                    t.profit = round(t.stake * (t.odds - 1), 2)
                    self.bankroll += t.profit
                elif t.result == "RED":
                    t.profit = -t.stake
                    self.bankroll -= t.stake
                else:
                    t.profit = 0.0
                self.logger.info(
                    f"[SETTLE] {trade_id} → {t.result} | "
                    f"P&L R${t.profit:+.2f} | Banca R${self.bankroll:.2f}"
                )
                break

    def report(self) -> dict:
        greens = sum(1 for t in self.trades if t.result == "GREEN")
        reds = sum(1 for t in self.trades if t.result == "RED")
        total = greens + reds
        win_rate = (greens / total * 100) if total > 0 else 0.0
        roi = ((self.bankroll - self.initial_bankroll) / self.initial_bankroll * 100)
        return {
            "total_trades": len(self.trades),
            "greens": greens,
            "reds": reds,
            "win_rate_pct": round(win_rate, 1),
            "bankroll": round(self.bankroll, 2),
            "roi_pct": round(roi, 1),
        }


# ==============================================================================
# 6. AGENTE DE APRENDIZADO
# ==============================================================================

class LearningAgent:
    """Ajuste simples de pesos com base em feedback GREEN/RED."""

    def __init__(self):
        self.weights = {
            "W1_43-48": 15.0,
            "W2_82-86_apertado": 18.0,
            "W2_88+_residual": 22.0,
            "SEQUENCIA_<=4min": 10.0,
            "DANGEROUS_DIFF_>=12": 10.0,
            "PLACAR_APERTADO": 7.0,
            "DOMINIO_POSSE_AREA": 6.0,
            "SUBS_OFENSIVAS_2T": 4.0,
        }
        self.kill_weights = {
            "GOL_SOFRIDO_ULT_3min": 20.0,
            "GOL_MARCADO_ULT_3min": 12.0,
            "IP2_FALSO_PICO": 16.0,
            "PLACAR_ABERTO_>=2": 15.0,
            "APPM_BAIXO": 10.0,
            "VAR_PARALISACAO": 12.0,
            "0-0_POS85_xG_ALTO_risco_gol": 7.0,
            "CARTAO_VERMELHO": 10.0,
        }
        self.history: List[dict] = []
        self.logger = logging.getLogger("CornerAI.LearningAgent")

    def feedback(self, bonuses: List[str], kills: List[str],
                 result: str, minute_diff: int):
        self.history.append({
            "bonuses": bonuses,
            "kills": kills,
            "result": result,
            "minute_diff": minute_diff,
            "ts": datetime.now().isoformat(timespec="seconds"),
        })
        lr = 0.04
        for b in bonuses:
            key = b.split(" (+")[0].strip()
            if key in self.weights:
                delta = lr if result == "GREEN" else -lr
                self.weights[key] = max(1.0, self.weights[key] + delta)

        for k in kills:
            key = k.split(" (-")[0].strip()
            if key in self.kill_weights:
                # Se saiu GREEN mesmo com kill, o kill estava excessivo
                delta = -lr if result == "GREEN" else lr
                self.kill_weights[key] = max(1.0, self.kill_weights[key] + delta)

        self.logger.info(
            f"[LEARN] {result} | Diff {minute_diff}min | "
            f"Ajustes: {len(bonuses)+len(kills)} pesos"
        )

    def export_model(self, path: str = "cornerai_weights.json"):
        payload = {
            "version": "5.1",
            "bonuses": self.weights,
            "kills": self.kill_weights,
            "samples": len(self.history),
            "exported_at": datetime.now().isoformat(timespec="seconds"),
        }
        with open(path, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2, ensure_ascii=False)
        self.logger.info(f"[EXPORT] Modelo salvo → {path}")


# ==============================================================================
# 7. ORQUESTRADOR PRINCIPAL
# ==============================================================================

class CornerAITrader:
    """
    Fluxo obrigatório v5.1 (11 passos).
    """

    def __init__(self, bankroll: float = 1000.0):
        self.data_agent = DataAgent()
        self.score_agent = ScoreAgent(self.data_agent)
        self.decision_agent = DecisionAgent(self.score_agent, self.data_agent)
        self.exec_agent = ExecutionAgent(bankroll)
        self.learn_agent = LearningAgent()
        self.logger = logging.getLogger("CornerAI.Trader")

    def analyze(self, raw_state: dict, odds: float = 1.85) -> dict:
        """Pipeline completo de análise em uma chamada."""
        state = self.data_agent.ingest(raw_state)

        historical_note = self._compare_historical(state)
        score, bonuses, kills = self.score_agent.calculate(state)
        decision, score_final, predicted, justification = self.decision_agent.decide(state)
        trade = self.exec_agent.execute(state, decision, score_final, predicted, odds)

        result = {
            "match": f"{state.home_team} x {state.away_team}",
            "competition": state.competition,
            "minute": state.minute,
            "half": state.half,
            "added_time": state.added_time,
            "window": state.window.value,
            "score_match": f"{state.score_home}-{state.score_away}",
            "score_cornerai": score_final,
            "decision": decision.value,
            "predicted_minute": predicted,
            "justification": justification,
            "bonuses": bonuses,
            "kills": kills,
            "historical_pattern": historical_note,
            "trade_id": trade.id if trade else None,
            "stake": trade.stake if trade else 0.0,
            "bankroll": round(self.exec_agent.bankroll, 2),
        }
        self.logger.info(
            f"[ANALYZE] {state.home_team} x {state.away_team} | "
            f"{decision.value} | Score {score_final}"
        )
        return result

    def _compare_historical(self, state: MatchState) -> str:
        if state.window == Window.W1 and state.minute >= 43:
            return ("Base histórica (20 partidas): 75% têm ≥1 escanteio em W1. "
                    "Pico absoluto em 45'/45+. Clusters 31-36' e 37-40'.")
        if state.window == Window.W2 and state.minute >= 82:
            return ("Base histórica: 80% têm ≥1 escanteio em W2. "
                    "Pico absoluto em 90'/90+. Clusters fortes 82-84' e 80-84'.")
        if state.window == Window.W2 and state.minute >= 88:
            return ("Acréscimos: nunca descartar se houver volume residual. "
                    "Mandante buscando resultado pode inverter volume.")
        return "Janela ativa — dados insuficientes para padrão histórico específico."

    def feedback_trade(self, trade_id: str, minute_real: int, result: str):
        trade = next((t for t in self.exec_agent.trades if t.id == trade_id), None)
        if not trade:
            return
        diff = abs(trade.minute_predicted - minute_real)
        last_state = self.data_agent.history[-1] if self.data_agent.history else None
        if last_state:
            _, bonuses, kills = self.score_agent.calculate(last_state)
            self.learn_agent.feedback(bonuses, kills, result.upper(), diff)
        self.exec_agent.settle(trade_id, minute_real, result)

    def generate_report(self) -> str:
        r = self.exec_agent.report()
        lines = [
            "=" * 62,
            "CORNERAI PRO v5.1 — RELATÓRIO DE PERFORMANCE",
            "=" * 62,
            f"Total de Operações : {r['total_trades']}",
            f"Greens             : {r['greens']}",
            f"Reds               : {r['reds']}",
            f"Win Rate           : {r['win_rate_pct']}%",
            f"Banca Atual        : R$ {r['bankroll']}",
            f"ROI                : {r['roi_pct']}%",
            "=" * 62,
        ]
        return "\n".join(lines)


