    DISCORD_WEBHOOK_URL: str = os.getenv("DISCORD_WEBHOOK_URL", "")
    JANELAS_ATIVAS: List[tuple] = field(default_factory=lambda: [
        (dtime(15, 0), dtime(23, 59)), (dtime(0, 0), dtime(2, 0))])
    CHECK_INTERVAL_SECONDS: int = 60
    WEIGHTS: Dict[str, Any] = field(default_factory=lambda: WEIGHTS_V7)
    TARGET_LEAGUES: List[int] = field(default_factory=lambda: [71, 72])

CFG = Config()

CASES_DATABASE: List[Dict[str, Any]] = [
