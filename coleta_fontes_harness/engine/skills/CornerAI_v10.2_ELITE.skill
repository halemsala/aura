# =============================================================================
class ScoreAgentBase:
    def __init__(self, weights: Dict = None):
        self.weights = weights or WEIGHTS_V7

    def calculate(self, md: Dict) -> Dict[str, Any]:
        base, tb, tk = 50.0, 0.0, 0.0
        bonuses, kills = [], []
        minute = md.get("minute", 0)
        ap = md.get("ap_diff", 0)
        sd = abs(md.get("score_home", 0) - md.get("score_away", 0))
        lcm, lgm = md.get("last_corner_minute") or 0, md.get("last_goal_minute") or 0
        B, K = self.weights["bonuses"], self.weights["kills"]

        def _b(cond, key):
            nonlocal tb
            if cond:
                v = B.get(key, 0); tb += v; bonuses.append(f"{key}(+{v})")
        def _k(cond, key):
            nonlocal tk
            if cond:
                v = K.get(key, 0); tk += v; kills.append(f"{key}(-{v})")

        _b(43 <= minute <= 48, "W1_43-48")
        _b(82 <= minute <= 86 and sd <= 1, "W2_82-86")
        _b(minute >= 88, "W2_88+")
        _b(lcm and (minute - lcm) <= 4, "SEQUENCIA")
        _b(ap >= 12, "DANGEROUS_DIFF")
        _b(sd <= 1, "PLACAR_APERTADO")
        _b(md.get("possession_dominant", 0) >= 60, "DOMINIO")
        _b(md.get("momentum_rising", False), "MOMENTUM")
        _k(lgm and (minute - lgm) <= 3, "GOL_SOFRIDO")
        _k(md.get("ip2_trend") == "falling", "IP2_FALSO")
        _k(sd >= 2, "PLACAR_ABERTO")
        _k(md.get("score_home", 0) == 0 and md.get("score_away", 0) == 0 and minute >= 85 and md.get("xg_dominant", 0) >= 0.6, "0-0_POS85")
        _k(lcm and (minute - lcm) >= 15, "ZONA_MORTA")
        _k(md.get("red_card_pressing_team", False), "RED_CARD")

        final = min(100, max(0, base + tb - tk))
        fc = len(bonuses)
        strong = tk >= 15
        if final >= 78 and fc >= 3 and not strong: dec = "ENTRA"
        elif 62 <= final <= 77: dec = "AGUARDA"
        else: dec = "NÃO ENTRA"
        return {"score": round(final, 1), "decision": dec, "bonuses": bonuses, "kills": kills,
                "factors_count": fc, "total_bonus": round(tb, 1), "total_kill": round(tk, 1)}

class EnhancedScoreAgent:
    def __init__(self, weights: Dict = None):
        self.base = ScoreAgentBase(weights)
        self.mc = MonteCarloAgent()
        self.fatigue = FatigueAgent()
        self.corr = CorrelationAgent()
        self.pattern = PatternMatcher()
        self.risk = RiskManager()

    def calculate_enhanced(self, md: Dict) -> Dict[str, Any]:
        br = self.base.calculate(md)
        mc_r = self.mc.simulate(md.get("minute", 0), md)
        fat_r = self.fatigue.calculate(md)
        _, corr_red = self.corr.adjust(br["bonuses"], self.base.weights)
        similar = self.pattern.find_similar(md, top_n=3)
        adj = min(100, max(0, br["score"] + fat_r["score_adjustment"] - corr_red))
        strong = br["total_kill"] >= 15
        if adj >= 78 and br["factors_count"] >= 3 and not strong and mc_r["passes_threshold"]:
            dec = "ENTRA"
        elif adj >= 70 and mc_r["probability"] >= 55 and not strong:
            dec = "AGUARDA"
        else:
            dec = "NÃO ENTRA"
        can, reason = self.risk.can_enter()
        if dec == "ENTRA" and not can: dec = "BLOQUEADO"
        stake = self.risk.calc_stake(adj, mc_r["probability"])
        return {"score_base": br["score"], "score_adjusted": round(adj, 1), "decision": dec,
                "monte_carlo": mc_r, "fatigue": fat_r, "correlation_reduction": round(corr_red, 1),
                "similar_cases": similar, "stake": stake, "bonuses": br["bonuses"], "kills": br["kills"],
                "risk_status": reason if not can else "OK"}

class BacktestEngine:
    def __init__(self, cases: List[Dict] = None):
        self.cases = cases or CASES_DATABASE

    def run(self, weights: Dict = None) -> Dict[str, Any]:
        w = weights or WEIGHTS_V7
        results = []
        for c in self.cases:
            if c["result"] == "PENDENTE": continue
            sim = 50.0 + sum(w["bonuses"].get(f, 0) for f in c.get("factors", [])) - sum(w["kills"].get(k, 0) for k in c.get("kills", []))
            sim = min(100, max(0, sim))
            fc = len(c.get("factors", []))
            sk = any(k in ("GOL_SOFRIDO", "PLACAR_ABERTO", "IP2_FALSO") for k in c.get("kills", []))
            sim_dec = "ENTRA" if sim >= 78 and fc >= 3 and not sk else ("AGUARDA" if 62 <= sim <= 77 else "NÃO ENTRA")
            actual = c["result"]
            correct = ((actual == "ACERTO" and sim_dec == "ENTRA") or
                       (actual == "ERRO" and sim_dec != "ENTRA") or
                       (actual == "CORRETO" and sim_dec == c["decision"]))
            results.append({"case_id": c["id"], "match": c["match"], "window": c["window"],
                            "sim_score": round(sim, 1), "sim_decision": sim_dec, "actual": actual, "correct": correct})
        total = len(results)
        ok = sum(1 for r in results if r["correct"])
        w1 = [r for r in results if r["window"] == "W1"]
        w2 = [r for r in results if r["window"] == "W2"]
        return {"total": total, "correct": ok, "accuracy": round(ok / max(1, total) * 100, 1),
                "w1_acc": round(sum(1 for r in w1 if r["correct"]) / max(1, len(w1)) * 100, 1),
                "w2_acc": round(sum(1 for r in w2 if r["correct"]) / max(1, len(w2)) * 100, 1),
                "details": results, "ts": datetime.now().isoformat()}

class TrainingPipeline:
    def __init__(self):
        self.bt = BacktestEngine()
        self.learner = LearningAgent()
        self.best_acc = 0.0

    def train(self, max_iter: int = 50, target: float = 85.0) -> Dict:
        logger.info(f"TRAIN | target={target}% max={max_iter}")
        best_w = json.loads(json.dumps(self.learner.weights))
        best_report, iters = None, 0
        for i in range(max_iter):
            iters = i + 1
            report = self.bt.run(self.learner.weights)
            acc = report["accuracy"]
            if acc > self.best_acc:
                self.best_acc = acc; best_w = json.loads(json.dumps(self.learner.weights)); best_report = report
            if acc >= target: break
            for d in report["details"]:
                if not d["correct"]:
                    c = next((x for x in CASES_DATABASE if x["id"] == d["case_id"]), None)
                    if c:
                        sig = {"factors": ", ".join(c.get("factors", [])), "kills_active": ", ".join(c.get("kills", []))}
                        self.learner.record_outcome(sig, "erro" if c["result"] == "ACERTO" else "acerto")
        self.learner.weights = best_w; self.learner._save()
        return {"iterations": iters, "best_accuracy": self.best_acc, "target": target,
                "achieved": self.best_acc >= target, "report": best_report}

class CornerAIOrchestrator:
    def __init__(self):
        self.cfg = CFG
        self.data = DataSourceAgent(self.cfg)
        self.notif = NotificationAgent(self.cfg)
        self.scorer = EnhancedScoreAgent()
        self._running = False

    def _in_window(self) -> bool:
        now = datetime.now().time()
        for s, e in self.cfg.JANELAS_ATIVAS:
            if (s <= e and s <= now <= e) or (s > e and (now >= s or now <= e)): return True
        return False

    async def _process(self, fixture: Dict) -> Optional[Dict]:
        fi = fixture.get("fixture", {})
        fid, elapsed = fi.get("id"), fi.get("status", {}).get("elapsed", 0) or 0
        if not (30 <= elapsed <= 48 or elapsed >= 80): return None
        teams, goals = fixture.get("teams", {}), fixture.get("goals", {})
        home = teams.get("home", {}).get("name", "?"); away = teams.get("away", {}).get("name", "?")
        sh, sa = goals.get("home", 0) or 0, goals.get("away", 0) or 0
        ap = await self.data.get_dangerous_attacks(fid)
        corners = await self.data.get_corners_live(fid)
        md = {"minute": elapsed, "score_home": sh, "score_away": sa,
              "ap_home": ap["home"], "ap_away": ap["away"], "ap_diff": ap["diff"],
              "corners_home": corners["home"], "corners_away": corners["away"],
              "last_corner_minute": None, "last_goal_minute": None, "ip2_trend": "stable",
              "possession_dominant": 0, "momentum_rising": ap["diff"] >= 15,
              "xg_dominant": 0, "red_card_pressing_team": False, "has_sequence": False,
              "total_attacks": ap["home"] + ap["away"], "subs_home": 0, "subs_away": 0,
              "pressing_team": "home", "factors": []}
        result = self.scorer.calculate_enhanced(md)
        return {"fixture_id": fid, "home": home, "away": away, "minute": elapsed,
                "score": result["score_adjusted"], "decision": result["decision"],
                "ap_home": ap["home"], "ap_away": ap["away"], "ap_diff": ap["diff"],
                "corners_home": corners["home"], "corners_away": corners["away"],
                "factors": ", ".join(result["bonuses"]) or "Nenhum",
                "kills_active": ", ".join(result["kills"]) or "Nenhuma",
                "mc_prob": result["monte_carlo"]["probability"]}

    async def _cycle(self):
        if not self._in_window(): return
        logger.info("━━━ Ciclo ━━━")
        for lid in self.cfg.TARGET_LEAGUES:
            try: fixtures = await self.data.get_live_fixtures(league_id=lid)
            except Exception as e: logger.error(f"Fixtures {lid}: {e}"); continue
            for f in fixtures:
                try:
                    sig = await self._process(f)
                    if sig and sig["decision"] in ("ENTRA", "AGUARDA"):
                        await self.notif.broadcast(sig)
                except Exception as e: logger.error(f"Process: {e}")

    async def run(self):
        logger.info("CornerAI v7.1 Unified | Ligas %s | %ss", self.cfg.TARGET_LEAGUES, self.cfg.CHECK_INTERVAL_SECONDS)
        self._running = True
        try:
            while self._running:
                await self._cycle()
                await asyncio.sleep(self.cfg.CHECK_INTERVAL_SECONDS)
        except (KeyboardInterrupt, SystemExit): pass
        finally:
            await self.data.close(); await self.notif.close()

def cli_train():
    print("=" * 60 + "\n CornerAI v7.1 — Training\n" + "=" * 60)
    r = TrainingPipeline().train(max_iter=50, target=80.0)
    print(f"Iter={r['iterations']} | Best={r['best_accuracy']}% | Atingido={'✅' if r['achieved'] else '❌'}")
    if r.get("report"):
        bt = r["report"]
        print(f"Cases={bt['total']} OK={bt['correct']} W1={bt['w1_acc']}% W2={bt['w2_acc']}%")
        for d in bt["details"]:
            print(f" {'✅' if d['correct'] else '❌'} {d['case_id']} | {d['match'][:28]:<28} | {d['sim_score']:.0f}→{d['sim_decision']}")

def cli_backtest():
    r = BacktestEngine().run()
    print(f"\nBACKTEST {r['ts']}\nAccuracy={r['accuracy']}% ({r['correct']}/{r['total']}) W1={r['w1_acc']}% W2={r['w2_acc']}%")
    for d in r["details"]:
        print(f" {'✅' if d['correct'] else '❌'} [{d['case_id']}] {d['match'][:30]:<30} | {d['sim_score']:.0f}→{d['sim_decision']:<10} | {d['actual']}")

def cli_mc():
    r = MonteCarloAgent().simulate(84, {"ap_diff": 13, "score_home": 1, "score_away": 1, "has_sequence": True, "last_corner_minute": 83})
    print(f"MC Sport-like 84': P={r['probability']}% Passa={r['passes_threshold']} rate={r['rate_per_min']}")
    r2 = MonteCarloAgent().simulate(87, {"ap_diff": 24, "score_home": 0, "score_away": 0, "last_corner_minute": 66, "xg_dominant": 0.7})
    print(f"MC VJS-like 87':  P={r2['probability']}% Passa={r2['passes_threshold']} rate={r2['rate_per_min']}")

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "train": cli_train()
    elif cmd == "backtest": cli_backtest()
    elif cmd == "mc": cli_mc()
    elif cmd == "run": asyncio.run(CornerAIOrchestrator().run())
    else:
        print("CornerAI v7.1 Unified | train | backtest | mc | run")
        cli_backtest()

---

# 16. SOURCE PARSER INTELLIGENCE — SOKKERPRO + BET365

## 16.1 REGRA CENTRAL
O parser não pode depender de uma única classe CSS, ID gerado ou atributo de framework. Deve usar hierarquia de evidências:
1. identidade da partida/fixture;
2. texto semântico do componente;
3. container pai do componente;
4. filho rotulado/posição contextual;
5. classe CSS estável;
6. ID/classe gerado como fallback;
7. `data-v-*` somente como evidência terciária.

## 16.2 SOKKERPRO — MAPA DE EXTRAÇÃO

### Identidade
Prioridade: fixture ID/URL -> header da partida -> `<title>` -> texto visível.
Nunca aceitar uma partida sem validação cruzada de casa/fora.

### Pressão
Âncoras semânticas: `.pressure-title`, `.pressure-grid`, `.pressure-block`, `.pressure-pct`, `.pressure-interval`, `.pressure-bar`.
Extrair série temporal por intervalo. Guardar atual, média, tendência, dominância e aceleração.

### Ataques
Âncoras: `.gauge-row`, `.gauge-col`, `.gauge-title`, `.gauge-num`.
Extrair casa/fora pelo contexto do componente, nunca pela ordem global da página.

### Ataques perigosos
Âncoras: `.stat-row`, `.stat-values-row`, `.stat-label`, `.stat-value`.
Localizar a linha cujo label semântico seja `Ataques Perigosos` e extrair somente seus valores.

### Escanteios
Localizar a linha semântica `Escanteios`. Diferenciar `0` real de ausência de dados. Ausência = `missing/unavailable`, nunca zero.

### Perfil de escanteios
Separar obrigatoriamente: total, casa, visitante, marca, sofre, FT, 1ºT e 2ºT quando disponíveis.

### H2H
Âncoras: `.h2h-card`, `.h2h-sec-title`, `.h2h-avg-card`, `.h2h-cell-label`, `.h2h-cell-value`.
A frase de ausência de dados é um estado válido e deve ser registrada como `unavailable/no_data`.

### Odds
Separar: mercado, período, linha, odd/preço, status e timestamp. Não assumir que odds de escanteios estão sempre disponíveis.

### Gráficos
Tratar pressure/attacks/dangerous attacks/corners/shots como séries temporais. Não usar apenas o texto visual agregado quando houver série temporal disponível.

## 16.3 BET365 — MODO PREPARATÓRIO
O ZIP de assets recebido não é suficiente para estabelecer seletores definitivos do DOM dos mercados. A Skill deve aguardar o HTML principal para mapear contêineres e classes dinâmicas.
Ao receber o HTML, aplicar descoberta semântica para: partida, relógio, placar, 1X2, gols, asiáticos, escanteios, linhas de escanteios, mercados ativos/suspensos e odds.
Classes dinâmicas devem ser ancoradas por repetição estrutural, atributos semânticos, texto de mercado e relação pai-filho.

## 16.4 CONTRATO POR FEATURE
Cada valor extraído deve conter: `value`, `source`, `selector_evidence`, `captured_at`, `freshness_ms`, `confidence`, `status`.

## 16.5 VALIDAÇÕES OBRIGATÓRIAS
- casa != fora;
- linha de mercado coerente com tipo de mercado;
- HT != FT;
- escanteios acumulados nunca podem diminuir sem sinal de correção/reset;
- timestamp monotônico por source;
- números duplicados em regiões diferentes da página exigem contexto semântico;
- conflito entre fontes gera `conflict`, nunca escolha silenciosa;
- dados antigos não podem alimentar decisão live.

## 16.6 PIPELINE AUTORITATIVO
RAW HTML -> DOM/semantic discovery -> extractor -> normalizer -> source validation -> freshness/quality -> feature registry -> regime -> hazard/probability -> calibration -> abstention -> risk -> decision gate.

## 16.7 PROIBIÇÕES
Nunca inventar seletor, valor ou estatística ausente. Nunca converter `no data` em zero. Nunca usar classe `data-v-*` como único seletor. Nunca confundir gráfico agregado com evento temporal. Nunca usar dado pós-evento para uma decisão que deveria ser pré-evento.

# 17. SECOND BRAIN — EXPERIENCE DATABASE v2

## 17.1 AUTORIDADE
`artifacts/cornerai_experience_v2.json` é o histórico imutável de experiências. Ele deve ser preservado entre deploys, upgrades e migrações.

## 17.2 APPEND-ONLY
Nunca editar, corrigir, reordenar ou excluir registros existentes por meio da Skill. O único write path autorizado é `ExperienceDatabase.add_record()` com `authorization_token="ENGINEER_MASTER_ACCESS_CORNERAI"`. Uma tentativa sem autorização deve falhar fechadamente.

## 17.3 CONSULTA OBRIGATÓRIA ANTES DA DECISÃO
Durante análise live, consultar `find_similar(minute, half, ap_diff, score_diff, competition, total_corners)` antes do Decision Gate. As experiências são **evidência contextual**, não probabilidade automática. Nunca contar o mesmo sinal do histórico duas vezes se ele já estiver presente em uma feature atual.

## 17.4 APRENDIZADO PÓS-JOGO
Após resultado definido, registrar a experiência uma única vez. `learning` deve ser uma regra/insight conciso e verificável. REDs e recusas CORRETO são tão importantes quanto GREENs: o banco aprende também com falsos positivos e abstenções.

## 17.5 INTEGRIDADE
- IDs `EXP###` são monotônicos.
- Duplicatas exatas são rejeitadas.
- Escrita atômica protege o JSON contra corrupção.
- A leitura é livre; escrita exige autorização.
- Nenhuma API de delete/update é exposta.
- `no_data` nunca vira zero.

## 17.6 ARQUIVOS INSTALADOS
- `experience_db.py`
- `artifacts/cornerai_experience_v2.json` com 56 experiências iniciais fornecidas pelo projeto.

## 17.7 USO OPERACIONAL
Pipeline atualizado:
RAW SOURCES -> NORMALIZER -> QUALITY/FRESHNESS -> FEATURE REGISTRY -> EXPERIENCE RETRIEVAL -> REGIME -> HAZARD/PROBABILITY -> CALIBRATION -> ABSTENTION -> RISK -> DECISION GATE -> POST-GAME AUDIT -> APPEND EXPERIENCE.


# 18. SELF-CONTAINED INSTALL BUNDLE — v10.2 ELITE DUAL-SOURCE + EXPERIENCE

## 18.1 OBJETIVO
Esta Skill contém, em um único arquivo, o conteúdo integral da Skill-base v10.1 e todos os arquivos do pacote `CornerAI_v10.2-ELITE-DUAL-SOURCE-WITH-EXPERIENCE.zip`. O conteúdo original da Skill-base não foi removido. O pacote é incorporado como recursos internos para que um instalador/runner compatível com Skills possa materializar os arquivos no diretório da Skill antes da execução.

## 18.2 REGRA DE INSTALAÇÃO
Ao instalar esta Skill, tratar a seção `BEGIN CORNERAI BUNDLED RESOURCES` como um bundle interno. Para cada recurso do manifesto, decodificar Base64, descompactar GZIP e gravar no caminho relativo indicado. Validar SHA-256 antes de disponibilizar o recurso ao runtime. Se qualquer hash falhar, a instalação deve ser interrompida (fail-closed).

## 18.3 RECURSOS EMBUTIDOS
O bundle inclui:
- a própria Skill v10.1 original;
- `experience_db.py`;
- `artifacts/cornerai_experience_v2.json` (56 experiências iniciais);
- documentação de experiência e integração;
- fixture HTML real do SokkerPRO;
- captura MHTML real do Bet365;
- ZIP original de assets do Bet365.

## 18.4 EXPERIÊNCIA OPERACIONAL
A consulta de similaridade da Experience Database v2 é obrigatória antes do Decision Gate. Registros existentes são imutáveis; novos registros exigem autorização explícita. Nenhum dado ausente pode ser convertido em zero e nenhum seletor pode ser inventado.

## 18.5 COMPATIBILIDADE
Esta seção não substitui as regras anteriores: ela apenas empacota os recursos necessários para execução independente da Skill. O runtime deve continuar respeitando todos os gates, validações, frescor, identidade, anti-leakage, anti-double-counting, abstention, risco e fail-closed já definidos acima.

