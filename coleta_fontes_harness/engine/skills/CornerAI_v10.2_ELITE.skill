# SEÇÃO 2: AGENTES INTELECTUAIS v7.1
# =============================================================================
class MonteCarloAgent:
    """Poisson calibrado 05/08/2026: λ_W1=0.069, λ_W2=0.090 — 2000 sims."""
    BASE_W1, BASE_W2, BASE_OUT = 0.069, 0.090, 0.030

    def __init__(self, n_sims: int = 2000, seed: Optional[int] = None):
        self.n_sims = max(500, n_sims)
        self.rng = random.Random(seed)

    def estimate(self, minute: int, half: int = 2, added: int = 4, **kw) -> Dict[str, Any]:
        if half == 1 and 30 <= minute <= 45 + added:
            base, end = self.BASE_W1, 45 + added
            window = "W1"
        elif half == 2 and minute >= 80:
            base, end = self.BASE_W2, 90 + added
            window = "W2"
        else:
            base, end, window = self.BASE_OUT, minute + 5, "OUT"
        horizon = max(0.5, float(end - minute + 0.5))
        rate, br = self._rate(base, minute, window, kw)
        hits = 0
        for _ in range(self.n_sims):
            lam = max(0.0, rate * self.rng.uniform(0.85, 1.15) * horizon)
            if self._poisson(lam) >= 1: hits += 1
        prob = hits / self.n_sims
        return {"probability": round(prob * 100, 1), "passes_threshold": prob >= 0.45,
                "rate_per_min": round(rate, 4), "horizon": round(horizon, 2),
                "simulations": self.n_sims, "breakdown": br, "window": window}

    def simulate(self, minute: int, ctx: Dict) -> Dict[str, Any]:
        half = 1 if minute <= 48 else 2
        return self.estimate(minute, half=half, added=4,
            ap_diff=ctx.get("ap_diff", 0), score_home=ctx.get("score_home", 0),
            score_away=ctx.get("score_away", 0), last_corner_minute=ctx.get("last_corner_minute"),
            last_goal_minute=ctx.get("last_goal_minute"), has_sequence=ctx.get("has_sequence", False),
            red_card=ctx.get("red_card_pressing_team", False), xg_dominant=ctx.get("xg_dominant", 0),
            momentum=ctx.get("momentum_rising", False), ip2_falling=ctx.get("ip2_trend") == "falling",
            possession=ctx.get("possession_dominant", 50))

    def _rate(self, base: float, minute: int, window: str, kw: Dict) -> Tuple[float, Dict]:
        r, br = base, {"base": base}
        ap = kw.get("ap_diff", 0)
        f = 1.45 if ap >= 20 else (1.30 if ap >= 12 else (1.12 if ap >= 6 else 1.0)); r *= f; br["ap"] = f
        lc = kw.get("last_corner_minute")
        if lc is not None:
            gap = minute - lc
            f = 1.35 if gap <= 4 else (1.10 if gap <= 8 else (0.50 if gap >= 20 else (0.60 if gap >= 15 else (0.82 if gap >= 10 else 1.0))))
        elif kw.get("has_sequence"): f = 1.35
        else: f = 0.75
        r *= f; br["seq"] = f
        sd = abs(kw.get("score_home", 0) - kw.get("score_away", 0))
        f = 1.15 if sd == 0 else (1.20 if sd == 1 else (0.60 if sd >= 2 else 1.0)); r *= f; br["score"] = f
        if window == "W1" and minute >= 43: f = 1.34
        elif window == "W2" and minute >= 88: f = 1.35
        elif window == "W2" and 80 <= minute <= 84: f = 1.45
        elif window == "W2" and minute >= 82: f = 1.25
        else: f = 1.0
        r *= f; br["peak"] = f
        if kw.get("momentum"): r *= 1.15; br["mom"] = 1.15
        if kw.get("ip2_falling"): r *= 0.65; br["ip2"] = 0.65
        lg = kw.get("last_goal_minute")
        if lg is not None and (minute - lg) <= 3: r *= 0.50; br["goal"] = 0.50
        if kw.get("red_card"): r *= 0.75; br["red"] = 0.75
        if kw.get("score_home", 0) == 0 and kw.get("score_away", 0) == 0 and minute >= 85 and kw.get("xg_dominant", 0) >= 0.55:
            r *= 0.70; br["g00"] = 0.70
        if kw.get("possession", 50) >= 60: r *= 1.08; br["poss"] = 1.08
        r = max(0.005, min(0.35, r)); br["final"] = r
        return r, br

    def _poisson(self, lam: float) -> int:
        if lam <= 0: return 0
        if lam < 30:
            L, k, p = math.exp(-lam), 0, 1.0
            while p > L: k += 1; p *= self.rng.random()
            return k - 1
        return max(0, int(round(self.rng.gauss(lam, math.sqrt(lam)))))

class FatigueAgent:
    def calculate(self, md: Dict) -> Dict[str, Any]:
        minute = md.get("minute", 0)
        subs = md.get("subs_home", 0) if md.get("pressing_team", "home") == "home" else md.get("subs_away", 0)
        fatigue = min(100, max(0, minute * 0.8 + max(0, md.get("total_attacks", 0) - 150) * 0.3 - subs * 8))
        sd = abs(md.get("score_home", 0) - md.get("score_away", 0))
        desp = min(30, (minute - 75) * 3) if minute >= 80 and sd <= 1 else 0
        eff = max(0, fatigue - desp)
        adj = -6 if eff >= 70 else (5 if eff >= 50 and desp >= 15 else 0)
        return {"fatigue_index": round(fatigue, 1), "desperation_index": round(desp, 1),
                "effective_fatigue": round(eff, 1), "score_adjustment": adj,
                "adjustment_type": "FADIGA" if adj < 0 else ("DESESPERO" if adj > 0 else "NEUTRO")}

class CorrelationAgent:
    PAIRS = [("SEQUENCIA", "CLUSTER", 0.5), ("SEQUENCIA", "ONDA", 0.6),
             ("MOMENTUM", "DANGEROUS_DIFF", 0.4), ("DOMINIO", "DANGEROUS_DIFF", 0.3),
             ("W2_82-86", "W2_88+", 1.0)]
    def adjust(self, bonuses: List[str], weights: Dict) -> Tuple[List[str], float]:
        active = {b.split("(")[0].split("+")[0] for b in bonuses}
        red, notes = 0.0, []
        for a, b, pct in self.PAIRS:
            if a in active and b in active:
                wa = weights.get("bonuses", {}).get(a, 0)
                wb = weights.get("bonuses", {}).get(b, 0)
                cut = min(wa, wb) * pct
                red += cut; notes.append(f"{a}/{b}*-{cut:.1f}")
        return notes, red

class LearningAgent:
    def __init__(self, path: str = "cornerai_weights_v7_learned.json"):
        self.path = Path(path)
        self.history: List[Dict] = []
        self.weights = self._load()

    def _load(self) -> Dict:
        if self.path.exists():
            with open(self.path) as f: return json.load(f)
        return {**{k: dict(v) for k, v in WEIGHTS_V7.items()},
                "meta": {"version": "7.1", "updates": 0, "last_update": None}}

    def _save(self):
        self.weights["meta"]["last_update"] = datetime.now().isoformat()
        self.weights["meta"]["updates"] = self.weights["meta"].get("updates", 0) + 1
        with open(self.path, "w") as f: json.dump(self.weights, f, indent=2)

    def record_outcome(self, signal: Dict, outcome: str):
        self.history.append({"ts": datetime.now().isoformat(), "signal": signal, "outcome": outcome})
        factors = [f.split("(")[0] for f in str(signal.get("factors", "")).split(", ") if f and f != "Nenhum"]
        kills = [k.split("(")[0] for k in str(signal.get("kills_active", "")).split(", ") if k and k != "Nenhuma"]
        if outcome == "acerto":
            for f in factors:
                if f in self.weights.get("bonuses", {}):
                    self.weights["bonuses"][f] = round(self.weights["bonuses"][f] * 1.005, 2)
        elif outcome == "erro":
            for f in factors:
                if f in self.weights.get("bonuses", {}):
                    self.weights["bonuses"][f] = round(self.weights["bonuses"][f] * 0.995, 2)
            for k in kills:
                if k in self.weights.get("kills", {}):
                    self.weights["kills"][k] = round(self.weights["kills"][k] * 1.0075, 2)
        self._save()

class PatternMatcher:
    def __init__(self, cases: List[Dict] = None):
        self.cases = cases or CASES_DATABASE

    def find_similar(self, md: Dict, top_n: int = 3) -> List[Dict]:
        scored = [(self._sim(md, c), c) for c in self.cases]
        scored.sort(key=lambda x: -x[0])
        return [{"case_id": c["id"], "match": c["match"], "similarity": round(s, 2),
                 "result": c["result"], "pattern": c["pattern"], "key_learning": c.get("key_learning", "")}
                for s, c in scored[:top_n]]

    def _sim(self, cur: Dict, case: Dict) -> float:
        sc, mx = 0.0, 8.0
        cw = "W2" if cur.get("minute", 0) >= 75 else "W1"
        if cw == case.get("window"): sc += 2.0
        md = abs(cur.get("minute", 0) - case.get("minute_entry", 0))
        sc += 1.5 if md <= 3 else (1.0 if md <= 7 else (0.5 if md <= 12 else 0))
        ad = abs(cur.get("ap_diff", 0) - case.get("ap_diff", 0))
        sc += 1.5 if ad <= 5 else (1.0 if ad <= 10 else (0.5 if ad <= 15 else 0))
        cf = set(cur.get("factors", [])); casf = set(case.get("factors", []))
        if cf and casf: sc += 2.0 * len(cf & casf) / max(1, len(cf | casf))
        sd_cur = abs(cur.get("score_home", 0) - cur.get("score_away", 0))
        try:
            parts = [p for p in case["match"].split() if "x" in p and p[0].isdigit()]
            if parts:
                h, a = parts[0].split("x"); csd = abs(int(h) - int(a))
                if sd_cur == csd: sc += 1.0
                elif abs(sd_cur - csd) <= 1: sc += 0.5
        except (ValueError, IndexError): pass
        return sc / mx

class RiskManager:
    def __init__(self, bankroll: float = 1000.0):
        self.bankroll = bankroll
        self.daily_entries = 0
        self.daily_results: List[str] = []
        self.max_daily = 8
        self.max_consec_loss = 3
        self.kelly_frac = 0.25

    def can_enter(self) -> Tuple[bool, str]:
        if self.daily_entries >= self.max_daily:
            return False, f"Stop diário ({self.max_daily})"
        recent = self.daily_results[-self.max_consec_loss:]
        if len(recent) >= self.max_consec_loss and all(r == "erro" for r in recent):
            return False, f"Stop {self.max_consec_loss} losses"
        return True, "OK"

    def calc_stake(self, score: float, mc_prob: float) -> Dict[str, Any]:
        p = mc_prob / 100.0
        b = max(0.01, score / 50.0)
        kelly = max(0, min((b * p - (1 - p)) / b, 0.15))
        stake_pct = kelly * self.kelly_frac
        return {"kelly_full_pct": round(kelly * 100, 2), "stake_pct": round(stake_pct * 100, 2),
                "stake_value": round(self.bankroll * stake_pct, 2),
                "confidence": "ALTA" if kelly >= 0.08 else ("MEDIA" if kelly >= 0.04 else "BAIXA")}

    def record(self, outcome: str):
        self.daily_entries += 1; self.daily_results.append(outcome)

    def reset_daily(self):
        self.daily_entries = 0; self.daily_results.clear()

