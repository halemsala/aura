# === MONTE CARLO ===
```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CornerAI MonteCarloAgent v7.0
=============================
Simula N cenários para estimar P(próximo escanteio | tempo restante, estado atual).

Baseado em:
- Densidade temporal histórica calibrada 05/08/2026 (W1 λ=0.069, W2 λ=0.090)
- Volume de ataques perigosos (APPM)
- Sequência recente / zona morta
- Placar e necessidade ofensiva
- Kill zones ativas

Regra de liberação (matriz v7):
  ENTRA somente se Score ≥ 78 E MC_prob ≥ 45%
  AGUARDA reforçado se MC_prob ≥ 55% mesmo com Score 70-77
"""

from __future__ import annotations

import math
import random
from dataclasses import dataclass
from typing import Dict, Any, Optional, Tuple, List


@dataclass
class MCResult:
    prob: float                 # P(canto no horizonte) 0-1
    prob_pct: float             # 0-100
    n_sims: int
    successes: int
    horizon_minutes: float
    rate_per_min: float         # taxa estimada de canto/min
    confidence: float           # 0-1 (baseado em estabilidade das sims)
    breakdown: Dict[str, float] # contribuições dos fatores
    recommendation: str         # "LIBERA" | "AGUARDA_MC" | "BLOQUEIA"


class MonteCarloAgent:
    """
    Simula a ocorrência do próximo escanteio nos minutos restantes
    da janela ativa (W1 ou W2).
    """

    # Densidades históricas calibradas (base 20+ partidas)
    # Calibrado 05/08/2026 — blend densidade oficial (75%/80%) + empírico da base
    # W1: λ=-ln(1-0.75)/18 ≈ 0.077 | empírico ≈ 0.060 → blend 0.069
    # W2: λ=-ln(1-0.80)/16 ≈ 0.101 | empírico ≈ 0.080 → blend 0.090
    BASE_RATE_W1 = 0.069   # cantos/min na zona 30-48 (P≥1 ≈ 71%)
    BASE_RATE_W2 = 0.090   # cantos/min na zona 80-95 (P≥1 ≈ 76%)
    BASE_RATE_OUT = 0.030  # fora das janelas

    def __init__(self, n_sims: int = 2000, seed: Optional[int] = None):
        self.n_sims = max(500, n_sims)
        self.rng = random.Random(seed)

    # ------------------------------------------------------------------
    # API principal
    # ------------------------------------------------------------------
    def estimate(
        self,
        minute: int,
        half: int = 2,
        added_time: int = 4,
        score_home: int = 0,
        score_away: int = 0,
        ap_home: int = 0,
        ap_away: int = 0,
        last_corner_minute: Optional[int] = None,
        last_goal_minute: Optional[int] = None,
        red_card_pressing: bool = False,
        possession_dominant: float = 50.0,
        xg_dominant: float = 0.0,
        momentum_rising: bool = False,
        ip2_falling: bool = False,
        horizon: Optional[float] = None,
    ) -> MCResult:
        """
        Retorna probabilidade de ocorrer ≥1 escanteio no horizonte.
        """
        window, base_rate, default_horizon = self._window_params(
            minute, half, added_time
        )
        if horizon is None:
            horizon = default_horizon
        horizon = max(0.5, float(horizon))

        # Taxa ajustada por fatores
        rate, breakdown = self._adjusted_rate(
            base_rate=base_rate,
            minute=minute,
            score_home=score_home,
            score_away=score_away,
            ap_home=ap_home,
            ap_away=ap_away,
            last_corner_minute=last_corner_minute,
            last_goal_minute=last_goal_minute,
            red_card_pressing=red_card_pressing,
            possession_dominant=possession_dominant,
            xg_dominant=xg_dominant,
            momentum_rising=momentum_rising,
            ip2_falling=ip2_falling,
            window=window,
        )

        # Simulação Poisson homogênea no horizonte
        # P(≥1 evento) = 1 - exp(-λ) onde λ = rate * horizon
        # Usamos Monte Carlo explícito para capturar variabilidade e confiança
        successes = 0
        for _ in range(self.n_sims):
            # jitter na taxa (±15%) para modelar incerteza
            jitter = self.rng.uniform(0.85, 1.15)
            lam = max(0.0, rate * jitter * horizon)
            # Número de eventos ~ Poisson(λ); sucesso se ≥1
            # Amostragem via inversa de Poisson (Knuth para λ pequeno)
            n_events = self._sample_poisson(lam)
            if n_events >= 1:
                successes += 1

        prob = successes / self.n_sims
        # Confiança: quanto mais estável a taxa e maior o N, maior a confiança
        confidence = self._confidence(rate, horizon, self.n_sims)

        recommendation = self._recommend(prob)

        return MCResult(
            prob=round(prob, 4),
            prob_pct=round(prob * 100, 1),
            n_sims=self.n_sims,
            successes=successes,
            horizon_minutes=round(horizon, 2),
            rate_per_min=round(rate, 4),
            confidence=round(confidence, 3),
            breakdown={k: round(v, 3) for k, v in breakdown.items()},
            recommendation=recommendation,
        )

    def estimate_from_dict(self, data: Dict[str, Any]) -> MCResult:
        """Wrapper conveniente a partir de dict de match_data."""
        return self.estimate(
            minute=int(data.get("minute", 0)),
            half=int(data.get("half", 2)),
            added_time=int(data.get("added_time", 4)),
            score_home=int(data.get("score_home", 0)),
            score_away=int(data.get("score_away", 0)),
            ap_home=int(data.get("ap_home", data.get("dangerous_attacks_home", 0))),
            ap_away=int(data.get("ap_away", data.get("dangerous_attacks_away", 0))),
            last_corner_minute=data.get("last_corner_minute"),
            last_goal_minute=data.get("last_goal_minute"),
            red_card_pressing=bool(data.get("red_card_pressing_team", False)),
            possession_dominant=float(data.get("possession_dominant", 50)),
            xg_dominant=float(data.get("xg_dominant", 0)),
            momentum_rising=bool(data.get("momentum_rising", False)),
            ip2_falling=(data.get("ip2_trend") == "falling"),
            horizon=data.get("horizon"),
        )

    # ------------------------------------------------------------------
    # Internals
    # ------------------------------------------------------------------
    def _window_params(
        self, minute: int, half: int, added_time: int
    ) -> Tuple[str, float, float]:
        if half == 1 and 30 <= minute <= 45 + max(0, added_time):
            # Horizonte até o intervalo
            end = 45 + max(0, added_time)
            horizon = max(1.0, end - minute + 0.5)
            return "W1", self.BASE_RATE_W1, horizon
        if half == 2 and minute >= 80:
            end = 90 + max(0, added_time)
            horizon = max(1.0, end - minute + 0.5)
            return "W2", self.BASE_RATE_W2, horizon
        return "OUT", self.BASE_RATE_OUT, 5.0

    def _adjusted_rate(self, **kw) -> Tuple[float, Dict[str, float]]:
        rate = kw["base_rate"]
        br: Dict[str, float] = {"base": rate}

        minute = kw["minute"]
        score_diff = abs(kw["score_home"] - kw["score_away"])
        ap_diff = abs(kw["ap_home"] - kw["ap_away"])
        ap_total = kw["ap_home"] + kw["ap_away"]

        # 1) Volume de AP (fator mais importante)
        if ap_diff >= 20:
            f = 1.45
        elif ap_diff >= 12:
            f = 1.30
        elif ap_diff >= 6:
            f = 1.12
        else:
            f = 1.0
        rate *= f
        br["ap_diff"] = f

        # 2) Sequência recente vs zona morta
        last_c = kw["last_corner_minute"]
        if last_c is not None:
            gap = minute - last_c
            if gap <= 4:
                f = 1.35  # sequência (PARTIDA 007 reforço)
            elif gap <= 8:
                f = 1.10
            elif gap >= 20:
                f = 0.50  # seca extrema (PARTIDA 008)
            elif gap >= 15:
                f = 0.60  # seca prolongada
            elif gap >= 10:
                f = 0.82
            else:
                f = 1.0
            rate *= f
            br["sequence_gap"] = f
        else:
            # Sem histórico de canto → cautela
            rate *= 0.75
            br["sequence_gap"] = 0.75

        # 3) Placar / necessidade
        if score_diff == 0:
            f = 1.15  # empate motiva
        elif score_diff == 1:
            f = 1.20  # time atrás empurra
        elif score_diff >= 2:
            f = 0.60  # placar aberto (kill)
        else:
            f = 1.0
        rate *= f
        br["score"] = f

        # 4) Pico temporal (calibrado: share 43-48'=45% do W1, 80-84'=48% do W2)
        if kw["window"] == "W1" and minute >= 43:
            f = 1.34
        elif kw["window"] == "W2" and minute >= 88:
            f = 1.35
        elif kw["window"] == "W2" and 80 <= minute <= 84:
            f = 1.45
        elif kw["window"] == "W2" and minute >= 82:
            f = 1.25
        else:
            f = 1.0
        rate *= f
        br["temporal_peak"] = f

        # 5) Momentum
        if kw["momentum_rising"]:
            rate *= 1.15
            br["momentum"] = 1.15
        else:
            br["momentum"] = 1.0

        # 6) IP2 caindo (falso pico)
        if kw["ip2_falling"]:
            rate *= 0.65
            br["ip2_falling"] = 0.65
        else:
            br["ip2_falling"] = 1.0

        # 7) Gol recente (últimos 3 min)
        last_g = kw["last_goal_minute"]
        if last_g is not None and (minute - last_g) <= 3:
            rate *= 0.50
            br["recent_goal"] = 0.50
        else:
            br["recent_goal"] = 1.0

        # 8) Cartão vermelho do time que pressiona (PARTIDA 007)
        if kw["red_card_pressing"]:
            # Não zera, mas reduz — pode manter edge se volume alto
            rate *= 0.75
            br["red_card"] = 0.75
        else:
            br["red_card"] = 1.0

        # 9) Risco de gol no lugar do canto (PARTIDA 005)
        if (
            kw["score_home"] == 0
            and kw["score_away"] == 0
            and minute >= 85
            and kw["xg_dominant"] >= 0.55
        ):
            rate *= 0.70
            br["goal_risk_00"] = 0.70
        else:
            br["goal_risk_00"] = 1.0

        # 10) Domínio de posse
        if kw["possession_dominant"] >= 60:
            rate *= 1.08
            br["possession"] = 1.08
        else:
            br["possession"] = 1.0

        # Clamp taxa final
        rate = max(0.005, min(0.35, rate))
        br["final_rate"] = rate
        return rate, br

    def _sample_poisson(self, lam: float) -> int:
        """Amostra Poisson(λ). Knuth para λ < 30; caso contrário normal approx."""
        if lam <= 0:
            return 0
        if lam < 30:
            L = math.exp(-lam)
            k = 0
            p = 1.0
            while p > L:
                k += 1
                p *= self.rng.random()
            return k - 1
        # Normal approximation
        return max(0, int(round(self.rng.gauss(lam, math.sqrt(lam)))))

    def _confidence(self, rate: float, horizon: float, n: int) -> float:
        """Confiança heurística 0-1."""
        lam = rate * horizon
        # Mais confiança com λ moderado e N grande
        base = 1.0 - math.exp(-n / 800)
        # Penaliza λ muito baixo (evento raro) ou muito alto (saturado)
        if lam < 0.2:
            base *= 0.7
        elif lam > 3.0:
            base *= 0.85
        return max(0.3, min(0.98, base))

    def _recommend(self, prob: float) -> str:
        if prob >= 0.45:
            return "LIBERA"
        if prob >= 0.35:
            return "AGUARDA_MC"
        return "BLOQUEIA"


# ------------------------------------------------------------------
# Integração com a matriz de decisão v7
# ------------------------------------------------------------------
def apply_mc_gate(
    score: float,
    factors_count: int,
    has_strong_kill: bool,
    mc: MCResult,
) -> Tuple[str, str]:
    """
    Aplica o gate Monte Carlo sobre a decisão baseada em Score.

    Matriz v7:
      Score ≥ 78 + Fatores ≥ 3 + Sem Kill Forte + MC ≥ 45% → ENTRA
      Score 70-77 + MC ≥ 55% + Sem Kill → AGUARDA
      Caso contrário → NÃO ENTRA
    """
    if has_strong_kill:
        return "NÃO ENTRA", f"Kill zone forte ativa | MC={mc.prob_pct}%"

    if score >= 78 and factors_count >= 3 and mc.prob >= 0.45:
        return "ENTRA", f"Score {score}≥78 | Fatores {factors_count} | MC {mc.prob_pct}%≥45%"

    if 70 <= score <= 77 and mc.prob >= 0.55:
        return "AGUARDA", f"Score {score} transição | MC {mc.prob_pct}%≥55% — aguardar confirmação"

    if 62 <= score <= 77:
        return "AGUARDA", f"Score {score} zona transição | MC {mc.prob_pct}%"

    return "NÃO ENTRA", f"Score {score} ou MC {mc.prob_pct}% insuficientes"


# ------------------------------------------------------------------
# Demo
# ------------------------------------------------------------------
def demo():
    mc = MonteCarloAgent(n_sims=2000, seed=42)

    # Cenário 1: Sport x Cuiabá 84' (clássico ENTRA)
    r1 = mc.estimate(
        minute=84, half=2, added_time=5,
        score_home=1, score_away=1,
        ap_home=36, ap_away=49,
        last_corner_minute=83,
        momentum_rising=True,
    )
    print("=== Sport x Cuiabá 84' ===")
    print(f"  P(canto)={r1.prob_pct}% | rate={r1.rate_per_min}/min | "
          f"horizon={r1.horizon_minutes}' | rec={r1.recommendation}")
    print(f"  breakdown={r1.breakdown}")

    # Cenário 2: VJS 87' seca 21 min (PARTIDA 008 — AGUARDA)
    r2 = mc.estimate(
        minute=87, half=2, added_time=4,
        score_home=0, score_away=0,
        ap_home=51, ap_away=27,
        last_corner_minute=66,
        xg_dominant=0.7,
    )
    print("\n=== VJS Vantaa 87' (seca 21') ===")
    print(f"  P(canto)={r2.prob_pct}% | rate={r2.rate_per_min}/min | "
          f"horizon={r2.horizon_minutes}' | rec={r2.recommendation}")
    print(f"  breakdown={r2.breakdown}")

    # Cenário 3: Colegiales 84' com cartão vermelho (PARTIDA 007)
    r3 = mc.estimate(
        minute=84, half=2, added_time=4,
        score_home=0, score_away=1,
        ap_home=72, ap_away=51,
        last_corner_minute=80,
        red_card_pressing=True,
    )
    print("\n=== Colegiales 84' (vermelho 81') ===")
    print(f"  P(canto)={r3.prob_pct}% | rate={r3.rate_per_min}/min | "
          f"horizon={r3.horizon_minutes}' | rec={r3.recommendation}")

    # Gate examples
    print("\n=== Gates ===")
    for label, score, factors, kill, mcres in [
        ("Sport", 83, 4, False, r1),
        ("VJS", 71, 4, False, r2),
        ("Colegiales", 83, 4, False, r3),
    ]:
        dec, just = apply_mc_gate(score, factors, kill, mcres)
        print(f"  {label}: {dec} — {just}")


if __name__ == "__main__":
    demo()
```

# === COGNITIVE ===
```python
#!/usr/bin/env python3
"""CornerAI Cognitive Stack v6.0 — First-Principles / Second-Order / Via Negativa."""
from __future__ import annotations
from typing import Dict, Any, List

def cognitive_check(md: Dict[str, Any], score: float, decision: str, kills: List[str] = None) -> Dict[str, Any]:
    """Aplica as 3 camadas cognitivas. Rebaixa ENTRA→AGUARDA se via negativa forte."""
    kills = kills or []
    minute = md.get("minute", 0)
    sd = abs(md.get("score_home", 0) - md.get("score_away", 0))
    ap = md.get("ap_diff", 0)
    gap = None
    if md.get("last_corner_minute") is not None:
        gap = minute - md["last_corner_minute"]

    # First-principles
    converting = ap >= 12 and (md.get("momentum_rising") or (gap is not None and gap <= 8))
    fp = ("Volume convertendo em ameaça (AP+momentum/sequência)" if converting
          else "Volume presente mas conversão duvidosa — verificar cruzamentos/finalizações")

    # Second-order
    if decision == "ENTRA":
        so = "Se não sair em 3-4 min: risco de desaceleração ou gol no lugar do canto; mercado pode endurecer."
    elif decision == "AGUARDA":
        so = "Aguardar confirmação (sequência ou pico) preserva edge; próximo setup pode ser melhor."
    else:
        so = "Não entrar reduz exposição; monitorar mudança de ritmo ou sequência."

    # Via negativa
    risks = []
    if md.get("score_home", 0) == 0 and md.get("score_away", 0) == 0 and minute >= 85:
        risks.append("Gol no lugar do canto (0-0 pós-85' + domínio/xG) — P005")
    if gap is not None and gap >= 15:
        risks.append(f"Zona morta/seca ({gap} min sem canto) — P008")
    if "RED_CARD" in str(kills) or md.get("red_card_pressing_team"):
        risks.append("Desvantagem numérica do time que pressiona")
    if sd >= 2:
        risks.append("Placar aberto reduz necessidade ofensiva")
    if not risks:
        risks.append("Defesa compacta pode bloquear cruzamentos apesar do volume")
        if minute >= 88:
            risks.append("Acréscimos curtos / administração de tempo")
    risks = risks[:3]

    adjust = decision
    if decision == "ENTRA" and len(risks) >= 2 and score < 90:
        adjust = "AGUARDA"
        reason = "Via negativa ≥2 cenários plausíveis — rebaixa"
    else:
        reason = "Mantém decisão"

    return {
        "first_principles": fp,
        "second_order": so,
        "via_negativa": risks,
        "original_decision": decision,
        "adjusted_decision": adjust,
        "reason": reason,
        "applied": score >= 70,
    }

def format_cognitive(c: Dict[str, Any]) -> str:
    if not c.get("applied"):
        return ""
    lines = ["### Cognitive Check",
             f"- First-Principles: {c['first_principles']}",
             f"- Second-Order: {c['second_order']}",
             f"- Via Negativa: " + " | ".join(f"({i+1}) {r}" for i, r in enumerate(c["via_negativa"])),
             f"- Ajuste: {c['reason']} → **{c['adjusted_decision']}**"]
    return "\n".join(lines)

if __name__ == "__main__":
    # Demo P005-like
    c = cognitive_check(
        {"minute": 89, "score_home": 0, "score_away": 0, "ap_diff": 8, "xg_dominant": 0.67,
         "last_corner_minute": 80, "momentum_rising": True},
        score=81, decision="ENTRA", kills=["0-0_POS85"])
    print(format_cognitive(c))
    print("---")
    # Demo Sport-like
    c2 = cognitive_check(
        {"minute": 84, "score_home": 1, "score_away": 1, "ap_diff": 13,
         "last_corner_minute": 83, "momentum_rising": True},
        score=84, decision="ENTRA")
    print(format_cognitive(c2))
```

