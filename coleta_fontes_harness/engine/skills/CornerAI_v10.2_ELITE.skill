}{
  "metadata": {
    "versao": "2.0.0",
    "data_criacao": "2026-08-04",
    "fonte": "Analise estatistica de 12.549 mensagens + Pesquisa academica (MDPI, FIFA World Cup, Brasileirao 2023, ScoreLab)",
    "autor": "Corner Intelligence AI PRO",
    "objetivo": "Fornecer padroes estatisticos verificados para analise automatica de entradas em escanteios ao vivo com foco em janelas temporais especificas",
    "instrucao_ia": "Use este JSON como base de conhecimento factual. Dados de distribuicao temporal validados por estudos academicos. Nao invente valores."
  },
  "variaveis_explicadas": {
    "tempo_minutos": {
      "descricao": "Minuto do jogo no momento da entrada",
      "tipo": "inteiro",
      "relevancia": "Determina a janela de tempo restante. Distribuicao temporal validada: 0-30min (29%), 31-60min (33%), 61-90+min (37%)"
    },
    "posse_bola_mandante_pct": {
      "descricao": "Porcentagem de posse de bola do time mandante",
      "tipo": "float",
      "range_tipico": "20.0 a 80.0",
      "relevancia": "Diferenca de posse indica dominio. Jogos equilibrados (<10% dif) geram mais escanteios porque ambos atacam."
    },
    "dif_posse_bola_pct": {
      "descricao": "Diferenca absoluta entre posse de bola dos dois times",
      "tipo": "float",
      "formula": "abs(posse_bola_mandante_pct - posse_bola_visitante_pct)",
      "relevancia": "Principal filtro de equilibrio. <10% = jogo disputado = mais escanteios."
    },
    "ataques_perigosos_mandante": {
      "descricao": "Numero acumulado de ataques perigosos do mandante ate o momento",
      "tipo": "inteiro",
      "relevancia": "Indica volume ofensivo. Valores muito altos (>90) sem escanteios sugerem desaceleracao ou finalizacao ruim."
    },
    "ataques_perigosos_total": {
      "descricao": "Soma dos ataques perigosos de ambos os times",
      "tipo": "inteiro",
      "formula": "ataques_perigosos_mandante + ataques_perigosos_visitante"
    },
    "appm_5min_soma": {
      "descricao": "Soma do APPM dos ultimos 5 minutos de ambos os times",
      "tipo": "float",
      "relevancia": "FILTRO ESTRELA. Intervalo 0.5-1.0 indica ritmo ofensivo suficiente sem explosao."
    },
    "appm_10min_soma": {
      "descricao": "Soma do APPM dos ultimos 10 minutos",
      "tipo": "float",
      "relevancia": "Momentum sustentado. >1.5 sugere pressao constante."
    },
    "ip1_total": {
      "descricao": "Soma do Indice de Pressao 1 de ambos os times",
      "tipo": "inteiro",
      "relevancia": "30-50 = pressao moderada e constante (ideal). >70 = pressao excessiva ja 'gastada'."
    },
    "chutes_no_alvo_total": {
      "descricao": "Total de chutes no alvo de ambos os times",
      "tipo": "inteiro",
      "relevancia": "Contraintuitivo: 0-1 chutes no alvo = 71.4% aproveitamento. Poucos chutes indicam defesas/forcas de lado que geram escanteios posteriormente."
    },
    "escanteios_total": {
      "descricao": "Total de escanteios no jogo",
      "tipo": "inteiro"
    },
    "escanteios_ht": {
      "descricao": "Escanteios no primeiro tempo",
      "tipo": "inteiro",
      "relevancia": "Para Grupo 3 (min 30+), se HT ja teve 4+ cantos, probabilidade de Over FT aumenta."
    },
    "placar_diferenca_abs": {
      "descricao": "Diferenca absoluta de gols no placar",
      "tipo": "inteiro",
      "relevancia": "Placar aberto (2+ gols) + 90+ ataques perigosos = desaceleracao. Placar fechado (0-0, 1-0, 1-1) = pressao continua."
    },
    "game_state": {
      "descricao": "Situacao do jogo para escanteios",
      "tipo": "string",
      "valores": [
        "EMPATE",
        "MANDANTE_VENCENDO",
        "VISITANTE_VENCENDO",
        "MANDANTE_PERDENDO",
        "VISITANTE_PERDENDO"
      ],
      "relevancia": "Time perdendo pressiona mais nos minutos finais. Time vencendo por 1 gol tambem pode gerar escanteios pelo desespero do adversario."
    },
    "tempo_restante": {
      "descricao": "Minutos restantes ate o final (incluindo acrescimos estimados)",
      "tipo": "inteiro",
      "formula": "90 - tempo_minutos + 5 (estimativa acrescimos)",
      "relevancia": "Para late game, quanto mais tempo restante, maior a janela para escanteios."
    },
    "corner_rate_1t": {
      "descricao": "Taxa de escanteios por minuto no 1T",
      "tipo": "float",
      "formula": "escanteios_ht / 45",
      "relevancia": "Se taxa > 0.15 (7+ cantos no HT), tendencia de aceleracao no 2T."
    },
    "desespero_index": {
      "descricao": "Indice de desespero ofensivo",
      "tipo": "float",
      "formula": "(placar_diferenca_abs * 10) + (90 - tempo_minutos)",
      "relevancia": "Quanto maior, mais o time atrasado precisa atacar. >50 = alta probabilidade de escanteios nos minutos finais."
    }
  },
