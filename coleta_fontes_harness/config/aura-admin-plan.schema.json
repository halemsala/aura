{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura://admin-plan/v1",
  "title": "AURA Administrator DAG Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "goal", "steps", "stop_conditions", "evidence_requirements"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "assumptions": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "tool", "arguments", "reason", "risk_level", "requires_approval", "expected"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^s[0-9]+$"},
          "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "arguments": {"type": "object"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
          "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "PROHIBITED"]},
          "requires_approval": {"type": "boolean"},
          "expected": {"type": "object"},
          "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^s[0-9]+$"}},
          "rollback_tool": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "rollback_arguments": {"type": "object"}
        }
      }
    },
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "evidence_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  }
}
